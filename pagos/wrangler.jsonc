// Worker de pagos de marcossantiago.com (Ventanilla). Se publica aparte del sitio:
//   cd pagos && npx wrangler deploy
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "marcossantiago-pagos",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // Solo la API de pagos; el resto del dominio lo sigue sirviendo Cloudflare Pages
  "routes": [{ "pattern": "marcossantiago.com/api/pago/ath/*", "zone_name": "marcossantiago.com" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marcossantiago-pagos",
      // Creada el 7-nov-2026 (npx wrangler d1 create marcossantiago-pagos)
      "database_id": "7047898a-60e0-4826-94ff-0614b8e3ec4e"
    }
  ],
  // Cada minuto completa los pagos aprobados cuyo cliente cerró la página
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "TELEGRAM_CHAT_ID": "46377544"
  }
  // Secretos: ATHM_PUBLIC_TOKEN y ATHM_PRIVATE_TOKEN (scripts/poner-llaves-ath.ps1),
  // TELEGRAM_TOKEN y, recomendado, TURNSTILE_SECRET (npx wrangler secret put …)
}
