---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import WorkCard from '../../components/WorkCard.astro';
import VideoDialog from '../../components/VideoDialog.astro';
import CtaBand from '../../components/CtaBand.astro';
import { videos } from '../../lib/media';
const cats = ['Todo', ...new Set(videos.map(v => v.cat))];
const cubro = ['Bodas y quinceañeros','Conciertos y festivales','Video corporativo','Reels para redes','Documental','Marcas y publicidad','Color grading y post'];
---
<Base title="Videografía — Marcos Santiago" description="Videografía profesional en Puerto Rico: bodas, quinceañeros, conciertos, video corporativo, documental y reels. Basado en Aibonito, PR.">
  <Nav />
  <main id="main" class="pg">
    <header class="full cab">
      <h1 class="ti">Video</h1>
      <p>Del concepto a la entrega final: música, eventos, marcas y documental en Puerto Rico. Pulsa cualquiera para verlo aquí mismo.</p>
    </header>
    <!-- Filtro sin JavaScript: radios + :has() -->
    <div class="fl">
      <div class="fl-b full barra-pegada" role="group" aria-label="Filtrar por categoría">
        {cats.map((c, i) => <label><input type="radio" name="cat" value={c} checked={i === 0} /><span>{c}</span></label>)}
      </div>
      <h2 class="vh">Videos</h2>
      <div class="gr full">
        {videos.map((v, i) => <div class="gi" data-c={v.cat}><WorkCard v={v} eager={i < 2} sizes="(max-width:700px) 100vw, (max-width:1100px) 50vw, 33vw" /></div>)}
      </div>
    </div>
    <section class="full mas">
      <p>Hay más en <a class="link-a" href="https://vimeo.com/marcosstgo" target="_blank" rel="noopener">mi canal de Vimeo</a> y en <a class="link-a" href="/reels/">reels</a>.</p>
      <ul>{cubro.map(c => <li>{c}</li>)}</ul>
    </section>
  </main>
  <CtaBand titulo="¿Grabamos?" texto="Cuéntame qué quieres contar y te digo cómo lo haría." waTexto="Hola Marcos, me interesa cotizar video." />
  <Footer />
  <VideoDialog />
</Base>
<style>
  .pg { padding-top: 120px }
  .cab { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 48px; padding-bottom: 28px }
  .ti { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(5rem, 19vw, 20rem); line-height: .82 }
  .cab p { max-width: 42ch; font-size: var(--text-lg); color: var(--muted) }
  .fl-b { display: flex; gap: 4px; overflow-x: auto; padding-block: 14px; background: var(--ink); scrollbar-width: none }
  .fl-b label { cursor: pointer; flex: none }
  .fl-b input { position: absolute; opacity: 0 }
  .fl-b span { display: block; padding: 10px 18px; border-radius: 99px; font-weight: 600; font-size: .9375rem; border: 1px solid transparent; transition: background .2s, color .2s, border-color .2s }
  .fl-b span:hover { border-color: var(--border-h) }
  .fl-b input:checked + span { background: var(--flame); color: #0d0c0b }
  .fl-b input:focus-visible + span { outline: 2px solid var(--flame); outline-offset: 2px }
  .gr { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px 16px; padding-top: 12px }
  .gi :global(.wc-img) { aspect-ratio: 16/9 }
  @media (max-width: 1100px) { .gr { grid-template-columns: 1fr 1fr } }
  @media (max-width: 700px) { .gr { grid-template-columns: 1fr } }
  .fl:has(input[value='Eventos']:checked) .gi:not([data-c='Eventos']),
  .fl:has(input[value='Música']:checked) .gi:not([data-c='Música']),
  .fl:has(input[value='Bodas']:checked) .gi:not([data-c='Bodas']),
  .fl:has(input[value='Marcas']:checked) .gi:not([data-c='Marcas']),
  .fl:has(input[value='Documental']:checked) .gi:not([data-c='Documental']) { display: none }
  .mas { padding-block: var(--sec) calc(var(--sec) * .7); font-size: var(--text-lg) }
  .mas ul { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px }
  .mas li { padding: 8px 16px; border: 1px solid var(--border-h); border-radius: 99px; font-size: .9375rem }
</style>
