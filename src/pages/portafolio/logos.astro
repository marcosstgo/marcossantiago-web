---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import LogoWall from '../../components/LogoWall.astro';
import WorkCard from '../../components/WorkCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { logos, brands } from '../../lib/media';
---
<Base
  title="Logos — Portafolio de Identidad Visual · Marcos Santiago"
  description={`${logos.length} logos diseñados por Marcos Santiago en Puerto Rico. Míralos sobre blanco, negro, azul o su propio color.`}
  image="/shorts-og.jpg"
>
  <Nav />
  <main id="main" class="on-paper lp-pag">
    <header class="full cab">
      <h1 class="ti">Logos</h1>
      <p>{logos.length} marcas. Cambia el fondo de todas a la vez, o abre una para verla en cuatro superficies. Si un logo no aguanta el cambio, no está terminado.</p>
    </header>
    <LogoWall buscador />
    <section class="full mk">
      <h2 class="ti2">En el mundo real</h2>
      <div class="mk-g">{brands.slice(0, 6).map(b => <WorkCard b={b} sizes="(max-width:700px) 100vw, 33vw" />)}</div>
      <p class="mk-m"><a class="link-a" href="/portafolio/diseno/">Todo el diseño gráfico →</a></p>
    </section>
  </main>
  <CtaBand titulo="¿Tu marca necesita logo?" texto="Logo, variantes, paleta y tipografía, con entrega en todos los formatos." waTexto="Hola Marcos, me interesa cotizar un logo." />
  <Footer />
</Base>
<style>
  .lp-pag { padding-top: 120px }
  .cab { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 48px; padding-bottom: 20px }
  .ti { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(5rem, 19vw, 20rem); line-height: .82 }
  .cab p { max-width: 42ch; font-size: var(--text-lg); color: var(--muted) }
  .mk { padding-block: var(--sec) }
  .ti2 { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(2.5rem, 6vw, 6rem); line-height: .95; margin-bottom: 28px }
  .mk-g { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px 16px }
  .mk-g :global(.wc-img) { aspect-ratio: 5/4 }
  .mk-m { margin-top: 32px }
  @media (max-width: 700px) { .mk-g { grid-template-columns: 1fr } }
</style>
