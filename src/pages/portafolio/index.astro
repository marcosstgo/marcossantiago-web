---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import WorkCard from '../../components/WorkCard.astro';
import VideoDialog from '../../components/VideoDialog.astro';
import CtaBand from '../../components/CtaBand.astro';
import { videos, brands, video, brand, logos } from '../../lib/media';
import chustruck from '../../assets/brand/el-chustruck-portada.jpg';
import jalda from '../../assets/brand/jalda-portada.jpg';
const areas = [
  { t: 'Video', n: `${videos.length} piezas`, h: '/portafolio/video/', i: video('1084774680').img },
  { t: 'Fotografía', n: 'Bodas, eventos, retratos', h: '/portafolio/foto/', i: video('1052549620').img },
  { t: 'Diseño', n: `${brands.length} identidades`, h: '/portafolio/diseno/', i: chustruck },
  { t: 'Logos', n: `${logos.length} marcas`, h: '/portafolio/logos/', i: jalda },
];
const sel = ['1153022005','944305796','1214473531','1084774680','1145809002','699656446'].map(video);
---
<Base title="Portafolio — Marcos Santiago" description="Video, fotografía, diseño gráfico, logos y desarrollo web de Marcos Santiago, desde Aibonito para todo Puerto Rico.">
  <Nav />
  <main id="main">
    <header class="full cab"><h1 class="ti">Trabajo</h1></header>
    <div class="ar full">
      {areas.map((a, i) => (
        <a class="ar-c" href={a.h}>
          <Picture src={a.i} formats={['avif','webp']} widths={[640,1000,1400]} sizes="(max-width:700px) 100vw, 50vw" alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
          <span class="ar-t"><strong>{a.t}</strong><small>{a.n}</small></span>
        </a>
      ))}
    </div>
    <section class="full dv">
      <a href="/portafolio/dev/"><span>Desarrollo web</span><small>Plataformas, tiendas y herramientas →</small></a>
    </section>
    <section class="full se">
      <h2 class="h2">Una selección</h2>
      <div class="se-g">{sel.map(v => <WorkCard v={v} sizes="(max-width:700px) 100vw, 50vw" />)}</div>
    </section>
  </main>
  <CtaBand />
  <Footer />
  <VideoDialog />
</Base>
<style>
  .cab { padding-top: 120px; padding-bottom: clamp(20px, 3vw, 40px) }
  .ti { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(5rem, 19vw, 20rem); line-height: .82 }
  .ar { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(8px, 1.2vw, 18px) }
  .ar-c { position: relative; display: block; aspect-ratio: 16/10; overflow: hidden; border-radius: var(--radius); background: var(--surface); isolation: isolate }
  .ar-c :global(picture) { display: contents }
  .ar-c :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: scale .9s var(--ease) }
  .ar-c:hover :global(img) { scale: 1.04 }
  .ar-c::after { content:''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(13,12,11,.82)) }
  .ar-t { position: absolute; z-index: 1; left: clamp(14px,2vw,28px); right: clamp(14px,2vw,28px); bottom: clamp(12px,1.6vw,22px); display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 2px 16px; color: #f3eee5 }
  .ar-t strong { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(2.75rem, 7vw, 7.5rem); line-height: .9 }
  .ar-t small { font-size: .9375rem; font-weight: 500 }
  .dv { padding-top: clamp(8px, 1.2vw, 18px) }
  .dv a { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 24px; padding: clamp(20px, 3vw, 40px) clamp(14px, 2vw, 28px); background: var(--flame); color: #0d0c0b; border-radius: var(--radius) }
  .dv span { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(2.75rem, 7vw, 7.5rem); line-height: .9 }
  .dv small { font-weight: 600; font-size: 1rem }
  .se { padding-block: var(--sec) }
  .h2 { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(2.5rem, 6vw, 6rem); line-height: .95; margin-bottom: 28px }
  .se-g { display: grid; grid-template-columns: 1fr 1fr; gap: 32px 16px }
  .se-g :global(.wc-img) { aspect-ratio: 16/9 }
  @media (max-width: 700px) { .ar, .se-g { grid-template-columns: 1fr } }
</style>
