---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import WorkCard from '../../components/WorkCard.astro';
import LogoWall from '../../components/LogoWall.astro';
import CtaBand from '../../components/CtaBand.astro';
import { brands, logos } from '../../lib/media';
const servicios = [
  ['Logotipos','Concepto, variantes y uso en negro y blanco, con entrega en SVG, PNG y PDF.'],
  ['Identidad visual completa','Logo, paleta, tipografía, iconografía y guía de uso.'],
  ['Branding para negocios','Para restaurantes, salones, boutiques, clínicas y más.'],
  ['Branding para eventos','Flyers, programas y señalización coordinados.'],
  ['Diseño para redes','Plantillas, posts, stories y banners listos para usar.'],
  ['Material impreso','Tarjetas, flyers, afiches, menús y brochures listos para imprenta.'],
  ['Diseño editorial','Revistas, catálogos, libros y programas.'],
  ['UI y diseño web','Interfaces y prototipos en Figma, con especificaciones para desarrollo.'],
];
---
<Base title="Diseño Gráfico — Marcos Santiago" description="Diseño gráfico e identidad de marca en Puerto Rico: logos, branding, material impreso y digital. Por Marcos Santiago, artista gráfico en Aibonito.">
  <Nav />
  <main id="main" class="pg">
    <header class="full cab">
      <h1 class="ti">Diseño <em class="it">gráfico</em></h1>
      <p>Identidades que se reconocen de lejos y funcionan en cualquier tamaño, de la tarjeta al food truck.</p>
    </header>
    <div class="full gr">
      {brands.map((b, i) => <WorkCard class={i % 5 === 0 ? 'gran' : ''} b={b} eager={i < 2} sizes="(max-width:700px) 100vw, 50vw" />)}
    </div>
    <p class="full mas"><a class="link-a" href="https://www.behance.net/marcossantiago" target="_blank" rel="noopener">Más proyectos en Behance →</a></p>
    <section class="on-paper lg">
      <div class="full lg-h">
        <h2 class="h2">{logos.length} logos</h2>
        <a class="btn" href="/portafolio/logos/">Abrir el muro completo →</a>
      </div>
      <LogoWall limite={12} />
    </section>
    <section class="full sv">
      <h2 class="h2">Lo que hago</h2>
      <dl>{servicios.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}</dl>
      <p class="sv-m"><a class="link-a" href="/servicios/#diseno">Ver precios →</a></p>
    </section>
  </main>
  <CtaBand titulo="¿Hablamos de tu marca?" texto="Desde un logo hasta el sistema completo." waTexto="Hola Marcos, me interesa cotizar diseño gráfico." />
  <Footer />
</Base>
<style>
  .pg { padding-top: 120px }
  .cab { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 48px; padding-bottom: 28px }
  .ti { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(3.75rem, 12.5vw, 14rem); line-height: .88 }
  .ti .it { font-size: 1.04em }
  .cab p { max-width: 40ch; font-size: var(--text-lg); color: var(--muted) }
  .gr { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px 16px }
  .gr :global(.wc-img) { aspect-ratio: 5/4 }
  .mas { padding-block: 28px var(--sec) }
  .h2 { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(2.5rem, 6vw, 6rem); line-height: .95 }
  .lg { padding-top: clamp(48px, 7vw, 96px) }
  .lg-h { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 12px 32px; padding-bottom: 8px }
  .lg :global(.lw-grid) { grid-template-columns: repeat(6, 1fr) }
  @media (max-width: 900px) { .lg :global(.lw-grid) { grid-template-columns: repeat(3, 1fr) } }
  .sv { padding-block: var(--sec) } .sv .h2 { margin-bottom: 24px }
  .sv dl { display: grid; grid-template-columns: 1fr 1fr; column-gap: clamp(24px, 4vw, 64px); border-top: 1px solid var(--border) }
  .sv dl > div { padding-block: 16px; border-bottom: 1px solid var(--border) }
  .sv dt { font-weight: 600; font-size: 1.1875rem } .sv dd { color: var(--muted); margin-top: 2px }
  .sv-m { margin-top: 28px }
  @media (max-width: 700px) { .gr, .sv dl { grid-template-columns: 1fr } }
</style>
