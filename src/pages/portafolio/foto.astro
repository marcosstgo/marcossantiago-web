---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CtaBand from '../../components/CtaBand.astro';
const servicios = [
  ['Bodas','Cobertura completa del día, con galería editada en alta resolución.'],
  ['Quinceañeros','Sesión de retratos y cobertura del evento: court, waltz y celebración.'],
  ['Cumpleaños y celebraciones','Cumpleaños, graduaciones y fiestas familiares, documentados con el mismo cuidado que una boda.'],
  ['Eventos corporativos','Conferencias, lanzamientos y actividades, con fotos listas para prensa y redes.'],
  ['Conciertos y festivales','Artistas en vivo, backstage y ambiente, en poca luz y acción rápida.'],
  ['Fiestas patronales y cultura','Tradiciones, carnavales y celebraciones de Puerto Rico.'],
  ['Retratos y marca personal','Headshots y contenido visual para profesionales, artistas y creadores.'],
  ['Productos y comercial','Catálogos, e-commerce y publicidad, con luz de estudio o ambientada.'],
  ['Fotografía de calle','Proyectos personales del día a día en Puerto Rico.'],
];
// Fotos reales de Marcos. Para añadir una: ponerla en public/fotos/ (grande + versión -700) y sumarla aquí.
const cats = [
  ['todas', 'Todas'], ['bodas', 'Bodas'], ['quince', 'Quinceañeros'], ['artistas', 'Artistas'],
  ['modelaje', 'Modelaje'], ['deportes', 'Deportes'], ['eventos', 'Eventos'], ['detalles', 'Paisajes y detalles'],
] as const;
const fotos = [
  { f: '/bodas/hero-boda', w: 1418, h: 1130, c: 'bodas', t: 'Boda', alt: 'El novio acaricia la cara de la novia frente al altar' },
  { f: '/fotos/cantante-tarima', w: 1250, h: 983, c: 'artistas', t: 'Artista', alt: 'Cantante con camisa negra de malla y pantalón rojo frente a su banda' },
  { f: '/fotos/quince-risa', w: 747, h: 1129, c: 'quince', t: 'Quinceañero', alt: 'Quinceañera con corona y guantes de encaje se ríe con un ramo de rosas blancas' },
  { f: '/fotos/carrera', w: 1418, h: 904, c: 'deportes', t: 'Carrera', alt: 'Corredor con el número 284 sube una cuesta adelante del grupo' },
  { f: '/fotos/pasarela-roja', w: 753, h: 1133, c: 'modelaje', t: 'Modelaje', alt: 'Modelo en pasarela con vestido rojo pintado a mano y mangas transparentes' },
  { f: '/fotos/publico', w: 1290, h: 1016, c: 'eventos', t: 'Público', alt: 'Público cantando en un concierto al aire libre, con gafas de sol' },
  { f: '/bodas/novia-salon', w: 754, h: 1137, c: 'bodas', t: 'Boda', alt: 'Novia de pie en el pasillo de un salón con candelabros y piso de mármol' },
  { f: '/fotos/cantante-rubia', w: 1416, h: 1127, c: 'artistas', t: 'Artista', alt: 'Cantante rubia sonríe y extiende el micrófono hacia el público' },
  { f: '/fotos/vivero-amapola', w: 1582, h: 1053, c: 'detalles', t: 'Detalle', alt: 'Mujer en un vivero muestra una amapola amarilla en primer plano' },
  { f: '/fotos/quince-rosas', w: 1580, h: 883, c: 'quince', t: 'Quinceañero', alt: 'Quinceañera sonriente ofrece un ramo de rosas rojas frente a una pared de rosas' },
  { f: '/fotos/retrato-neon', w: 901, h: 1135, c: 'artistas', t: 'Artista', alt: 'Joven con camiseta blanca mira su celular bajo luz rosada y violeta' },
  { f: '/bodas/beso', w: 1574, h: 880, c: 'bodas', t: 'Boda', alt: 'Los novios se besan frente a un arco de flores blancas' },
  { f: '/fotos/corredora', w: 1411, h: 1130, c: 'deportes', t: 'Carrera', alt: 'Corredora con el número 39 sonríe antes de la carrera' },
  { f: '/fotos/concierto-baile', w: 752, h: 1134, c: 'artistas', t: 'Artista', alt: 'Cantante con sombrero negro y gafas azules baila en tarima' },
  { f: '/fotos/bandera', w: 1420, h: 1137, c: 'detalles', t: 'Paisaje', alt: 'Bandera de Puerto Rico ondeando frente a un árbol y un cielo nublado' },
  { f: '/fotos/cantante-gafas', w: 1583, h: 1041, c: 'artistas', t: 'Artista', alt: 'Cantante calvo con gafas oscuras canta agarrado al micrófono' },
  { f: '/fotos/pasarela-novia', w: 743, h: 1134, c: 'modelaje', t: 'Modelaje', alt: 'Modelo con vestido de novia mira por encima del hombro frente a un arco iluminado' },
  { f: '/fotos/concierto', w: 1418, h: 1134, c: 'artistas', t: 'Artista', alt: 'Cantante con camisa a rayas canta con el brazo abierto hacia el público' },
  { f: '/bodas/novia-padre', w: 1573, h: 1043, c: 'bodas', t: 'Boda', alt: 'La novia sonríe del brazo de su papá antes de la ceremonia' },
  { f: '/bodas/muelle', w: 1580, h: 1046, c: 'bodas', t: 'Boda', alt: 'Pareja de novios en un muelle frente a un lago al atardecer' },
];
const cuenta = (c: string) => (c === 'todas' ? fotos.length : fotos.filter((x) => x.c === c).length);
---
<Base title="Fotografía — Marcos Santiago" description="Fotografía profesional en Puerto Rico: bodas, quinceañeros, eventos corporativos, conciertos, retratos y más. Basado en Aibonito, PR.">
  <Nav />
  <main id="main" class="pg">
    <header class="full cab">
      <h1 class="ti">Fotografía</h1>
      <p>Bodas, quinceañeros, tarimas, carreras, pasarelas y lo que llegue. Si se puede fotografiar, lo fotografío, y cada evento lo trato como único.</p>
    </header>
    <section class="full fg" aria-label="Galería de fotografía">
      <div class="fg-chips" role="radiogroup" aria-label="Filtrar por tipo">
        {cats.filter(([c]) => cuenta(c) > 0).map(([c, t], i) => (
          <label class="fg-chip"><input type="radio" name="fg" value={c} checked={i === 0} />{t}<span>{cuenta(c)}</span></label>
        ))}
      </div>
      <button type="button" class="fg-pres"><span aria-hidden="true">▶</span> Ver en presentación</button>
      <div class="fg-grid">
        {fotos.map((x, i) => (
          <figure class="fg-it" data-c={x.c}>
            <button type="button" class="fg-b" data-full={`${x.f}.webp`} data-th={`${x.f}-160.webp`} aria-label={`Ampliar: ${x.alt}`}>
              <img src={`${x.f}-700.webp`} srcset={`${x.f}-700.webp 700w, ${x.f}.webp ${x.w}w`} sizes="(max-width: 700px) 50vw, 33vw" width={x.w} height={x.h} alt={x.alt} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
              <span class="fg-t">{x.t}</span>
            </button>
          </figure>
        ))}
      </div>
      <p class="fg-pista">Toca una foto para verla en grande, o mira todas en presentación.</p>
    </section>
    <dialog class="fg-lb" aria-label="Foto ampliada">
      <img class="fg-lb-fondo" alt="" aria-hidden="true" />
      <div class="fg-lb-barra" aria-hidden="true"><i></i></div>
      <header class="fg-lb-top">
        <p class="fg-lb-pie"><span class="fg-lb-t"></span><span class="fg-lb-n"></span></p>
        <button type="button" class="fg-lb-play" aria-label="Reproducir presentación">▶</button>
        <button type="button" class="fg-lb-x" aria-label="Cerrar">✕</button>
      </header>
      <div class="fg-lb-esc"><img class="fg-lb-img" alt="" /></div>
      <button type="button" class="fg-lb-ant" aria-label="Foto anterior">←</button>
      <button type="button" class="fg-lb-sig" aria-label="Foto siguiente">→</button>
      <nav class="fg-lb-tira" aria-label="Todas las fotos"></nav>
    </dialog>
    <section class="full ga">
      <h2 class="h2">Galerías completas</h2>
      <div class="ga-a">
        <p>Las galerías de bodas, eventos y sesiones viven en Pixieset, con descargas, favoritos y para compartir con la familia.</p>
        <a class="btn primary" href="https://fotos.marcossantiago.com" target="_blank" rel="noopener">Abrir galerías →</a>
        <a class="btn" href="https://www.instagram.com/m4rcos" target="_blank" rel="noopener">Instagram</a>
      </div>
    </section>
    <section class="full sv">
      <h2 class="h2">Lo que cubro</h2>
      <dl>{servicios.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}</dl>
      <p class="sv-m"><a class="link-a" href="/servicios/#fotografia">Ver precios →</a></p>
    </section>
  </main>
  <CtaBand titulo="¿Tienes un evento?" texto="Dime la fecha y el lugar, y te contesto con disponibilidad." waTexto="Hola Marcos, me interesa cotizar fotografía." />
  <Footer />
</Base>
<style>
  .pg { padding-top: 120px }
  .cab { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 48px; padding-bottom: 28px }
  .ti { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(3.75rem, 15vw, 17rem); line-height: .84 }
  .cab p { max-width: 42ch; font-size: var(--text-lg); color: var(--muted) }
  /* Galería: los botones de arriba filtran al momento (sin JS); al pasar el ratón por una foto, las demás se apagan */
  .fg-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px }
  .fg-chip { position: relative; display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border: 1px solid var(--border); border-radius: 999px; cursor: pointer; font-weight: 600; transition: background .2s, color .2s, border-color .2s }
  .fg-chip input { position: absolute; opacity: 0; pointer-events: none }
  .fg-chip span { font-size: .75em; opacity: .6 }
  .fg-chip:hover { border-color: var(--flame) }
  .fg-chip:has(input:checked) { background: var(--flame); border-color: var(--flame); color: var(--ink) }
  .fg-chip:has(input:focus-visible) { outline: 2px solid var(--flame); outline-offset: 3px }
  .fg-grid { columns: 3 300px; column-gap: clamp(8px, 1vw, 14px) }
  .fg-it { break-inside: avoid; margin: 0 0 clamp(8px, 1vw, 14px); animation: fg-entra .45s ease both }
  @keyframes fg-entra { from { opacity: 0; transform: translateY(14px) scale(.98) } }
  .fg-b { position: relative; display: block; width: 100%; padding: 0; border: 0; background: var(--surface); border-radius: var(--radius); overflow: hidden; cursor: zoom-in }
  .fg-b img { display: block; width: 100%; height: auto; transition: transform .6s ease, filter .3s }
  .fg-t { position: absolute; left: 12px; bottom: 12px; padding: 5px 11px; border-radius: 999px; background: rgba(13,12,11,.72); color: var(--paper); font-size: .78rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; opacity: 0; transform: translateY(6px); transition: opacity .25s, transform .25s }
  .fg-b:hover img, .fg-b:focus-visible img { transform: scale(1.04) }
  .fg-b:hover .fg-t, .fg-b:focus-visible .fg-t { opacity: 1; transform: none }
  @media (hover: hover) { .fg-grid:has(.fg-b:hover) .fg-b:not(:hover) img { filter: brightness(.45) saturate(.6) } }
  .fg:has(input[value='bodas']:checked) .fg-it:not([data-c='bodas']),
  .fg:has(input[value='quince']:checked) .fg-it:not([data-c='quince']),
  .fg:has(input[value='artistas']:checked) .fg-it:not([data-c='artistas']),
  .fg:has(input[value='modelaje']:checked) .fg-it:not([data-c='modelaje']),
  .fg:has(input[value='deportes']:checked) .fg-it:not([data-c='deportes']),
  .fg:has(input[value='detalles']:checked) .fg-it:not([data-c='detalles']),
  .fg:has(input[value='eventos']:checked) .fg-it:not([data-c='eventos']) { display: none }
  .fg-pista { margin-top: 6px; color: var(--muted); font-size: .9rem }
  @media (max-width: 700px) {
    .fg-grid { columns: 2 }
    .fg-chips { flex-wrap: nowrap; overflow-x: auto; margin-inline: calc(-1 * var(--gut)); padding-inline: var(--gut); scrollbar-width: none }
    .fg-chips::-webkit-scrollbar { display: none }
    .fg-chip { flex: none }
    .fg-t { opacity: 1; transform: none; font-size: .66rem; left: 8px; bottom: 8px; padding: 4px 8px }
  }
  .fg-pres { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 20px; padding: 0; border: 0; background: none; color: var(--paper); font-weight: 600; cursor: pointer }
  .fg-pres span { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: var(--flame); color: var(--ink); font-size: .8rem; transition: transform .2s }
  .fg-pres:hover span { transform: scale(1.12) }
  /* Foto ampliada: el fondo se tiñe con los colores de la foto; presentación con barra de tiempo y tira de miniaturas */
  .fg-lb { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: var(--ink); color: var(--paper); overflow: hidden }
  .fg-lb[open] { display: grid; grid-template-rows: auto 1fr auto }
  .fg-lb::backdrop { background: transparent }
  .fg-lb-fondo { position: absolute; inset: -10%; width: 120%; height: 120%; object-fit: cover; filter: blur(50px) saturate(1.5) brightness(.42); transition: opacity .5s; z-index: 0 }
  .fg-lb > :not(.fg-lb-fondo) { position: relative; z-index: 1 }
  .fg-lb-barra { position: absolute !important; top: 0; left: 0; right: 0; height: 3px; z-index: 3 !important }
  .fg-lb-barra i { display: block; height: 100%; width: 0; background: var(--flame) }
  .fg-lb.juega .fg-lb-barra i { animation: fg-barra var(--dur, 4.5s) linear forwards }
  @keyframes fg-barra { to { width: 100% } }
  .fg-lb-top { display: flex; align-items: center; gap: 10px; padding: 14px 16px }
  .fg-lb-pie { flex: 1; display: flex; gap: 14px; margin: 0; font-size: .85rem; letter-spacing: .08em; text-transform: uppercase }
  .fg-lb-n { opacity: .6 }
  .fg-lb-esc { display: grid; place-items: center; min-height: 0; overflow: hidden; padding: 0 clamp(12px, 6vw, 96px) }
  .fg-lb-img { max-width: 100%; max-height: calc(100dvh - 170px); object-fit: contain; border-radius: 8px; box-shadow: 0 30px 80px rgba(0,0,0,.5) }
  .fg-lb-img.entra { animation: fg-lb-entra .45s ease both }
  @keyframes fg-lb-entra { from { opacity: 0; transform: scale(.97) } }
  .fg-lb.juega .fg-lb-img.entra { animation: fg-lb-entra .45s ease both, fg-kb var(--dur, 4.5s) ease-out both }
  @keyframes fg-kb { from { transform: scale(1) } to { transform: scale(1.05) } }
  .fg-lb button { width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(245,240,232,.25); background: rgba(13,12,11,.5); color: var(--paper); font-size: 1.15rem; cursor: pointer; backdrop-filter: blur(6px) }
  .fg-lb button:hover { background: var(--flame); color: var(--ink); border-color: var(--flame) }
  .fg-lb.juega .fg-lb-play { background: var(--flame); color: var(--ink); border-color: var(--flame) }
  .fg-lb-ant, .fg-lb-sig { position: absolute !important; top: 50%; translate: 0 -50% }
  .fg-lb-ant { left: 16px } .fg-lb-sig { right: 16px }
  .fg-lb-tira { display: flex; gap: 8px; overflow-x: auto; padding: 12px 16px 16px; scrollbar-width: none; justify-content: safe center }
  .fg-lb-tira::-webkit-scrollbar { display: none }
  .fg-lb-tira :global(button) { flex: none; width: 64px; height: 48px; padding: 0; border-radius: 6px; overflow: hidden; opacity: .45; border: 2px solid transparent; transition: opacity .2s, border-color .2s, transform .2s }
  .fg-lb-tira :global(button:hover) { opacity: .85; background: none }
  .fg-lb-tira :global(button[aria-current='true']) { opacity: 1; border-color: var(--flame); transform: translateY(-3px) }
  .fg-lb-tira :global(img) { width: 100%; height: 100%; object-fit: cover; display: block }
  @media (max-width: 700px) {
    .fg-lb-ant, .fg-lb-sig { width: 40px !important; height: 40px !important; top: auto; bottom: 86px; translate: none }
    .fg-lb-esc { padding: 0 8px 56px }
    .fg-lb-tira :global(button) { width: 52px; height: 40px }
  }
  @media (prefers-reduced-motion: reduce) { .fg-it, .fg-lb-img.entra, .fg-lb.juega .fg-lb-img.entra { animation: none } .fg-b img { transition: none } }
  .h2 { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(2.5rem, 6vw, 6rem); line-height: .95; margin-bottom: 24px }
  .ga { padding-top: var(--sec) }
  .ga-a { display: flex; flex-wrap: wrap; align-items: center; gap: 12px } .ga-a p { flex-basis: 100%; max-width: 56ch; color: var(--muted); font-size: var(--text-lg); margin-bottom: 8px }
  .sv { padding-block: var(--sec) }
  .sv dl { display: grid; grid-template-columns: 1fr 1fr; column-gap: clamp(24px, 4vw, 64px); border-top: 1px solid var(--border) }
  .sv dl > div { padding-block: 16px; border-bottom: 1px solid var(--border) }
  .sv dt { font-weight: 600; font-size: 1.1875rem } .sv dd { color: var(--muted); margin-top: 2px }
  .sv-m { margin-top: 28px }
  @media (max-width: 700px) { .sv dl { grid-template-columns: 1fr } }
</style>
<script>
  // Foto ampliada y presentación. Recorre solo las fotos que se ven con el filtro puesto.
  const lb = document.querySelector<HTMLDialogElement>('.fg-lb')!;
  const img = lb.querySelector<HTMLImageElement>('.fg-lb-img')!;
  const fondo = lb.querySelector<HTMLImageElement>('.fg-lb-fondo')!;
  const tira = lb.querySelector<HTMLElement>('.fg-lb-tira')!;
  const play = lb.querySelector<HTMLButtonElement>('.fg-lb-play')!;
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DUR = 4500;
  let lista: HTMLButtonElement[] = [];
  let i = 0;
  let reloj = 0;

  const ver = (n: number) => {
    i = (n + lista.length) % lista.length;
    const b = lista[i];
    const chica = b.querySelector('img')!;
    img.classList.remove('entra'); void img.offsetWidth; img.classList.add('entra');
    img.src = chica.currentSrc || chica.src; // lo que ya está cargado, al momento
    img.alt = chica.alt;
    fondo.src = b.dataset.th!;
    const grande = new Image();
    grande.onload = () => { if (lista[i] === b) img.src = grande.src; };
    grande.src = b.dataset.full!;
    lb.querySelector('.fg-lb-t')!.textContent = b.querySelector('.fg-t')!.textContent;
    lb.querySelector('.fg-lb-n')!.textContent = `${i + 1} / ${lista.length}`;
    tira.querySelectorAll('button').forEach((t, k) => t.setAttribute('aria-current', String(k === i)));
    tira.children[i]?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: quieto ? 'auto' : 'smooth' });
    if (lb.classList.contains('juega')) programar();
  };
  const programar = () => {
    clearTimeout(reloj);
    const barra = lb.querySelector<HTMLElement>('.fg-lb-barra i')!;
    barra.style.animation = 'none'; void barra.offsetWidth; barra.style.animation = '';
    reloj = window.setTimeout(() => ver(i + 1), DUR);
  };
  const jugar = (si: boolean) => {
    lb.classList.toggle('juega', si);
    play.textContent = si ? '❚❚' : '▶';
    play.setAttribute('aria-label', si ? 'Pausar presentación' : 'Reproducir presentación');
    if (si) programar(); else clearTimeout(reloj);
  };
  const abrir = (desde: number, presentar: boolean) => {
    lista = [...document.querySelectorAll<HTMLButtonElement>('.fg-b')].filter((x) => x.offsetParent !== null);
    tira.replaceChildren(...lista.map((b, k) => {
      const t = document.createElement('button');
      t.type = 'button';
      t.setAttribute('aria-label', `Foto ${k + 1}`);
      t.innerHTML = `<img src="${b.dataset.th}" alt="" loading="lazy">`;
      t.addEventListener('click', () => ver(k));
      return t;
    }));
    lb.style.setProperty('--dur', `${DUR}ms`);
    lb.showModal();
    jugar(presentar);
    ver(desde);
  };

  document.querySelectorAll<HTMLButtonElement>('.fg-b').forEach((b) => b.addEventListener('click', () => {
    abrir([...document.querySelectorAll<HTMLButtonElement>('.fg-b')].filter((x) => x.offsetParent !== null).indexOf(b), false);
  }));
  document.querySelector('.fg-pres')!.addEventListener('click', () => abrir(0, true));
  play.addEventListener('click', () => jugar(!lb.classList.contains('juega')));
  lb.querySelector('.fg-lb-x')!.addEventListener('click', () => lb.close());
  lb.querySelector('.fg-lb-ant')!.addEventListener('click', () => ver(i - 1));
  lb.querySelector('.fg-lb-sig')!.addEventListener('click', () => ver(i + 1));
  lb.addEventListener('close', () => jugar(false));
  lb.addEventListener('click', (e) => { if (e.target === lb || (e.target as HTMLElement).classList.contains('fg-lb-esc')) lb.close(); });
  lb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') ver(i - 1);
    if (e.key === 'ArrowRight') ver(i + 1);
    if (e.key === ' ' && !(e.target instanceof HTMLButtonElement)) { e.preventDefault(); jugar(!lb.classList.contains('juega')); }
  });
  let x0 = 0;
  lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50 && !tira.contains(e.target as Node)) ver(dx < 0 ? i + 1 : i - 1);
  });
</script>
