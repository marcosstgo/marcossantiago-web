---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CtaBand from '../../components/CtaBand.astro';
import { video } from '../../lib/media';
const servicios = [
  ['Bodas','Cobertura completa del día, con galería editada en alta resolución.'],
  ['Quinceañeros','Sesión de retratos y cobertura del evento: court, waltz y celebración.'],
  ['Eventos corporativos','Conferencias, lanzamientos y actividades, con fotos listas para prensa y redes.'],
  ['Conciertos y festivales','Artistas en vivo, backstage y ambiente, en poca luz y acción rápida.'],
  ['Fiestas patronales y cultura','Tradiciones, carnavales y celebraciones de Puerto Rico.'],
  ['Retratos y marca personal','Headshots y contenido visual para profesionales, artistas y creadores.'],
  ['Productos y comercial','Catálogos, e-commerce y publicidad, con luz de estudio o ambientada.'],
  ['Fotografía de calle','Proyectos personales del día a día en Puerto Rico.'],
];
// Mientras llegan las fotos finales: escenas de coberturas reales.
const esc = ['1075437696','822843800','873793066','1052549620','797698487','1214473531'].map(video);
---
<Base title="Fotografía — Marcos Santiago" description="Fotografía profesional en Puerto Rico: bodas, quinceañeros, eventos corporativos, conciertos, retratos y más. Basado en Aibonito, PR.">
  <Nav />
  <main id="main" class="pg">
    <header class="full cab">
      <h1 class="ti">Fotografía</h1>
      <p>Bodas íntimas en las montañas, conciertos multitudinarios y todo lo que pasa entre medio. Cada evento lo trato como único.</p>
    </header>
    <div class="full mos">
      {esc.map((v, i) => (
        <figure class={`m m${i}`}>
          <Picture src={v.img} formats={['avif','webp']} widths={[640,1000,1400]} sizes="(max-width:700px) 100vw, 50vw" alt={v.title} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
        </figure>
      ))}
    </div>
    <section class="full ga">
      <h2 class="h2">Galerías completas</h2>
      <div class="ga-a">
        <p>Las galerías de bodas, eventos y sesiones viven en Pixieset, con descargas, favoritos y para compartir con la familia.</p>
        <a class="btn primary" href="https://fotos.marcossantiago.com" target="_blank" rel="noopener">Abrir galerías →</a>
        <a class="btn" href="https://www.instagram.com/m4rcos" target="_blank" rel="noopener">Instagram</a>
      </div>
    </section>
    <section class="full sv">
      <h2 class="h2">Lo que cubro</h2>
      <dl>{servicios.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}</dl>
      <p class="sv-m"><a class="link-a" href="/servicios/#fotografia">Ver precios →</a></p>
    </section>
  </main>
  <CtaBand titulo="¿Tienes un evento?" texto="Dime la fecha y el lugar, y te contesto con disponibilidad." waTexto="Hola Marcos, me interesa cotizar fotografía." />
  <Footer />
</Base>
<style>
  .pg { padding-top: 120px }
  .cab { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 48px; padding-bottom: 28px }
  .ti { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(3.75rem, 15vw, 17rem); line-height: .84 }
  .cab p { max-width: 42ch; font-size: var(--text-lg); color: var(--muted) }
  .mos { display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(8px, 1vw, 14px) }
  .m { overflow: hidden; border-radius: var(--radius); background: var(--surface); height: clamp(220px, 34vw, 560px) }
  .m :global(picture) { display: contents }
  .m :global(img) { width: 100%; height: 100%; object-fit: cover }
  .m0 { grid-column: span 7 } .m1 { grid-column: span 5 } .m2 { grid-column: span 4 } .m3 { grid-column: span 8 } .m4 { grid-column: span 6 } .m5 { grid-column: span 6 }
  @media (max-width: 700px) { .m { grid-column: 1 / -1 } }
  .h2 { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(2.5rem, 6vw, 6rem); line-height: .95; margin-bottom: 24px }
  .ga { padding-top: var(--sec) }
  .ga-a { display: flex; flex-wrap: wrap; align-items: center; gap: 12px } .ga-a p { flex-basis: 100%; max-width: 56ch; color: var(--muted); font-size: var(--text-lg); margin-bottom: 8px }
  .sv { padding-block: var(--sec) }
  .sv dl { display: grid; grid-template-columns: 1fr 1fr; column-gap: clamp(24px, 4vw, 64px); border-top: 1px solid var(--border) }
  .sv dl > div { padding-block: 16px; border-bottom: 1px solid var(--border) }
  .sv dt { font-weight: 600; font-size: 1.1875rem } .sv dd { color: var(--muted); margin-top: 2px }
  .sv-m { margin-top: 28px }
  @media (max-width: 700px) { .sv dl { grid-template-columns: 1fr } }
</style>
