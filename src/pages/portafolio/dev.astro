---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CtaBand from '../../components/CtaBand.astro';

const featuredProjects = [
  {
    name: 'CONCILIA',
    tagline: 'Pagos de ATH Móvil aplicados en MikroWisp',
    desc: 'Aplica en MikroWisp los pagos de ATH Móvil que llegan fuera del portal, prepara los que necesitan una decisión y entrega por WhatsApp los avisos de MikroWisp.',
    href: '/portafolio/dev/concilia/',
    tags: ['Python', 'FastAPI', 'ATH Móvil', 'MikroWisp', 'Twilio'],
    status: 'Live',
    color: '#34b885',
    year: '2026',
  },
  {
    name: 'KIOSKKO',
    tagline: 'E-commerce para negocios en Puerto Rico',
    desc: 'Plataforma SaaS con tienda online, carrito, pagos con Stripe y ATH Móvil, panel admin completo y configuración sin código.',
    href: 'https://kioskko.com',
    tags: ['Astro', 'PocketBase', 'Stripe', 'ATH Móvil', 'Docker'],
    status: 'Live',
    color: '#4a6cf7',
    year: '2025',
  },
  {
    name: 'FACTURAPR',
    tagline: 'Facturación para negocios en Puerto Rico',
    desc: 'SaaS de facturación sobre Manager.io con bot de Telegram, app web y asistentes de IA que crean facturas y cotizaciones por voz o texto.',
    href: 'https://facturapr.com',
    tags: ['FastAPI', 'Manager.io', 'Telegram', 'MCP'],
    status: 'Live',
    color: '#10b981',
    year: '2026',
  },
  {
    name: 'FLASHEALO',
    tagline: 'Fotos colaborativas para eventos',
    desc: 'Los asistentes suben y comparten sus fotos en un espacio centralizado por evento. Sin apps, sin cuentas, solo escanear y subir.',
    href: 'https://flashealo.com',
    tags: ['React', 'Supabase', 'Storage', 'QR'],
    status: 'Beta',
    color: '#a855f7',
    year: '2025',
  },
];

const otherProjects = [
  {
    name: 'CORILLO',
    desc: 'Plataforma de streaming independiente para Puerto Rico. Canal grid en vivo, player HLS, chat en tiempo real y panel de administración.',
    href: 'https://corillo.live',
    tags: ['HTML', 'JS', 'MediaMTX', 'HLS', 'Nginx'],
    year: '2024',
  },
  {
    name: 'CORILLO CSS',
    desc: 'Framework CSS dark-first creado para Corillo. Tokens de diseño, paleta boricua (cian, oro, rojo PR) y 17 componentes — sin dependencias, ~8 KB.',
    href: 'https://corillo.live/corillo-css/',
    tags: ['CSS', 'Design System', 'Framework', 'Dark-first'],
    year: '2026',
  },
  {
    name: 'STREAMER PRO',
    desc: 'App de escritorio para streaming RTMP multi-plataforma. Soporte NVENC, highlights, logo overlay, watchdog con auto-recovery y auto-update.',
    href: 'https://corillo.live/streamer-pro/',
    tags: ['C#', 'WPF', 'FFmpeg', '.NET'],
    year: '2025',
  },
  {
    name: 'STREAMER LITE',
    desc: 'Versión ligera de Streamer Pro. Pipeline ddagrab+NVENC optimizado para bajo consumo de CPU.',
    href: 'https://corillo.live',
    tags: ['C#', 'WPF', 'NVENC', 'ddagrab'],
    year: '2025',
  },
  {
    name: 'NATCHECK',
    desc: 'Diagnóstico de NAT type, MTU y puertos para gaming. 10 perfiles de juego, fix UPnP automático.',
    href: 'https://corillo.live/natcheck/',
    tags: ['C#', 'WinForms', 'STUN', 'UPnP'],
    year: '2025',
  },
  {
    name: 'ANTI-BUFFERBLOAT PRO',
    desc: 'Optimizador de red para Windows: reduce latencia y bufferbloat con perfiles Gaming/Reset y monitoreo en tiempo real.',
    href: 'https://corillo.live/antibufferbloat-pro/',
    tags: ['C#', 'WPF', 'Windows', '.NET'],
    year: '2024',
  },
];
const casos = [
  { n: 'Concilia', d: 'Pagos de ATH Móvil aplicados solos en MikroWisp.', h: '/portafolio/dev/concilia/', i: '/portfolio-cases/concilia/home-hero.webp' },
  { n: 'Yanet Jabones Naturales', d: 'Tienda en línea para productos artesanales.', h: '/portafolio/dev/yanetshop/', i: '/portfolio-cases/yanetshop/home-hero.webp' },
  { n: 'Toyo-Specs', d: 'Tienda de piezas para Toyota en Puerto Rico.', h: '/portafolio/dev/toyospecs/', i: '/portfolio-cases/toyospecs/home-hero.webp' },
];
const fuera = (h: string) => h.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};
---
<Base title="Desarrollo Web — Marcos Santiago" description="Sitios, tiendas en línea, plataformas y aplicaciones de escritorio creadas por Marcos Santiago en Puerto Rico. Casos de estudio y proyectos en producción.">
  <Nav />
  <main id="main" class="pg">
    <header class="full cab">
      <h1 class="ti">Web</h1>
      <p>Sitios, plataformas y herramientas que la gente usa de verdad. También diseño lo que programo.</p>
    </header>
    <section class="full ca" aria-label="Casos de estudio">
      {casos.map((c, i) => (
        <a class:list={['ca-c', { gran: i === 0 }]} href={c.h}>
          <div class="ca-i"><img src={c.i} alt={`Captura de ${c.n}`} width="1280" height="800" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" /></div>
          <div class="ca-t"><h2>{c.n}</h2><p>{c.d}</p><span>Caso de estudio →</span></div>
        </a>
      ))}
    </section>
    <section class="full li">
      <h2 class="h2">Productos</h2>
      <ul>
        {featuredProjects.filter(p => p.name !== 'CONCILIA').map(p => (
          <li><a href={p.href} {...fuera(p.href)}>
            <h3>{p.name.charAt(0) + p.name.slice(1).toLowerCase().replace('pr','PR')}</h3>
            <div><p>{p.desc}</p><small>{p.tags.join(' · ')}</small></div>
            <span class="an">{p.status === 'Beta' ? 'Beta · ' : ''}{p.year} ↗</span>
          </a></li>
        ))}
      </ul>
    </section>
    <section class="full li">
      <h2 class="h2">Más proyectos</h2>
      <ul>
        {otherProjects.map(p => (
          <li><a href={p.href} {...fuera(p.href)}>
            <h3>{p.name}</h3>
            <div><p>{p.desc}</p><small>{p.tags.join(' · ')}</small></div>
            <span class="an">{p.year} ↗</span>
          </a></li>
        ))}
      </ul>
    </section>
  </main>
  <CtaBand titulo="¿Qué quieres construir?" texto="Desde un sitio de negocio hasta una plataforma a la medida." waTexto="Hola Marcos, me interesa cotizar un proyecto web." />
  <Footer />
</Base>
<style>
  .pg { padding-top: 120px }
  .cab { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 48px; padding-bottom: 28px }
  .ti { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(5rem, 19vw, 20rem); line-height: .82 }
  .cab p { max-width: 42ch; font-size: var(--text-lg); color: var(--muted) }
  .ca { display: grid; grid-template-columns: 1fr 1fr; gap: 36px 16px }
  .ca-c.gran { grid-column: 1 / -1 }
  .ca-i { overflow: hidden; border-radius: var(--radius); background: var(--surface); aspect-ratio: 16/10 }
  .gran .ca-i { aspect-ratio: 21/10 }
  .ca-i img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: scale .9s var(--ease) }
  .ca-c:hover img { scale: 1.025 }
  .ca-t { display: grid; grid-template-columns: 1fr auto; gap: 2px 20px; padding-top: 14px }
  .ca-t h2 { font-size: clamp(1.375rem, 2.2vw, 2rem); font-weight: 600; letter-spacing: -.015em }
  .ca-t p { grid-row: 2; color: var(--muted) } .ca-t span { font-weight: 600; white-space: nowrap }
  .h2 { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(2.5rem, 6vw, 6rem); line-height: .95; margin-bottom: 24px }
  .li { padding-top: var(--sec) } .li:last-of-type { padding-bottom: var(--sec) }
  .li ul { list-style: none; border-top: 1px solid var(--border) }
  .li a { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,2fr) auto; gap: 6px 28px; align-items: baseline; padding-block: 18px; border-bottom: 1px solid var(--border); transition: padding .3s var(--ease) }
  .li a:hover { padding-left: 10px } .li a:hover h3 { color: var(--flame) }
  .li h3 { font-size: clamp(1.25rem, 1.9vw, 1.625rem); font-weight: 600; letter-spacing: -.015em; transition: color .2s }
  .li p { color: var(--muted); max-width: 62ch } .li small { color: var(--dim); font-size: .875rem; display: block; margin-top: 4px }
  .an { font-size: .9375rem; white-space: nowrap; color: var(--muted) }
  @media (max-width: 760px) { .ca { grid-template-columns: 1fr } .gran .ca-i { aspect-ratio: 16/10 } .li a { grid-template-columns: 1fr auto } .li a > div { grid-row: 2; grid-column: 1 / -1 } .ca-t { grid-template-columns: 1fr } .ca-t p { grid-row: auto } }
</style>
