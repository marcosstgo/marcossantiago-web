---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

/* Carriles: 'sys' (infraestructura), 'vis' (imagen) y 'ambos'. La lente de la
   página (Todo · Sistemas · Imagen) usa el carril para apagar lo que no es de ese lado. */

const ACTUALIZADO = 'Julio 2026';

const contacto = [
  { label: 'Correo',   valor: 'hello@marcossantiago.com', href: 'mailto:hello@marcossantiago.com' },
  { label: 'Teléfono', valor: '(787) 243-9670',           href: 'tel:+17872439670' },
  { label: 'Teléfono', valor: '(787) 735-4919',           href: 'tel:+17877354919' },
  { label: 'Sitio',    valor: 'marcossantiago.com',       href: '/' },
  { label: 'Código',   valor: 'github.com/marcosstgo',    href: 'https://github.com/marcosstgo' },
  { label: 'Base',     valor: 'Aibonito, Puerto Rico',    href: null },
];

const ficha = [
  { k: 'Base',        v: 'Aibonito, Puerto Rico' },
  { k: 'Experiencia', v: 'Más de 20 años' },
  { k: 'Grado',       v: 'M.Cs. · Comercio Electrónico' },
  { k: 'Alcance',     v: 'Toda la isla y remoto' },
];

/* Cronología ascendente: la línea arranca en el carril técnico y termina
   cruzando el eje. El orden de los años ES el argumento. */
const trayectoria = [
  {
    desde: '1995', hasta: '2000', carril: 'sys', tipo: 'Formación',
    titulo: 'Bachillerato en Ciencias de Computadoras',
    donde: 'Universidad Interamericana de Puerto Rico',
    detalle: 'Concentración en Aplicaciones Comerciales.',
  },
  {
    desde: '2001', hasta: '2015', carril: 'ambos', tipo: 'Empleo',
    titulo: 'Programador Analista y Artista Gráfico',
    donde: 'Universidad Interamericana de Puerto Rico',
    detalle: 'Diseño y producción de todos los materiales promocionales de la institución, y desarrollo y mantenimiento de sus aplicaciones web y servidores.',
  },
  {
    desde: '2010', hasta: '2012', carril: 'sys', tipo: 'Formación',
    titulo: 'Maestría en Ciencias de Computadoras',
    donde: 'Universidad Interamericana de Puerto Rico',
    detalle: 'Concentración en Comercio Electrónico.',
  },
  {
    desde: '2012', hasta: 'Hoy', carril: 'ambos', tipo: 'Independiente',
    titulo: 'Artista multidisciplinario',
    donde: 'Trabajo independiente',
    detalle: 'Logotipos, identidades visuales, campañas publicitarias, contenido audiovisual y sitios web para clientes de múltiples industrias. Hoy incluye plataformas completas: comercio en línea, transmisión en vivo y aplicaciones a la medida.',
  },
  {
    desde: '2016', hasta: '2024', carril: 'ambos', tipo: 'Empleo',
    titulo: 'Diseñador Gráfico y Desarrollador Web',
    donde: 'Like Family Inc. · LatinShots Inc. · FB Logistic Inc.',
    detalle: 'Material promocional digital e impreso, programación de aplicaciones web y administración de las redes de las empresas.',
  },
];

/* Obra verificable. Todo lo que se afirma aquí se puede comprobar abriendo el
   enlace; las métricas del sitio propio se midieron con Lighthouse 12 móvil. */
const proyectos = [
  {
    destacado: true,
    nombre: 'marcossantiago.com',
    rol: 'Diseño, código e infraestructura',
    url: '/', dominio: 'marcossantiago.com',
    desc: `Este mismo sitio: portafolio interactivo en Astro y blog en MDX, con diseño, front-end, Cloudflare Pages y despliegue continuo.`,
    datos: ['Lighthouse móvil 100 · 100 · 100 · 100', 'LCP 1.5 s', 'Portada: 37.8 MB → 2.8 MB por visita'],
  },
  {
    nombre: 'Flashealo',
    rol: 'Front-end y producto',
    url: 'https://flashealo.com', dominio: 'flashealo.com',
    desc: `Aplicación para compartir y gestionar las fotos de un evento en tiempo real,
           pensada para usarse desde el celular durante la actividad.`,
    datos: ['React', 'Supabase', 'Netlify'],
  },
  {
    nombre: 'Corillo',
    rol: 'Front-end y plataforma',
    url: 'https://corillo.live', dominio: 'corillo.live',
    desc: `Plataforma de streaming en vivo para creadores de Puerto Rico. Reproductor propio
           con HLS y WebRTC de baja latencia, roster dinámico y VODs procesados automáticamente.`,
    datos: ['Astro', 'HLS.js + WHEP', 'Servidor propio'],
  },
  {
    nombre: 'Kioskko',
    rol: 'Producto completo',
    url: '/portafolio/dev/', dominio: 'Temporalmente fuera de línea',
    desc: `Tiendas en línea para negocios de Puerto Rico: catálogo, carrito y cobro con
           ATH Móvil, cada tienda con su propio dominio.`,
    datos: ['Astro con render en servidor', 'PocketBase', 'ATH Móvil'],
  },
  {
    nombre: 'FanPrompt',
    rol: 'Aplicación para cliente',
    url: 'https://fanprompt.app', dominio: 'fanprompt.app',
    desc: `Aplicación en producción con cuentas de usuario, cobros en línea y panel de
           administración con métricas de uso.`,
    datos: ['En producción', 'Pagos', 'Panel de administración'],
  },
];

const capacidades = {
  sys: [
    { t: 'Administración de sistemas', d: 'Servidores Windows y Linux, Active Directory, IIS, virtualización, seguridad informática y continuidad operacional.' },
    { t: 'Infraestructura y redes',    d: 'Redes TCP/IP, VPN, firewalls, servidores web, almacenamiento, respaldos y monitoreo de sistemas.' },
    { t: 'Bases de datos',             d: 'Microsoft SQL Server y MySQL: diseño de consultas, optimización y soporte a aplicaciones empresariales.' },
    { t: 'Integración de sistemas',    d: 'Conectar aplicaciones por bases de datos, servicios web y APIs, con automatización de procesos entre plataformas.' },
    { t: 'Documentación y soporte',    d: 'Análisis de requerimientos, resolución de incidentes, soporte de segundo y tercer nivel, y capacitación a usuarios.' },
  ],
  puente: {
    t: 'Desarrollo y diseño web',
    d: 'Sitios, tiendas y aplicaciones que se ven bien y aguantan carga: la única capacidad que aparece completa en las dos columnas.',
  },
  vis: [
    { t: 'Diseño gráfico',           d: 'Logotipos corporativos, identidad visual, ilustración de producto y piezas para impresión y redes.' },
    { t: 'Fotografía',               d: 'Retrato, evento, producto e institucional, con un enfoque narrativo sobre el técnico.' },
    { t: 'Video y edición',          d: 'Producción y postproducción de contenido audiovisual, del corporativo al social.' },
    { t: 'Marca y contenido digital', d: 'Manejo estratégico de la presencia en redes y coherencia de la marca en cada punto de contacto.' },
  ],
};

const herramientas = [
  { g: 'Sistemas', items: ['Windows Server', 'Linux', 'Active Directory', 'IIS', 'Virtualización', 'VPN', 'Firewalls', 'TCP/IP', 'Respaldos', 'Monitoreo'] },
  { g: 'Datos',    items: ['Microsoft SQL Server', 'MySQL', 'APIs', 'Servicios web', 'Automatización'] },
  { g: 'Código',   items: ['PHP', 'JavaScript', 'Python', 'React', 'Vue', 'WordPress'] },
];

const desc = 'Currículum de Marcos J. Santiago Santos, M.Cs. — administrador de sistemas, artista visual y desarrollador en Aibonito, Puerto Rico. Más de 20 años entre infraestructura IT y comunicación visual.';
---

<Base title="Currículum — Marcos J. Santiago Santos, M.Cs." description={desc}>
  <Nav />

  <main id="main" class="cv">
    <!-- Lente: un solo grupo de radios; las etiquetas se repiten en la página (label for).
         Escoger un lado cambia el lema y apaga lo que no es de ese lado. Solo CSS. -->
    <div class="vh" role="radiogroup" aria-label="Ver el perfil de">
      <input type="radio" name="lente" id="l-todo" checked aria-label="Todo" />
      <input type="radio" name="lente" id="l-sys" aria-label="Sistemas" />
      <input type="radio" name="lente" id="l-vis" aria-label="Imagen" />
    </div>

    <!-- ── Portada ── -->
    <header class="pg-hero container cv-hero">
      <p class="label pg-eyebrow">Currículum · Actualizado {ACTUALIZADO}</p>
      <h1 class="display pg-titulo cv-titulo">Marcos J. <span class="it">Santiago</span></h1>

      <div class="cv-hero-grid">
        <div>
          <p class="pg-lema cv-lema">
            <span class="lema lema--todo">Sistemas e imagen, <span class="it">en una sola persona.</span></span>
            <span class="lema lema--sys">Servidores, redes y datos <span class="it">que no se caen.</span></span>
            <span class="lema lema--vis">Diseño, foto y video <span class="it">que se recuerdan.</span></span>
          </p>
          <p class="pg-sub">
            Marcos J. Santiago Santos, M.Cs. Administrador de sistemas, artista visual y desarrollador.
            Más de veinte años ejerciendo los dos oficios, y casi siempre a la vez.
          </p>

          <div class="cv-lente" aria-hidden="true">
            <span class="label">Ver el perfil de</span>
            <span class="pg-switch">
              <label for="l-todo"><span>Todo</span></label>
              <label for="l-sys"><span>Sistemas</span></label>
              <label for="l-vis"><span>Imagen</span></label>
            </span>
          </div>

          <div class="pg-acciones">
            <a class="btn primary" href="/Marcos-Santiago-CV.pdf" download data-track="cv-descarga">
              Descargar el CV en PDF <span aria-hidden="true">↓</span>
            </a>
            <a class="btn ghost" href="/contacto/">Escríbeme</a>
          </div>
        </div>

        <img class="cv-foto" src="/marcos-photo-280.webp" width="280" height="280"
             alt="Retrato de Marcos J. Santiago Santos" loading="eager" decoding="async" fetchpriority="high" />
      </div>

      <dl class="cv-ficha">
        {ficha.map(f => (
          <div>
            <dt class="label">{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))}
      </dl>
    </header>

    <!-- ── Perfil ── -->
    <section class="on-paper pg-sec" aria-labelledby="h-perfil">
      <div class="container cv-perfil">
        <h2 class="display pg-h2" id="h-perfil">Dos oficios, <span class="it">un solo trabajo</span></h2>
        <div class="cv-prose">
          <p>
            Por un lado está la infraestructura: servidores Windows y Linux, Active Directory,
            bases de datos SQL, redes corporativas, integración de aplicaciones y automatización
            de procesos. Por el otro está la imagen: identidad visual, fotografía, video y
            desarrollo web.
          </p>
          <p>
            Los aprendí a la vez y en el mismo sitio. En la Universidad Interamericana fui
            simultáneamente el que diseñaba los materiales promocionales y el que mantenía las
            aplicaciones y los servidores. Desde entonces trabajo igual: entiendo el sistema que
            está debajo y la pieza que ve el cliente, así que ningún proyecto necesita un
            traductor entre las dos partes.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Trayectoria ── -->
    <section class="pg-sec container" aria-labelledby="h-tray">
      <div class="cv-sec-head">
        <h2 class="display pg-h2" id="h-tray">Trayectoria <span class="it">y formación</span></h2>
        <p class="pg-sub">La formación es técnica. Los tres trabajos tocan los dos lados porque en los tres ejercí las dos disciplinas a la vez.</p>
      </div>

      <ol class="tl">
        {trayectoria.map(e => (
          <li class={`tl-item tl--${e.carril}`}>
            <p class="tl-anos display">{e.desde}<span>—</span>{e.hasta}</p>
            <div class="tl-txt">
              <p class="label tl-tipo">{e.tipo}</p>
              <h3 class="tl-titulo">{e.titulo}</h3>
              <p class="tl-donde">{e.donde}</p>
              <p class="tl-det">{e.detalle}</p>
              <p class="tl-lados">
                {(e.carril === 'sys' || e.carril === 'ambos') && <span class="chip chip--sys">Sistemas</span>}
                {(e.carril === 'vis' || e.carril === 'ambos') && <span class="chip chip--vis">Imagen</span>}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- ── Proyectos ── -->
    <section class="on-paper pg-sec" aria-labelledby="h-proy">
      <div class="container">
        <div class="cv-sec-head">
          <h2 class="display pg-h2" id="h-proy">Obra <span class="it">en línea</span></h2>
          <p class="pg-sub">Todo lo de abajo está funcionando. Cada enlace abre el proyecto.</p>
        </div>

        <div class="proy">
          {proyectos.map(p => (
            <a class={`proy-card${p.destacado ? ' proy-card--top' : ''}`}
               href={p.url}
               target={p.url.startsWith('http') ? '_blank' : null}
               rel={p.url.startsWith('http') ? 'noopener' : null}>
              <p class="label">{p.rol}</p>
              <h3 class="display proy-nombre">{p.nombre}</h3>
              <p class="proy-url">{p.dominio} <span aria-hidden="true">↗</span></p>
              <p class="proy-desc">{p.desc}</p>
              <ul class="proy-datos">
                {p.datos.map(d => <li>{d}</li>)}
              </ul>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Capacidades ── -->
    <section class="pg-sec container" aria-labelledby="h-cap">
      <div class="cv-sec-head cv-sec-head--lente">
        <h2 class="display pg-h2" id="h-cap">Lo que <span class="it">sé hacer</span></h2>
        <span class="pg-switch" aria-hidden="true">
          <label for="l-todo"><span>Todo</span></label>
          <label for="l-sys"><span>Sistemas</span></label>
          <label for="l-vis"><span>Imagen</span></label>
        </span>
      </div>

      <div class="cols">
        <div class="col col--sys">
          <h3 class="display col-h">Sistemas</h3>
          {capacidades.sys.map((c, i) => (
            <div class="cap">
              <span class="pg-num cap-n">{String(i + 1).padStart(2, '0')}</span>
              <div><h4>{c.t}</h4><p>{c.d}</p></div>
            </div>
          ))}
        </div>
        <div class="col col--vis">
          <h3 class="display col-h">Imagen</h3>
          {capacidades.vis.map((c, i) => (
            <div class="cap">
              <span class="pg-num cap-n">{String(i + 1).padStart(2, '0')}</span>
              <div><h4>{c.t}</h4><p>{c.d}</p></div>
            </div>
          ))}
        </div>
      </div>

      <div class="puente">
        <p class="label pg-eyebrow">En las dos columnas</p>
        <h3 class="display">{capacidades.puente.t}</h3>
        <p>{capacidades.puente.d}</p>
      </div>

      <div class="tools">
        {herramientas.map(g => (
          <div class="tool-g">
            <h3 class="label">{g.g}</h3>
            <ul>{g.items.map(i => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Contacto ── -->
    <section class="on-paper pg-sec" aria-labelledby="h-contacto">
      <div class="container cv-perfil">
        <h2 class="display pg-h2" id="h-contacto">Contacto <span class="it">directo</span></h2>
        <dl class="contacto">
          {contacto.map(c => (
            <div class="contacto-row">
              <dt class="label">{c.label}</dt>
              <dd>
                {c.href
                  ? <a href={c.href} data-track="cv-contacto" rel={c.href.startsWith('http') ? 'noopener' : null} target={c.href.startsWith('http') ? '_blank' : null}>{c.valor}</a>
                  : c.valor}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="pg-cierre">
      <div class="container">
        <h2 class="display">¿Trabajamos <span class="it">juntos?</span></h2>
        <p>El CV completo en una página para guardar o imprimir. O escríbeme y hablamos del proyecto.</p>
        <div class="pg-acciones">
          <a class="btn" href="/Marcos-Santiago-CV.pdf" download data-track="cv-descarga-fin">Descargar el CV en PDF <span aria-hidden="true">↓</span></a>
          <a class="btn" href="https://wa.me/17872439670" target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i> WhatsApp · 787-243-9670</a>
          <a class="btn" href="/sobre-mi/">La versión en primera persona</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* En papel el naranja baja un tono para que el acento pase contraste */
  .on-paper .it { color: #c2360c }

  /* ── Portada ── */
  .cv-titulo { font-size: clamp(3.2rem, 11vw, 10rem) }
  .cv-hero-grid { display: grid; grid-template-columns: 1fr auto; gap: clamp(24px, 5vw, 80px); align-items: start }
  .cv-foto {
    width: clamp(120px, 18vw, 240px); aspect-ratio: 1; object-fit: cover;
    border-radius: 50%; filter: grayscale(1) contrast(1.06);
    outline: 1px solid var(--border-h); outline-offset: 8px;
  }

  /* El lema cambia según la lente */
  .cv-lema { display: grid; min-height: 2.3em }
  .lema { grid-area: 1 / 1; transition: opacity .3s var(--ease), translate .3s var(--ease) }
  .lema--sys, .lema--vis { opacity: 0; translate: 0 .3em; pointer-events: none }
  .cv:has(#l-sys:checked) .lema--sys,
  .cv:has(#l-vis:checked) .lema--vis { opacity: 1; translate: 0 0 }
  .cv:has(#l-sys:checked) .lema--todo,
  .cv:has(#l-vis:checked) .lema--todo { opacity: 0; translate: 0 -.3em }
  .lema:not(.lema--todo) { visibility: hidden }
  .cv:has(#l-sys:checked) .lema--sys, .cv:has(#l-vis:checked) .lema--vis { visibility: visible }

  .cv-lente { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-bottom: 28px }
  /* Las etiquetas viven fuera de su input: el estado activo se lee desde .cv */
  .cv:has(#l-todo:checked) label[for="l-todo"] span,
  .cv:has(#l-sys:checked) label[for="l-sys"] span,
  .cv:has(#l-vis:checked) label[for="l-vis"] span { background: var(--flame); color: var(--ink) }
  .cv:has(#l-todo:focus-visible) label[for="l-todo"] span,
  .cv:has(#l-sys:focus-visible) label[for="l-sys"] span,
  .cv:has(#l-vis:focus-visible) label[for="l-vis"] span { outline: 2px solid var(--white); outline-offset: 2px }

  .cv-ficha {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;
    margin-top: clamp(40px, 6vw, 72px); padding-top: 22px; border-top: 1px solid var(--border);
  }
  .cv-ficha dt { color: var(--dim); margin-bottom: 6px }
  .cv-ficha dd { font-size: var(--text-lg); font-weight: 600 }

  /* ── Perfil y contacto: título a un lado, texto al otro ── */
  .cv-perfil { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(24px, 5vw, 80px); align-items: start }
  .cv-prose p { font-size: clamp(1.1rem, 1.6vw, 1.3rem); line-height: 1.65; color: var(--muted); max-width: 58ch }
  .cv-prose p + p { margin-top: 1.1em }
  .cv-prose p:first-child { color: var(--white) }

  .cv-sec-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 12px 40px; margin-bottom: clamp(28px, 4vw, 48px) }
  .cv-sec-head .pg-h2 { margin-bottom: 0 }
  .cv-sec-head .pg-sub { margin-bottom: 0; max-width: 46ch }

  /* ── Trayectoria ── */
  .tl { list-style: none }
  .tl-item {
    display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 16px clamp(24px, 5vw, 80px);
    padding: clamp(26px, 3.4vw, 40px) 0; border-top: 1px solid var(--border);
    transition: opacity .35s var(--ease);
  }
  .tl-item:last-child { border-bottom: 1px solid var(--border) }
  .tl-anos { font-size: clamp(2.4rem, 5.4vw, 4.6rem); line-height: .9; color: var(--white) }
  .tl-anos span { color: var(--flame); margin-inline: .08em }
  .tl-tipo { color: var(--flame); margin-bottom: 8px }
  .tl-titulo { font-size: clamp(1.3rem, 2.2vw, 1.75rem); line-height: 1.2 }
  .tl-donde { color: var(--dim); margin-top: 4px }
  .tl-det { color: var(--muted); line-height: 1.7; margin-top: 12px; max-width: 60ch }
  .tl-lados { display: flex; gap: 8px; margin-top: 16px }
  .chip {
    font-size: var(--text-2xs); font-weight: 600; letter-spacing: .09em; text-transform: uppercase;
    padding: 5px 11px; border-radius: 99px; border: 1px solid var(--border-h); color: var(--muted);
    transition: background .25s, color .25s, border-color .25s;
  }
  .cv:has(#l-sys:checked) .chip--sys,
  .cv:has(#l-vis:checked) .chip--vis { background: var(--flame); border-color: var(--flame); color: var(--ink) }
  /* La lente apaga lo que no es de ese lado */
  .cv:has(#l-vis:checked) .tl--sys,
  .cv:has(#l-sys:checked) .tl--vis { opacity: .28 }

  /* ── Proyectos ── */
  .proy { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px }
  .proy-card {
    display: flex; flex-direction: column; gap: 6px;
    padding: clamp(22px, 3vw, 34px); border: 1px solid var(--border-h); border-radius: var(--radius);
    transition: background .25s, border-color .25s, translate .25s var(--ease);
  }
  .proy-card:hover { background: var(--surface); border-color: var(--on-paper); translate: 0 -3px }
  .proy-card .label { color: var(--dim) }
  .proy-nombre { font-size: clamp(2rem, 3.6vw, 3rem); margin-top: 6px }
  .proy-url { color: #c2360c; font-weight: 600; font-size: var(--text-sm) }
  .proy-desc { color: var(--muted); line-height: 1.65; margin-top: 8px; max-width: 62ch }
  .proy-datos { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 16px }
  .proy-datos li { font-size: var(--text-xs); padding: 4px 10px; border-radius: 99px; border: 1px solid var(--border) }
  .proy-card--top { grid-column: 1 / -1; background: var(--ink); color: var(--paper); border-color: var(--ink) }
  .proy-card--top .label, .proy-card--top .proy-desc { color: rgba(243,238,229,.72) }
  .proy-card--top .proy-url { color: var(--flame) }
  .proy-card--top .proy-datos li { border-color: rgba(243,238,229,.3) }
  .proy-card--top:hover { background: #000; border-color: var(--flame) }
