---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Pagar from '../components/pagos/Pagar.astro';
import { wa } from '../data/site';

// Ventanilla: el módulo de pagos con ATH Móvil (repositorio privado marcosstgo/pagos-athmovil).
// Precios aprobados el 2026-11-06 (pagos-athmovil/docs/servicio.md).
// Ejemplos de lo que se cobra (cinta de la portada)
const cinta = [
  { c: 'Depósito de boda', m: '$250' },
  { c: 'Consulta', m: '$75' },
  { c: 'Matrícula', m: '$120' },
  { c: 'Abono', m: '$500' },
  { c: 'Mensualidad', m: '$45' },
  { c: 'Reserva', m: '$100' },
  { c: 'Taller', m: '$35' },
  { c: 'Servicio', m: '$180' },
];
const msg = 'Hola Marcos, me interesa Ventanilla para cobrar con ATH Móvil en mi página.';

const pasos = [
  { n: '1', t: 'Toca Pagar', d: 'En tu página, o en un enlace que le mandas por WhatsApp con la cantidad ya puesta.' },
  { n: '2', t: 'Escribe su ATH Móvil', d: 'La cantidad, de qué es el pago y el número de su celular. Nada más.' },
  { n: '3', t: 'Aprueba en la app', d: 'Le llega una notificación de ATH Móvil y la confirma ahí, como siempre.' },
  { n: '4', t: 'Recibo y aviso', d: 'Ve su recibo en pantalla y a ti te llega un correo con el pago y su referencia.' },
];

const faq = [
  {
    q: '¿Qué necesito para empezar?',
    a: 'Una cuenta de ATH Business activa (la abres desde la app ATH Business) y tu página web. Las llaves de tu cuenta las ponemos juntos el día de la instalación: nunca pasan por correo ni por chat.',
  },
  {
    q: 'Mi página está en Wix, WordPress o Squarespace. ¿Funciona?',
    a: 'Sí. Te monto una página de pagos propia, como pagos.tunegocio.com, con tu logo y tus colores. En tu página solo pones un botón de Pagar que lleva ahí.',
  },
  {
    q: '¿Ventanilla cobra comisión por cada pago?',
    a: 'No. Pagas la instalación y una cuota mensual fija. Las comisiones de cada transacción son las de tu cuenta de ATH Business.',
  },
  {
    q: '¿Qué pasa si el cliente aprueba en la app y cierra la página?',
    a: 'El pago se completa igual. El servidor revisa cada minuto los pagos aprobados y los termina de cobrar, aunque nadie tenga la página abierta.',
  },
  {
    q: '¿Es seguro?',
    a: 'Las llaves de tu cuenta viven cifradas en el servidor y nunca llegan al navegador. Cada pago tiene su propia clave secreta, hay antispam y límites de intentos para que nadie use tu página para molestar a otra persona, y no se guarda ningún dato bancario: eso nunca sale de ATH Móvil.',
  },
  {
    q: '¿Puedo tener PayPal también?',
    a: 'Sí, como segunda opción en la misma pantalla, con la cantidad ya puesta.',
  },
];

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Ventanilla — pagos con ATH Móvil para tu página web',
      provider: { '@type': 'Person', name: 'Marcos Santiago', url: 'https://marcossantiago.com/' },
      areaServed: 'Puerto Rico',
      url: 'https://marcossantiago.com/ventanilla/',
      offers: { '@type': 'Offer', price: '199', priceCurrency: 'USD', description: 'Instalación en una página hecha por Marcos Santiago; $10 al mes' },
    },
    { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
---

<Base
  title="Ventanilla: pagos con ATH Móvil para tu página web — Marcos Santiago"
  description="Tus clientes te pagan con ATH Móvil desde tu página web en segundos, con recibo en pantalla y aviso de cada pago. Instalación desde $199. Pruébalo en vivo."
>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <Nav />
  <main id="main" class="vt">
    <!-- ── Portada: el titular y el teléfono con la demo ── -->
    <section class="vt-hero container">
      <div class="vt-hero-txt">
        <a href="/servicios/#desarrollo" class="vt-volver">← Servicios</a>
        <p class="label vt-eyebrow"><span class="vt-punto" aria-hidden="true"></span> Producto propio · cobrando en vivo</p>
        <h1 class="display vt-titulo">Ventanilla</h1>
        <p class="vt-lema">
          Que te paguen con ATH Móvil <span class="it">desde tu página,</span> sin el «envíame un ATH al 787…»
        </p>
        <p class="vt-sub">
          Tu cliente escribe la cantidad, aprueba en su app y ve su recibo. Tú sabes de quién y de qué es cada pago.
        </p>
        <div class="vt-acciones">
          <a class="btn primary" href="#demo">Pruébalo aquí <span aria-hidden="true">↓</span></a>
          <a class="btn whatsapp" href={wa(msg)} target="_blank" rel="noopener" data-track="ventanilla-hero">
            <i class="fab fa-whatsapp"></i> Lo quiero
          </a>
        </div>
        <ul class="vt-datos">
          <li><b>Desde $199</b> instalación</li>
          <li><b>$0</b> comisión de Ventanilla</li>
          <li><b>Wix, WordPress</b> y más</li>
        </ul>
      </div>

      <div class="vt-escena" id="demo">
        <svg class="vt-sello" viewBox="0 0 120 120" aria-hidden="true">
          <defs><path id="vt-circ" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0" /></defs>
          <text><textPath href="#vt-circ" textLength="286" lengthAdjust="spacing">PRUÉBALO AQUÍ · NO SE COBRA NADA ·</textPath></text>
        </svg>
        <div class="vt-notifs" aria-hidden="true">
          <p class="vt-notif n1"><b>Pago recibido</b><span>Depósito · $250.00</span></p>
          <p class="vt-notif n2"><b>Aprobado en ATH Móvil</b><span>Consulta · $75.00</span></p>
          <p class="vt-notif n3"><b>Recibo enviado</b><span>Matrícula · $120.00</span></p>
        </div>
        <div class="vt-phone">
          <div class="vt-screen">
            <Pagar
              demo
              negocio="Tu Negocio"
              titulo="Pagar en línea"
              ayuda="Escribe cualquier cantidad para probar."
              conceptos={[
                { value: 'servicio', label: 'Servicio' },
                { value: 'abono', label: 'Abono' },
                { value: 'otro', label: 'Otro' },
              ]}
            />
          </div>
        </div>
        <p class="vt-nota-demo">
          Es la pantalla que ven tus clientes. ¿Lo quieres ver de verdad? Esta página usa Ventanilla:{" "}
          <a href="/pagar/">págame aquí</a> con tu ATH Móvil.
        </p>
      </div>
    </section>

    <!-- ── Cinta de pagos ── -->
    <div class="vt-cinta" aria-hidden="true">
      <div class="vt-cinta-pista">
        {[0, 1].map(() => cinta.map((c) => <span>{c.c} <b>{c.m}</b></span>))}
      </div>
    </div>

    <!-- ── Antes y con Ventanilla: se cambia tocando ── -->
    <section class="vt-vs container" aria-labelledby="t-vs">
      <div class="vt-vs-cab">
        <h2 class="display vt-h2" id="t-vs">El cobro <span class="it">de siempre</span></h2>
        <div class="vt-switch" role="radiogroup" aria-label="Comparar">
          <label><input type="radio" name="vt-vs" value="antes" checked /><span>Antes</span></label>
          <label><input type="radio" name="vt-vs" value="ahora" /><span>Con Ventanilla</span></label>
        </div>
      </div>

      <div class="vt-vs-cuerpo">
        <div class="vt-vs-lado" data-vs="antes">
          <div class="vt-chat">
            <p class="ellos">Hola, ¿a qué número te envío el ATH?</p>
            <p class="tu">Al 787-555-0123</p>
            <p class="ellos">Listo, enviado</p>
            <p class="vt-chat-hora">2 días después</p>
            <p class="tu">Me entró un ATH de $75 de «Juanma»… ¿eso era de qué?</p>
            <p class="ellos">Ehh… no me acuerdo</p>
          </div>
          <div class="vt-vs-txt">
            <h3>Cobrar a mano</h3>
            <p>
              En Puerto Rico casi todo el mundo paga con ATH Móvil, pero en la web el cobro sigue siendo a mano: el
              cliente te pide el número, te envía un ATH y después hay que adivinar de qué era cada pago.
            </p>
            <p>
              Wix, Squarespace o Shopify no traen ATH Móvil. Y la integración básica tiene un punto débil: si el
              cliente aprueba y cierra la página antes de tiempo, el pago se vence <strong>sin cobrarse</strong>.
            </p>
          </div>
        </div>

        <div class="vt-vs-lado" data-vs="ahora">
          <div class="vt-recibo">
            <span class="vt-check" aria-hidden="true">✓</span>
            <p class="vt-recibo-t">¡Pago recibido!</p>
            <dl>
              <div><dt>Monto</dt><dd>$75.00</dd></div>
              <div><dt>Concepto</dt><dd>Consulta</dd></div>
              <div><dt>Referencia</dt><dd>Juan Manuel Rivera</dd></div>
              <div><dt>Confirmación ATH</dt><dd>8f3a-21c9</dd></div>
            </dl>
            <p class="vt-recibo-pie">Y a ti te llega el aviso con todo esto.</p>
          </div>
          <div class="vt-vs-txt">
            <h3>Cobrar con Ventanilla</h3>
            <p>
              Un botón de <strong>Pagar</strong> en tu página abre una pantalla tipo app. El cliente paga con su ATH
              Móvil en segundos y recibe su recibo. A ti te llega un correo con la cantidad, el concepto, su referencia
              y el número de confirmación de ATH.
            </p>
            <p>
              El cobro lo completa el servidor: revisa <strong>cada minuto</strong> los pagos aprobados y los termina de
              cobrar aunque el cliente haya cerrado la página.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Pasos, en papel ── -->
    <section class="vt-pasos on-paper" aria-labelledby="t-pasos">
      <div class="container">
        <h2 class="display vt-h2" id="t-pasos">Así paga <span class="it">tu cliente</span></h2>
        <ol>
          {
            pasos.map((p) => (
              <li>
                <span class="vt-n">0{p.n}</span>
                <h3>{p.t}</h3>
                <p>{p.d}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ── Números y qué incluye ── -->
    <section class="vt-numeros container" aria-labelledby="t-incluye">
      <div class="vt-stats">
        <div><b>1 min</b><span>Revisión de pagos pendientes</span></div>
        <div><b>$1,500</b><span>Por pago (límite de ATH)</span></div>
        <div><b>0</b><span>Datos bancarios guardados</span></div>
      </div>
      <div class="vt-incluye">
        <h2 class="display vt-h2" id="t-incluye">Qué <span class="it">incluye</span></h2>
        <ul>
          <li>Botón de Pagos en tu página y enlaces con la cantidad ya puesta</li>
          <li>Pantalla tipo app con tus colores, hecha para el celular</li>
          <li>Recibo en pantalla y correo por cada pago</li>
          <li>Conceptos a tu medida (consulta, abono, servicio…)</li>
          <li>PayPal como segunda opción, si lo quieres</li>
          <li>Antispam, límites de intentos y llaves cifradas</li>
          <li>Prueba real con tu cuenta antes de entregarlo</li>
        </ul>
        <p class="vt-prueba">
          En producción desde noviembre de 2026 en la página de un bufete de abogados en Puerto Rico. La primera prueba
          con dinero real funcionó a la primera.
        </p>
      </div>
    </section>

    <!-- ── Precios: tocas dónde está tu página y cambia el precio ── -->
    <section class="vt-precios container" aria-labelledby="t-precios">
      <h2 class="display vt-h2" id="t-precios">Precios</h2>
      <div class="vt-donde" role="radiogroup" aria-label="¿Dónde está tu página?">
        <p class="label">¿Dónde está tu página?</p>
        <label><input type="radio" name="vt-donde" value="mia" checked /><span>La hizo Marcos</span></label>
        <label><input type="radio" name="vt-donde" value="otra" /><span>Wix, WordPress u otra</span></label>
      </div>

      <div class="vt-planes">
        <article class="vt-plan vt-plan-grande" data-plan="mia">
          <h3>Tu página hecha conmigo</h3>
          <p class="vt-precio"><span class="vt-sig">$</span>199</p>
          <p class="vt-mes">instalación · <b>+ $10 al mes</b></p>
          <p>Ventanilla integrada en tu página: botón en el menú, pantalla de pagos y avisos. Lo más económico: tu página ya la conozco.</p>
          <a class="btn primary" href={wa(`${msg} Mi página la hiciste tú.`)} target="_blank" rel="noopener" data-track="ventanilla-plan-propia">Cotizar por WhatsApp</a>
        </article>
        <article class="vt-plan vt-plan-grande" data-plan="otra">
          <h3>Tu página en otra plataforma</h3>
          <p class="vt-precio"><span class="vt-sig">$</span>349</p>
          <p class="vt-mes">instalación · <b>+ $20 al mes</b></p>
          <p>Wix, WordPress, Squarespace…: página de pagos propia (pagos.tunegocio.com) con tu logo y tus colores.</p>
          <p class="vt-lanz"><strong>Precio de lanzamiento:</strong> $199 de instalación para los primeros clientes.</p>
          <a class="btn primary" href={wa(`${msg} Mi página está en otra plataforma.`)} target="_blank" rel="noopener" data-track="ventanilla-plan-otra">Cotizar por WhatsApp</a>
        </article>
        <article class="vt-plan vt-extras">
          <h3>Extras</h3>
          <p class="vt-precio vt-precio-s">Desde $150</p>
          <p class="vt-mes">cada uno · pago único</p>
          <p>Panel para ver tus pagos, devoluciones desde la página o enlaces de pago por factura.</p>
          <a class="btn" href={wa(`${msg} Me interesan los extras.`)} target="_blank" rel="noopener" data-track="ventanilla-plan-extras">Preguntar</a>
        </article>
      </div>
      <p class="vt-fine">
        La cuota mensual cubre el hosting, la vigilancia de los pagos, los cambios de ATH Móvil y el soporte. Sin
        comisión por pago: las de cada transacción son las de tu cuenta de ATH Business.
      </p>
    </section>

    <section class="vt-faq container" aria-labelledby="t-faq">
      <h2 class="display vt-h2" id="t-faq">Preguntas</h2>
      <div>
        {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </section>

    <!-- ── Cierre en el color del sitio ── -->
    <section class="vt-cierre">
      <div class="container">
        <h2 class="display">¿Cobras por <span class="it">ATH Móvil?</span></h2>
        <p>Pon una ventanilla de pagos en tu página y deja de perseguir pagos por WhatsApp. Cuéntame qué cobras y te digo cómo quedaría.</p>
        <a href={wa(msg)} target="_blank" rel="noopener" class="btn vt-cierre-btn" data-track="ventanilla-cta">
          <i class="fab fa-whatsapp"></i> Escríbeme · (787) 243-9670
        </a>
      </div>
    </section>

    <div class="container"><p class="vt-marca">
      ATH Móvil y ATH Business son marcas registradas de Evertec. Ventanilla es un servicio independiente de Marcos
      Santiago que se conecta con ATH Móvil Business; no está afiliado ni patrocinado por Evertec.
    </p></div>
  </main>
  <Footer />
</Base>

<style>
  /* Los colores del panel de pagos están en global.css (.pay) */
  .vt { --c: var(--flame); overflow-x: clip }
  .vt-h2 { font-size: clamp(2.6rem, 6.4vw, 5.6rem); margin-bottom: 28px }
  .vt-h2 .it, .vt-cierre .it { color: var(--flame) }

  /* Portada */
  .vt-hero {
    display: grid;
    grid-template-columns: 1.1fr minmax(320px, 420px);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
    padding-top: clamp(104px, 12vw, 150px);
    padding-bottom: clamp(56px, 8vw, 110px);
  }
  .vt-volver { display: inline-block; color: var(--dim); font-size: var(--text-xs); letter-spacing: .09em; text-transform: uppercase; margin-bottom: 28px; transition: color .2s }
  .vt-volver:hover { color: var(--flame) }
  .vt-eyebrow { display: flex; align-items: center; gap: 10px; color: var(--flame); margin-bottom: 14px }
  .vt-punto { width: 9px; height: 9px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 0 0 rgba(74, 222, 128, .6); animation: vt-latido 2s infinite }
  @keyframes vt-latido { 70% { box-shadow: 0 0 0 10px rgba(74, 222, 128, 0) } 100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0) } }
  .vt-titulo { font-size: clamp(4.2rem, 13.5vw, 12.5rem); line-height: .82; margin-left: -.04em; margin-bottom: 26px }
  .vt-lema { font-size: clamp(1.5rem, 2.9vw, 2.45rem); line-height: 1.12; max-width: 19ch; margin-bottom: 18px; text-wrap: balance }
  .vt-lema .it { color: var(--flame) }
  .vt-sub { color: var(--muted); font-size: var(--text-lg); line-height: 1.6; max-width: 44ch; margin-bottom: 30px }
  .vt-acciones { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 34px }
  .vt-datos { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 26px; color: var(--dim); font-size: var(--text-sm) }
  .vt-datos b { color: var(--white); font-weight: 700 }

  .vt-escena { position: relative; scroll-margin-top: 90px }
  .vt-escena::before {
    content: '';
    position: absolute;
    inset: 8% -18% 10%;
    background: radial-gradient(closest-side, rgba(255, 79, 31, .38), transparent);
    filter: blur(20px);
    z-index: -1;
  }
  .vt-phone {
    padding: 12px;
    border-radius: 46px;
    background: #050505;
    border: 1px solid var(--border-h);
    box-shadow: 0 50px 100px -40px rgba(255, 79, 31, .55), inset 0 0 0 2px #1d1b18;
  }
  .vt-screen { padding: 34px 20px 22px; border-radius: 36px; background: #16150f; min-height: 640px }
  .vt-nota-demo { margin-top: 18px; color: var(--dim); font-size: var(--text-sm); line-height: 1.55; text-align: center; text-wrap: balance }
  .vt-nota-demo a { color: var(--flame); text-decoration: underline; text-underline-offset: 3px }

  /* Sello que gira */
  .vt-sello { position: absolute; width: 128px; bottom: 16%; left: -70px; z-index: 2; animation: vt-gira 18s linear infinite }
  .vt-sello text { font: 700 10.4px var(--body); fill: var(--ink) }
  .vt-sello { background: var(--flame); border-radius: 50%; box-shadow: 0 10px 30px -8px rgba(0, 0, 0, .6) }
  @keyframes vt-gira { to { rotate: 360deg } }

  /* Avisos que flotan */
  .vt-notifs { position: absolute; inset: 0; pointer-events: none; z-index: 3 }
  .vt-notif {
    position: absolute;
    display: grid;
    gap: 2px;
    padding: 12px 16px 12px 44px;
    min-width: 210px;
    border-radius: 16px;
    background: rgba(243, 238, 229, .94);
    color: var(--on-paper);
    font-size: .82rem;
    line-height: 1.3;
    box-shadow: 0 18px 40px -12px rgba(0, 0, 0, .65);
    backdrop-filter: blur(10px);
    opacity: 0;
    animation: vt-aviso 9s var(--ease) infinite;
  }
  .vt-notif::before {
    content: '✓';
    position: absolute;
    left: 13px;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--flame);
    color: var(--ink);
    font-weight: 800;
    font-size: .75rem;
  }
  .vt-notif b { font-weight: 700 }
  .vt-notif span { color: rgba(20, 18, 15, .7) }
  .n1 { top: 20%; left: -40% }
  .n2 { top: 44%; right: -8%; animation-delay: 3s }
  .n3 { bottom: 34%; left: -36%; animation-delay: 6s }
  @keyframes vt-aviso {
    0% { opacity: 0; translate: 0 14px; scale: .96 }
    6%, 30% { opacity: 1; translate: 0 0; scale: 1 }
    38%, 100% { opacity: 0; translate: 0 -10px; scale: .98 }
  }

  @media (max-width: 960px) {
    .vt-hero { grid-template-columns: 1fr }
    .vt-escena { max-width: 420px; width: 100%; margin-inline: auto; margin-top: 30px }
    .vt-screen { min-height: 0 }
    .vt-sello { width: 96px; bottom: auto; top: -34px; left: -8px }
    .n1 { left: auto; right: -3% }
    .n2 { right: auto; left: -3% }
    .n3 { left: auto; right: -3% }
    .vt-notif { min-width: 0; font-size: .76rem }
  }

  /* Cinta */
  .vt-cinta {
    background: var(--flame);
    color: var(--ink);
    padding: 16px 0;
    rotate: -1.6deg;
    margin: 10px -2vw 0;
    overflow: hidden;
    box-shadow: 0 20px 50px -20px rgba(255, 79, 31, .5);
  }
  .vt-cinta-pista { display: flex; width: max-content; animation: vt-cinta 38s linear infinite }
  .vt-cinta span {
    font-family: var(--display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.3rem, 2.6vw, 2.1rem);
    letter-spacing: .01em;
    white-space: nowrap;
    padding-inline: 22px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .vt-cinta span::after { content: '✦'; font-size: .6em; margin-left: 32px }
  .vt-cinta b { font-family: var(--serif); font-style: italic; font-weight: 400; text-transform: none; font-size: 1.1em }
  @keyframes vt-cinta { to { translate: -50% 0 } }

  /* Antes / Con Ventanilla */
  .vt-vs { padding-block: clamp(90px, 12vw, 160px) }
  .vt-vs-cab { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 40px }
  .vt-vs-cab .vt-h2 { margin-bottom: 0 }
  .vt-switch, .vt-donde {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
