---
// /pagar/: para enlaces directos con la cantidad ya puesta y para quien llega sin JavaScript.
// Ejemplo: /pagar/?monto=250&concepto=deposito&ref=Boda%20Rivera
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Pagar from '../components/pagos/Pagar.astro';
import { pagos } from '../data/site';
---

<Base
  title="Pagar en línea — Marcos Santiago"
  description="Págale a Marcos Santiago con ATH Móvil desde tu celular: depósitos de reserva y pagos de proyectos."
  payDialog={false}
>
  <Nav />
  <main id="main" class="pg-pagar container">
    <div class="txt">
      <p class="label pg-eyebrow">Pagos en línea · ATH Móvil</p>
      <h1 class="display pg-titulo">Pagar</h1>
      <p class="pg-lema">Depósitos de reserva y pagos de proyectos, <span class="it">desde tu celular.</span></p>
      <p class="pg-sub">Escribe la cantidad acordada, aprueba en tu app de ATH Móvil y recibe tu recibo aquí mismo.</p>
      <p class="nota">¿Quieres esto en tu página? <a href="/ventanilla/">Conoce Ventanilla →</a></p>
    </div>
    <div class="caja">
      <Pagar {...pagos} />
    </div>
  </main>
  <Footer />
</Base>

<style>
  .pg-pagar {
    display: grid;
    grid-template-columns: 1fr minmax(320px, 460px);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
    padding-top: clamp(110px, 12vw, 150px);
    padding-bottom: 96px;
  }
  @media (max-width: 900px) {
    .pg-pagar { grid-template-columns: 1fr }
  }
  .caja {
    width: 100%;
    box-shadow: 0 50px 100px -40px rgba(255, 79, 31, .45);
    padding: clamp(24px, 5vw, 40px);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
  }
  .nota {
    color: var(--dim);
    font-size: var(--text-xs);
  }
  .nota a {
    color: var(--flame);
  }
</style>
