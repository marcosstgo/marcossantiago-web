---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const WA = 'https://wa.me/17872439670';

const packages = [
  {
    name: 'Reel Individual',
    price: '175',
    unit: 'por reel',
    featured: false,
    features: [
      '1 reel de 30–60 segundos',
      '1 locación (hasta 1.5 hrs)',
      'Edición completa: música, subtítulos y color',
      '1 ronda de revisión',
      'Entrega en 3–5 días',
    ],
    wa: 'Hola Marcos, me interesa el Reel Individual ($175).',
  },
  {
    name: 'Sesión de Contenido',
    price: '400',
    unit: '3 reels · $133 c/u',
    featured: true,
    features: [
      'Sesión de hasta 3 horas',
      '1 locación',
      'Shot list incluido',
      '3 reels editados',
      '1 revisión por reel',
      'Entrega en 5–7 días',
    ],
    wa: 'Hola Marcos, me interesa la Sesión de Contenido ($400, 3 reels).',
  },
  {
    name: 'Sesión Premium',
    price: '600',
    unit: '5 reels · $120 c/u',
    featured: false,
    features: [
      'Media jornada (hasta 4 hrs)',
      'Hasta 2 locaciones cercanas',
      'Mini-estrategia de contenido',
      '5 reels editados',
      '1 revisión por reel',
      'Entrega en 7–10 días',
    ],
    wa: 'Hola Marcos, me interesa la Sesión Premium ($600, 5 reels).',
  },
];

const plans = [
  {
    name: 'Plan Básico',
    price: '500',
    features: [
      '4 reels mensuales (1 sesión de grabación)',
      'Calendario de publicación',
      'Entrega semanal',
    ],
    wa: 'Hola Marcos, me interesa el Plan Básico ($500/mes).',
  },
  {
    name: 'Plan Pro',
    price: '850',
    features: [
      '8 reels mensuales (2 sesiones de grabación)',
      'Estrategia de contenido + adaptaciones TikTok/FB',
      'Prioridad de entrega',
    ],
    wa: 'Hola Marcos, me interesa el Plan Pro ($850/mes).',
  },
];

const addons = [
  { label: 'Toma aérea con dron', price: '+$75', v: 75 },
  { label: 'Locación adicional', price: '+$50', v: 50 },
  { label: 'Guion elaborado', price: '+$50', v: 50 },
  { label: 'Revisión adicional', price: '$35', v: 35 },
  { label: 'Entrega express (48 hrs)', price: '+25%' },
  { label: 'Viaje fuera de 25 millas', price: '$0.70/milla' },
];
// Los que tienen precio fijo entran en la calculadora; los demás se cotizan aparte
const sumables = addons.filter((a) => a.v);
const otros = addons.filter((a) => !a.v);
const waGeneral = `${WA}?text=${encodeURIComponent('Hola Marcos, quiero cotizar producción de reels.')}`;
---

<Base
  title="Tarifario de Reels en Puerto Rico — Marcos Santiago"
  description="Precios de producción de reels profesionales para Instagram, TikTok y Facebook en Puerto Rico. Paquetes desde $175, sesiones de contenido y planes mensuales.">
  <Nav />
  <main id="main">
    <!-- ── Portada ── -->
    <section class="pg-hero container">
      <p class="label pg-eyebrow">Producción de reels · Puerto Rico</p>
      <h1 class="display pg-titulo">Reels</h1>
      <p class="pg-lema">Tarifario de contenido vertical <span class="it">para Instagram, TikTok y Facebook.</span></p>
      <p class="pg-sub">
        Clips de 30–60 segundos con grabación, edición, música, subtítulos y color. Escoge un paquete abajo y ve el
        precio al momento.
      </p>
      <div class="pg-acciones">
        <a href="#arma" class="btn primary">Arma tu paquete <span aria-hidden="true">↓</span></a>
        <a href="#planes" class="btn ghost">Planes mensuales</a>
      </div>
    </section>

    <!-- ── Calculadora: paquete + extras = estimado ── -->
    <section class="arma container" id="arma" aria-labelledby="t-arma">
      <h2 class="display pg-h2" id="t-arma">Arma <span class="it">tu paquete</span></h2>
      <form class="calc" aria-describedby="calc-nota">
        <fieldset class="pkgs">
          <legend class="label">1 · Escoge el paquete</legend>
          {packages.map((p) => (
            <label class="pkg" style={`--v:${p.price}`}>
              <input type="radio" name="pkg" value={p.price} data-nombre={p.name} checked={p.featured} />
              <span class="pkg-cuerpo">
                {p.featured && <span class="pkg-badge">Más popular</span>}
                <span class="pkg-name">{p.name}</span>
                <span class="pkg-price"><span class="sig">$</span>{p.price}</span>
                <span class="pkg-unit">{p.unit}</span>
                <span class="pkg-features">
                  {p.features.map((f) => <span>{f}</span>)}
                </span>
              </span>
            </label>
          ))}
        </fieldset>

        <div class="calc-lado">
          <fieldset class="extras">
            <legend class="label">2 · Añade lo que necesites</legend>
            {sumables.map((a) => (
              <label class="extra" style={`--v:${a.v}`}>
                <input type="checkbox" name="extra" value={a.v} data-nombre={a.label} />
                <span class="extra-caja" aria-hidden="true"></span>
                <span class="extra-label">{a.label}</span>
                <span class="extra-precio">{a.price}</span>
              </label>
            ))}
            {otros.map((a) => (
              <p class="extra extra-fijo"><span class="extra-label">{a.label}</span><span class="extra-precio">{a.price}</span></p>
            ))}
          </fieldset>

          <div class="calc-total" aria-live="polite">
            <span class="label">Estimado</span>
            <p class="total"><span class="sig">$</span><b class="total-n"></b></p>
            <p class="calc-nota" id="calc-nota">Sin IVU. La cotización final te la confirmo por WhatsApp.</p>
            <a class="btn primary calc-wa" href={waGeneral} target="_blank" rel="noopener" data-track="reels-calculadora">
              <i class="fab fa-whatsapp"></i> Reservar por WhatsApp
            </a>
          </div>
        </div>
      </form>
    </section>

    <!-- ── Planes mensuales, en papel ── -->
    <section class="planes pg-papel pg-sec" id="planes" aria-labelledby="t-planes">
      <div class="container">
        <h2 class="display pg-h2" id="t-planes">Contenido <span class="it">cada semana</span></h2>
        <p class="planes-sub">Planes mensuales con un ritmo fijo de publicación. Contrato mínimo de 3 meses.</p>
        <div class="plan-grid">
          {plans.map((pl) => (
            <article class="plan">
              <h3 class="plan-name">{pl.name}</h3>
              <p class="plan-price"><span class="pg-num">${pl.price}</span><span class="plan-per">/mes</span></p>
              <ul>
                {pl.features.map((f) => <li>{f}</li>)}
              </ul>
              <a href={`${WA}?text=${encodeURIComponent(pl.wa)}`} target="_blank" rel="noopener" class="btn">Empezar plan</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Condiciones ── -->
    <section class="condiciones container pg-sec" aria-labelledby="t-cond">
      <h2 class="display pg-h2" id="t-cond">Condiciones</h2>
      <ul>
        <li>Depósito de 50% para reservar fecha · balance contra entrega del material final.</li>
        <li>Los precios no incluyen IVU donde aplique. Cotizaciones válidas por 30 días.</li>
        <li>Proyectos municipales y corporativos se cotizan por propuesta personalizada.</li>
      </ul>
    </section>

    <!-- ── Cierre ── -->
    <section class="pg-cierre">
      <div class="container">
        <h2 class="display">Hablemos de <span class="it">tu contenido</span></h2>
        <p>Cuéntame de tu marca y armamos el plan de reels que mejor te sirva.</p>
        <div class="pg-acciones">
          <a href={waGeneral} target="_blank" rel="noopener" class="btn"><i class="fab fa-whatsapp"></i> WhatsApp · 787-243-9670</a>
          <a href="mailto:hello@marcossantiago.com" class="btn"><i class="fa-solid fa-envelope"></i> hello@marcossantiago.com</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  // Arma el mensaje de WhatsApp con lo escogido (el total lo suma el CSS con contadores)
  const f = document.querySelector<HTMLFormElement>('.calc');
  const a = document.querySelector<HTMLAnchorElement>('.calc-wa');
  if (f && a) {
    const armar = () => {
      const p = f.querySelector<HTMLInputElement>('input[name=pkg]:checked');
      const ex = [...f.querySelectorAll<HTMLInputElement>('input[name=extra]:checked')];
      if (!p) return;
      const total = ex.reduce((t, e) => t + Number(e.value), Number(p.value));
      const partes = [`${p.dataset.nombre} ($${p.value})`, ...ex.map((e) => `${e.dataset.nombre} (+$${e.value})`)];
      const txt = `Hola Marcos, me interesa: ${partes.join(' + ')}. Estimado: $${total}.`;
      a.href = `https://wa.me/17872439670?text=${encodeURIComponent(txt)}`;
    };
    f.addEventListener('change', armar);
    f.addEventListener('submit', (e) => e.preventDefault());
    armar();
  }
</script>

<style>
  .pg-hero .pg-titulo { font-size: clamp(5rem, 19vw, 17rem) }

  /* Calculadora */
  .arma { padding-bottom: clamp(72px, 10vw, 140px); scroll-margin-top: 80px }
  .calc { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(20px, 3vw, 40px); counter-reset: total }
  .calc fieldset { border: 0; min-width: 0 }
  .calc legend { color: var(--flame); margin-bottom: 16px }
  .calc input { position: absolute; opacity: 0; pointer-events: none }
  .calc input:checked { counter-increment: total var(--v) }

  .pkgs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; align-content: start }
  .pkgs legend { grid-column: 1 / -1 }
  .pkg { position: relative; cursor: pointer }
  .pkg-cuerpo {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 24px 20px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface);
    transition: border-color .2s, background .25s, translate .25s var(--ease);
  }
  .pkg:hover .pkg-cuerpo { border-color: var(--border-h) }
  .pkg input:checked + .pkg-cuerpo { border-color: var(--flame); background: linear-gradient(160deg, #2a1a12, var(--surface) 60%); translate: 0 -4px }
  .pkg input:focus-visible + .pkg-cuerpo { outline: 2px solid var(--white); outline-offset: 3px }
  .pkg-badge { align-self: flex-start; padding: 3px 10px; border-radius: 99px; background: var(--flame); color: var(--ink); font-size: var(--text-2xs); font-weight: 700; letter-spacing: .06em; text-transform: uppercase }
  .pkg-name { font-weight: 700; font-size: 1.05rem }
  .pkg-price { font-family: var(--display); font-weight: 800; font-size: clamp(3rem, 5vw, 4.4rem); line-height: .9 }
  .sig { font-size: .45em; vertical-align: top; color: var(--flame); margin-right: 3px }
  .pkg-unit { color: var(--dim); font-size: var(--text-sm); margin-bottom: 8px }
  .pkg-features { display: grid; gap: 7px; color: var(--muted); font-size: var(--text-sm); line-height: 1.4 }
  .pkg-features span { padding-left: 18px; position: relative }
  .pkg-features span::before { content: '✓'; position: absolute; left: 0; color: var(--flame); font-weight: 800 }

  .calc-lado { display: grid; gap: 16px; align-content: start }
  .extras { display: grid; gap: 0 }
  .extra { position: relative; display: flex; align-items: center; gap: 12px; padding: 14px 4px; border-top: 1px solid var(--border); cursor: pointer }
  .extra:last-of-type { border-bottom: 1px solid var(--border) }
  .extra-caja { width: 22px; height: 22px; flex: none; border: 1.5px solid var(--border-h); border-radius: 7px; display: grid; place-items: center; transition: background .2s, border-color .2s }
  .extra input:checked + .extra-caja { background: var(--flame); border-color: var(--flame) }
  .extra input:checked + .extra-caja::after { content: '✓'; color: var(--ink); font-weight: 800; font-size: .8rem }
  .extra input:focus-visible + .extra-caja { outline: 2px solid var(--white); outline-offset: 2px }
  .extra-label { flex: 1 }
  .extra-precio { color: var(--flame); font-weight: 700 }
  .extra-fijo { cursor: default; color: var(--dim); padding-left: 38px }
  .extra-fijo .extra-precio { color: var(--muted); font-weight: 600 }

  .calc-total { position: sticky; top: 90px; padding: 26px; border-radius: 22px; background: var(--flame); color: var(--ink) }
  .calc-total .label { color: var(--ink) }
  .total { font-family: var(--display); font-weight: 800; font-size: clamp(4.4rem, 8vw, 6.8rem); line-height: .9; margin: 6px 0 10px }
  .total .sig { color: var(--ink) }
  .total-n::after { content: counter(total) }
  .calc-nota { font-size: var(--text-sm); margin-bottom: 16px }
  .calc-total .btn { width: 100%; background: var(--ink); color: var(--white); border-color: var(--ink) }
  .calc-total .btn:hover { background: var(--white); color: var(--ink) }
  .calc-total .btn i { color: #25d366 }

  @media (max-width: 1000px) {
    .calc { grid-template-columns: 1fr }
    .calc-total { position: static }
  }
  @media (max-width: 700px) {
    .pkgs { grid-template-columns: 1fr }
  }

  /* Planes */
  .planes-sub { color: rgba(20, 18, 15, .72); font-size: var(--text-lg); margin: -10px 0 32px; max-width: 52ch }
  .plan-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 }
  .plan { display: flex; flex-direction: column; gap: 14px; padding: 30px 30px 30px 0; border-top: 2px solid var(--on-paper) }
  .plan + .plan { padding-left: 30px; border-left: 1px solid rgba(20, 18, 15, .2) }
  .plan-name { font-size: var(--text-xs); font-weight: 700; letter-spacing: .09em; text-transform: uppercase }
  .plan-price .pg-num { font-size: clamp(4.4rem, 9vw, 7.6rem) }
  .plan-per { font-weight: 600; margin-left: 6px; color: rgba(20, 18, 15, .7) }
  .plan ul { list-style: none; display: grid; gap: 8px; color: rgba(20, 18, 15, .78); flex: 1 }
  .plan li { padding-left: 20px; position: relative }
  .plan li::before { content: '✓'; position: absolute; left: 0; color: #d93a10; font-weight: 800 }
  .plan .btn { align-self: flex-start }
  @media (max-width: 760px) {
    .plan-grid { grid-template-columns: 1fr }
    .plan + .plan { padding-left: 0; border-left: 0 }
  }

  /* Condiciones */
  .condiciones ul { list-style: none; display: grid; max-width: 820px }
  .condiciones li { padding: 16px 0 16px 34px; border-top: 1px solid var(--border); color: var(--muted); position: relative; line-height: 1.6 }
  .condiciones li:last-child { border-bottom: 1px solid var(--border) }
  .condiciones li::before { content: ''; position: absolute; left: 4px; top: 25px; width: 9px; height: 9px; border-radius: 50%; background: var(--flame) }
</style>
