---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { TEL, TEL_TXT, EMAIL, wa } from '../data/site';
const opciones = ['Diseño gráfico o logo','Fotografía','Video','360 Video Booth','Web o plataforma','Otra cosa'];
---
<Base title="Contacto — Marcos Santiago" description="Escríbele a Marcos Santiago para cotizar diseño, fotografía, video o web en Puerto Rico. WhatsApp, teléfono, correo o formulario.">
  <Nav />
  <main id="main" class="pg on-paper">
    <div class="full gr">
      <div>
        <h1 class="ti">Hablemos</h1>
        <p class="sub">Hablas directo conmigo. Por WhatsApp suele ser lo más rápido.</p>
        <ul class="ch">
          <li><a href={wa()} target="_blank" rel="noopener" data-track="contacto-whatsapp"><span>WhatsApp</span><strong>{TEL_TXT}</strong></a></li>
          <li><a href={`tel:${TEL}`} data-track="contacto-tel"><span>Teléfono</span><strong>{TEL_TXT}</strong></a></li>
          <li><a href={`mailto:${EMAIL}`} data-track="contacto-email"><span>Correo</span><strong>{EMAIL}</strong></a></li>
          <li class="nl"><span>Base</span><strong>Aibonito · toda Puerto Rico</strong></li>
        </ul>
      </div>
      <form id="f" class="fo" novalidate>
        <h2>Cuéntame del proyecto</h2>
        <label>Tu nombre<input name="nombre" required autocomplete="name" /></label>
        <label>WhatsApp, teléfono o correo<input name="contacto" required autocomplete="email" /></label>
        <label>¿Qué necesitas?
          <select name="servicio">{opciones.map(o => <option>{o}</option>)}</select>
        </label>
        <label>Fecha, si la tienes<input name="fecha" placeholder="Por ejemplo, 15 de marzo" /></label>
        <label>Mensaje<textarea name="mensaje" rows="4"></textarea></label>
        <input class="hp" name="sitio" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="btn primary" type="submit">Enviar</button>
        <p class="st" role="status" aria-live="polite"></p>
      </form>
    </div>
  </main>
  <Footer />
</Base>
<script is:inline define:vars={{ waBase: 'https://wa.me/17872439670' }}>
  (function () {
    var f = document.getElementById('f'), st = f.querySelector('.st'), bt = f.querySelector('button');
    var q = new URLSearchParams(location.search).get('servicio');
    if (q) { var s = f.servicio; for (var i = 0; i < s.options.length; i++) if (s.options[i].text === q) s.selectedIndex = i; }
    f.addEventListener('submit', async function (e) {
      e.preventDefault();
      var d = Object.fromEntries(new FormData(f));
      if (!d.nombre.trim() || !d.contacto.trim()) { st.className = 'st mal'; st.textContent = 'Necesito tu nombre y cómo contactarte.'; return; }
      if (d.sitio) return;
      bt.disabled = true; st.className = 'st'; st.textContent = 'Enviando…';
      try {
        var r = await fetch('/ms-chat/lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d) });
        if (!r.ok) throw 0;
        if (typeof gtag === 'function') gtag('event', 'form_submit', { event_category: 'engagement', event_label: 'contacto' });
        f.reset(); st.className = 'st ok'; st.textContent = '¡Recibido! Te escribo pronto.';
      } catch (_) {
        // Nunca se pierde un lead en silencio: si falla el envío, se ofrece WhatsApp con el mensaje listo.
        var t = 'Hola Marcos, soy ' + d.nombre + '. Me interesa: ' + d.servicio + '. ' + (d.fecha ? 'Fecha: ' + d.fecha + '. ' : '') + d.mensaje;
        st.className = 'st mal'; st.textContent = 'No se pudo enviar. ';
        var a = document.createElement('a'); a.href = waBase + '?text=' + encodeURIComponent(t); a.target = '_blank'; a.rel = 'noopener'; a.textContent = 'Envíalo por WhatsApp con un toque →';
        st.appendChild(a);
      }
      bt.disabled = false;
    });
  })();
</script>
<style>
  .pg { padding-block: 120px var(--sec); min-height: 100svh }
  .gr { display: grid; grid-template-columns: minmax(0,1.15fr) minmax(0,1fr); gap: 40px clamp(32px, 6vw, 112px); align-items: start }
  .ti { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(4.25rem, 11.5vw, 12.5rem); line-height: .84 }
  .sub { font-size: var(--text-lg); margin-block: 20px 28px; color: var(--muted) }
  .ch { list-style: none; border-top: 1px solid var(--border) }
  .ch a, .nl { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 20px; padding-block: 15px; border-bottom: 1px solid var(--border) }
  .ch a { transition: padding .3s var(--ease), color .2s } .ch a:hover { padding-left: 10px; color: #c93208 }
  .ch span { color: var(--muted) } .ch strong { font-weight: 600 }
  .fo { display: grid; gap: 14px; background: #fff; padding: clamp(20px, 3vw, 40px); border-radius: var(--radius) }
  .fo h2 { font-size: 1.5rem; font-weight: 600; letter-spacing: -.015em }
  .fo label { display: grid; gap: 6px; font-weight: 600; font-size: .9375rem }
  .fo input, .fo select, .fo textarea { font: inherit; font-weight: 400; font-size: 1rem; width: 100%; min-height: 48px; padding: 10px 12px; border: 1px solid rgba(20,18,15,.3); border-radius: var(--radius); background: #fff; color: #14120f }
  .fo input:focus, .fo select:focus, .fo textarea:focus { outline: 2px solid var(--flame); outline-offset: 0; border-color: transparent }
  .fo .btn { justify-self: start }
  .fo .btn:disabled { opacity: .5 }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; min-height: 0 !important }
  .st { font-weight: 600; min-height: 1.5em } .st.ok { color: #0a7a3d } .st.mal { color: #b3260a } .st a { text-decoration: underline }
  @media (max-width: 860px) { .gr { grid-template-columns: 1fr } }
</style>
