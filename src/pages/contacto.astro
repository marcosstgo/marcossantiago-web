---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { TEL, TEL_TXT, EMAIL, wa } from '../data/site';
const opciones = [
  ['logo', 'un logo'], ['fotos', 'fotos'], ['video', 'un video'],
  ['booth', 'el 360 Booth'], ['web', 'una web'], ['otra', 'otra cosa'],
];
const icono = 'M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.27.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35zM12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88zM20.46 3.49A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.31-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.16-3.49-8.41z';
---
<Base title="Contacto — Marcos Santiago" description="Escríbele a Marcos Santiago por WhatsApp para cotizar diseño, fotografía, video o web en todo Puerto Rico. También por teléfono y correo.">
  <Fragment slot="head">
    <link rel="preload" href="/fonts/instrument-serif-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/instrument-serif.css" />
  </Fragment>
  <Nav />
  <main id="main" class="on-paper wa-p">
    <div class="full">
      <h1 class="ti">Hablemos</h1>
      <form id="w" class="gr" action={wa()} target="_blank">
        <div class="fr">
          <span>Hola Marcos, soy </span>
          <input name="nombre" aria-label="Tu nombre" placeholder="tu nombre" autocomplete="given-name" size="10" />
          <span>. Necesito </span>
          <fieldset class="ch">
            <legend class="vh">Qué necesitas</legend>
            {opciones.map(([k, t]) => <label><input type="radio" name="que" value={t} data-k={k} /><b>{t}</b></label>)}
          </fieldset>
          <span> para </span>
          <input name="para" aria-label="Para qué es" placeholder="mi negocio, mi boda…" size="21" />
          <span>. La fecha sería </span>
          <input name="fecha" aria-label="Fecha" placeholder="cuándo" size="7" />
          <span>.</span>
        </div>
        <aside class="ph">
          <div class="ph-top">
            <img src="/marcos-photo-280.webp" width="40" height="40" alt="" decoding="async" />
            <p><strong>Marcos Santiago</strong><small>(787) 243-9670</small></p>
          </div>
          <div class="ph-chat">
            <p class="bu" id="bu"><span id="tx" aria-live="polite">Hola Marcos…</span><small><span id="hr"></span> <i id="ck" aria-hidden="true">✓✓</i></small></p>
          </div>
          <button class="env" type="submit">
            <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="currentColor" d={icono} /></svg>
            Enviar por WhatsApp
          </button>
          <p class="st" id="st" role="status"></p>
        </aside>
      </form>
      <ul class="ot">
        <li><span>¿Prefieres llamar?</span><a href={`tel:${TEL}`} data-track="contacto-tel">{TEL_TXT}</a></li>
        <li><span>Correo</span><a href={`mailto:${EMAIL}`} data-track="contacto-email">{EMAIL}</a></li>
        <li><span>Base</span><strong>Aibonito · todo Puerto Rico</strong></li>
      </ul>
    </div>
  </main>
  <Footer />
</Base>
<script is:inline>
  (function () {
    var f = document.getElementById('w'), tx = document.getElementById('tx'), ck = document.getElementById('ck'), st = document.getElementById('st');
    function msg() {
      var n = f.nombre.value.trim(), q = (f.que.value || '').trim(), p = f.para.value.trim(), d = f.fecha.value.trim();
      var t = 'Hola Marcos' + (n ? ', soy ' + n : '') + '.';
      if (q || p) t += ' Necesito ' + (q || 'ayuda') + (p ? ' para ' + p : '') + '.';
      if (d) t += ' La fecha sería ' + d + '.';
      return t;
    }
    function pinta() {
      tx.textContent = msg();
      ck.classList.remove('leido');
      f.querySelectorAll('.fr > input').forEach(function (i) { i.size = Math.max(i.value.length, i.placeholder.length) + 1 });
    }
    var q = new URLSearchParams(location.search).get('servicio');
    if (q) { var r = f.querySelector('[data-k="' + q + '"]'); if (r) r.checked = true; }
    var h = new Date(); document.getElementById('hr').textContent = h.toLocaleTimeString('es-PR', { hour: 'numeric', minute: '2-digit' });
    f.addEventListener('input', pinta); pinta();
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      window.open('https://wa.me/17872439670?text=' + encodeURIComponent(msg()), '_blank');
      ck.classList.add('leido');
      st.textContent = 'Se abrió WhatsApp: solo falta pulsar enviar.';
      if (typeof gtag === 'function') gtag('event', 'whatsapp_click', { event_category: 'contacto', event_label: 'contacto-frase', page_path: location.pathname });
    });
  })();
</script>
<style>
  .wa-p { --v: #25d366; background: var(--v); padding-block: 96px clamp(40px, 6vw, 80px); min-height: 100svh }
  .ti { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(4rem, 15vw, 16rem); line-height: .84 }
  .gr { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(300px, 1fr); gap: 32px clamp(28px, 5vw, 88px); align-items: start; margin-top: clamp(24px, 4vw, 56px) }
  .fr { font-size: clamp(2rem, 4.5vw, 4.75rem); font-weight: 500; line-height: 1.22; letter-spacing: -.025em }
  .fr > input { font: inherit; font-family: var(--serif); font-style: italic; letter-spacing: -.01em; color: inherit; background: none; border: 0; border-bottom: .05em solid currentColor; border-radius: 0; padding: 0 .08em; max-width: 100%; field-sizing: content; min-width: 2ch; transition: background .2s }
  .fr > input::placeholder { color: rgba(5,25,12,.82); opacity: 1 }
  .fr > input:focus { outline: 0; background: rgba(255,255,255,.28) }
  .ch { display: inline; border: 0 }
  .ch label { display: inline-block; cursor: pointer; margin: .08em .1em .08em 0; vertical-align: .12em }
  .ch input { position: absolute; opacity: 0 }
  .ch b { display: block; font-size: clamp(1.0625rem, 1.75vw, 1.75rem); font-weight: 600; letter-spacing: -.01em; line-height: 1; padding: .55em .85em; border: 2px solid #14120f; border-radius: 99px; transition: background .18s, color .18s, scale .25s var(--ease) }
  .ch label:hover b { background: rgba(255,255,255,.3) }
  .ch input:checked + b { background: #14120f; color: var(--v); scale: 1.04 }
  .ch input:focus-visible + b { outline: 3px solid #14120f; outline-offset: 2px }

  .ph { position: sticky; top: 88px; background: #0b141a; color: #e9edef; border-radius: 22px; padding: 10px; box-shadow: 0 28px 60px rgba(4,50,25,.35); rotate: 1.2deg; transition: rotate .4s var(--ease) }
  .ph:focus-within, .ph:hover { rotate: 0deg }
  .ph-top { display: flex; align-items: center; gap: 10px; padding: 6px 8px 12px }
  .ph-top img { border-radius: 50%; width: 40px; height: 40px; object-fit: cover }
  .ph-top p { display: grid; line-height: 1.2 } .ph-top strong { font-weight: 600 } .ph-top small { color: #8696a0; font-size: .8125rem }
  .ph-chat { min-height: 190px; padding: 18px 12px; background: #0f1d24 radial-gradient(rgba(255,255,255,.035) 1px, transparent 1.4px) 0 0 / 14px 14px; border-radius: 14px; display: flex; align-items: flex-end; justify-content: flex-end }
  .bu { position: relative; background: #005c4b; color: #e9edef; padding: 8px 10px 7px 12px; border-radius: 10px 10px 2px 10px; max-width: 94%; font-size: 1.0625rem; line-height: 1.32; overflow-wrap: anywhere }
  .bu small { display: block; text-align: right; font-size: .6875rem; color: rgba(233,237,239,.92); min-height: 1.3em; margin-top: 3px }
  .bu i { font-style: normal; letter-spacing: -.25em; margin-right: .25em; transition: color .4s } .bu i.leido { color: #53bdeb }
  .env { width: 100%; display: flex; align-items: center; justify-content: center; gap: 12px; min-height: 64px; margin-top: 10px; border-radius: 14px; background: var(--v); color: #06230f; font-size: 1.125rem; font-weight: 700; transition: background .2s, scale .2s var(--ease) }
  .env:hover { background: #f3eee5; scale: 1.015 } .env:active { scale: .98 }
  .st { font-size: .875rem; text-align: center; color: #e9edef; padding: 8px 6px 2px } .st:empty { display: none }

  .ot { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 clamp(20px, 3vw, 48px); margin-top: clamp(36px, 5vw, 72px); border-top: 2px solid #14120f }
  .ot li { display: grid; gap: 2px; padding-top: 14px }
  .ot span { font-size: .9375rem; font-weight: 500 }
  .ot a, .ot strong { font-size: clamp(1.125rem, 1.7vw, 1.5rem); font-weight: 600; letter-spacing: -.015em; overflow-wrap: anywhere }
  .ot a:hover { text-decoration: underline }
  @media (max-width: 900px) {
    .gr { grid-template-columns: 1fr } .ph { position: static; rotate: 0deg } .ph-chat { min-height: 120px }
    .ot { grid-template-columns: 1fr; gap: 12px } .ot li + li { border-top: 1px solid rgba(20,18,15,.3) }
  }
</style>
