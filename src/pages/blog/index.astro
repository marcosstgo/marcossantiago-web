---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const modules    = import.meta.glob('./*.mdx', { eager: true });
const rawModules = import.meta.glob('./*.mdx', { eager: true, query: '?raw', import: 'default' });

function readingTime(raw: string): number {
  const content = raw.replace(/^---[\s\S]*?---/, '').replace(/<[^>]+>/g, ' ');
  const words   = content.trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 220));
}

function fmtDate(d: string) {
  const [y, m, day] = d.split('-').map(Number);
  return new Date(y, m - 1, day).toLocaleDateString('es-PR', { year: 'numeric', month: 'short', day: 'numeric' });
}

const posts = Object.entries(modules)
  .map(([path, p]: [string, any]) => {
    const raw = String(rawModules[path] ?? '');
    return {
      title:   p.frontmatter.title,
      date:    p.frontmatter.date,
      tags:    p.frontmatter.tags || [],
      slug:    p.frontmatter.slug,
      desc:    p.frontmatter.desc || '',
      minRead: readingTime(raw),
    };
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const allTags  = [...new Set(posts.flatMap(p => p.tags))].sort();
---
<Base title="Blog — Marcos Santiago" description="Video, fotografía, diseño, desarrollo web y lo que me pase por la cabeza. Por Marcos Santiago desde Aibonito, Puerto Rico.">
  <Nav />
  <main id="main" class="pg">
    <header class="full cab">
      <h1 class="ti">Blog</h1>
      <p>Lo que aprendo haciendo: video, foto, diseño, web. {posts.length} artículos.</p>
    </header>
    <div class="fl full barra-pegada" role="group" aria-label="Filtrar por tema">
      <button class="on" data-t="">Todos</button>
      {allTags.map(t => <button data-t={t}>{t}</button>)}
    </div>
    <ul class="ls full">
      {posts.map(p => (
        <li data-tags={p.tags.join('|')}><a href={`/blog/${p.slug}/`}>
          <h2>{p.title}</h2>
          <p>{p.desc}</p>
          <small>{fmtDate(p.date)} · {p.minRead} min</small>
        </a></li>
      ))}
    </ul>
  </main>
  <Footer />
</Base>
<script is:inline>
  (function () {
    var bs = document.querySelectorAll('.fl button'), li = document.querySelectorAll('.ls li');
    bs.forEach(function (b) { b.addEventListener('click', function () {
      bs.forEach(function (x) { x.classList.toggle('on', x === b) });
      li.forEach(function (l) { l.hidden = !!b.dataset.t && l.dataset.tags.split('|').indexOf(b.dataset.t) < 0 });
    }) });
  })();
</script>
<style>
  .pg { padding-top: 120px; padding-bottom: var(--sec) }
  .cab { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 48px; padding-bottom: 20px }
  .ti { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(5rem, 19vw, 20rem); line-height: .82 }
  .cab p { max-width: 36ch; font-size: var(--text-lg); color: var(--muted) }
  .fl { display: flex; gap: 4px; overflow-x: auto; padding-block: 12px; background: var(--ink); scrollbar-width: none }
  .fl button { flex: none; padding: 8px 15px; border-radius: 99px; font-weight: 600; font-size: .9375rem; border: 1px solid transparent; transition: border-color .2s, background .2s, color .2s }
  .fl button:hover { border-color: var(--border-h) } .fl button.on { background: var(--flame); color: #0d0c0b }
  .ls { list-style: none }
  .ls a { display: grid; grid-template-columns: minmax(0,1.15fr) minmax(0,1fr) auto; gap: 6px 36px; align-items: baseline; padding-block: 20px; border-top: 1px solid var(--border) }
  .ls h2 { font-size: clamp(1.25rem, 2vw, 1.75rem); font-weight: 600; line-height: 1.18; letter-spacing: -.018em; transition: color .2s }
  .ls a:hover h2 { color: var(--flame) }
  .ls p { color: var(--muted); font-size: .9688rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden }
  .ls small { color: var(--dim); font-size: .875rem; white-space: nowrap }
  @media (max-width: 800px) { .ls a { grid-template-columns: 1fr } }
</style>
