---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const modules    = import.meta.glob('./*.mdx', { eager: true });
const rawModules = import.meta.glob('./*.mdx', { eager: true, query: '?raw', import: 'default' });

function readingTime(raw: string): number {
  const content = raw.replace(/^---[\s\S]*?---/, '').replace(/<[^>]+>/g, ' ');
  const words   = content.trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 220));
}

function fmtDate(d: string) {
  const [y, m, day] = d.split('-').map(Number);
  return new Date(y, m - 1, day).toLocaleDateString('es-PR', { year: 'numeric', month: 'short', day: 'numeric' });
}

const posts = Object.entries(modules)
  .map(([path, p]: [string, any]) => {
    const raw = String(rawModules[path] ?? '');
    return {
      title:   p.frontmatter.title,
      date:    p.frontmatter.date,
      tags:    p.frontmatter.tags || [],
      slug:    p.frontmatter.slug,
      desc:    p.frontmatter.desc || '',
      minRead: readingTime(raw),
    };
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Los temas se dicen por tamaño: lo que más hay, más grande.
const cuenta = (t: string) => posts.filter(p => p.tags.includes(t)).length;
const allTags = [...new Set(posts.flatMap(p => p.tags))]
  .map(t => ({ t, n: cuenta(t) }))
  .sort((a, b) => b.n - a.n || a.t.localeCompare(b.t, 'es'));
const tam = (n: number) => (n >= 6 ? 'g' : n >= 2 ? 'm' : 's');
---
<Base title="Blog — Marcos Santiago" description="Video, fotografía, diseño, desarrollo web y lo que me pase por la cabeza. Por Marcos Santiago desde Aibonito, Puerto Rico.">
  <Nav />
  <main id="main" class="pg">
    <header class="full cab">
      <h1 class="ti">Blog</h1>
      <div class="cab-d">
        <p>Lo que aprendo haciendo: video, foto, diseño, web.</p>
        <label class="bs"><span class="vh">Buscar artículos</span><input id="bs" type="search" placeholder={`Busca entre ${posts.length} artículos`} autocomplete="off" /></label>
      </div>
    </header>
    <div class="fl full" role="group" aria-label="Filtrar por tema">
      <button class="g" aria-pressed="true" data-t="">Todos<sup>{posts.length}</sup></button>
      {allTags.map(({ t, n }) => <button class={tam(n)} aria-pressed="false" data-t={t}>{t}<sup>{n}</sup></button>)}
      <button class="mas" type="button" aria-expanded="false" id="mas">+ {allTags.filter(x => x.n < 2).length} temas más</button>
    </div>
    <p class="cu full" id="cu" role="status">{posts.length} artículos</p>
    <ul class="ls full">
      {posts.map(p => (
        <li data-tags={p.tags.join('|')} data-q={(p.title + ' ' + p.desc).toLowerCase()}><a href={`/blog/${p.slug}/`}>
          <h2>{p.title}</h2>
          <p>{p.desc}</p>
          <small>{fmtDate(p.date)} · {p.minRead} min</small>
        </a></li>
      ))}
    </ul>
    <p class="vc full" id="vc" hidden>Nada con esa búsqueda. <a class="link-a" href="/contacto/">Cuéntame qué buscas →</a></p>
  </main>
  <Footer />
</Base>
<script is:inline>
  (function () {
    var bs = document.querySelectorAll('.fl button[data-t]'), li = document.querySelectorAll('.ls li'), inp = document.getElementById('bs'), vc = document.getElementById('vc'), tag = '';
    var nor = function (t) { return t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '') };
    var cu = document.getElementById('cu');
    function ap() { var q = nor(inp.value.trim()), n = 0, por = {}, tot = 0;
      li.forEach(function (l) {
        var tags = l.dataset.tags.split('|'), coincide = nor(l.dataset.q).indexOf(q) >= 0;
        if (coincide) { tot++; tags.forEach(function (x) { por[x] = (por[x] || 0) + 1 }) }
        var ok = coincide && (!tag || tags.indexOf(tag) >= 0); l.hidden = !ok; if (ok) n++;
      });
      bs.forEach(function (b) {
        var c = b.dataset.t ? (por[b.dataset.t] || 0) : tot;
        b.querySelector('sup').textContent = c; b.classList.toggle('vacio', !c && b.dataset.t !== tag);
      });
      cu.textContent = n === 1 ? '1 artículo' : n + ' artículos';
      vc.hidden = n > 0; }
    var mas = document.getElementById('mas');
    mas.addEventListener('click', function () { mas.parentNode.classList.add('todos'); mas.setAttribute('aria-expanded', 'true') });
    bs.forEach(function (b) { b.addEventListener('click', function () {
      bs.forEach(function (x) { x.setAttribute('aria-pressed', x === b) }); tag = b.dataset.t; ap();
    }) });
    inp.addEventListener('input', ap);
  })();
</script>
<style>
  .pg { padding-top: 120px; padding-bottom: var(--sec) }
  .cab { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 48px; padding-bottom: 20px }
  .ti { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(5rem, 19vw, 20rem); line-height: .82 }
  .cab p { max-width: 36ch; font-size: var(--text-lg); color: var(--muted) }
  .cab-d { display: grid; gap: 12px; flex: 0 1 380px }
  .bs input { width: 100%; min-height: 50px; padding: 8px 20px; border-radius: 99px; border: 1px solid var(--border-h); background: transparent; color: inherit; font: inherit }
  .bs input:focus { outline: 2px solid var(--flame); outline-offset: 1px }
  .vc { padding-block: 40px; font-size: var(--text-lg) }
  .fl { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 clamp(14px, 1.6vw, 26px); padding-block: 18px 6px; border-top: 2px solid var(--border-h) }
  .fl button { position: relative; min-height: 44px; padding: 0 2px; line-height: 1.05; color: var(--muted); transition: color .2s, translate .25s var(--ease), opacity .2s }
  .fl .g { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(2.25rem, 4.6vw, 4.75rem); letter-spacing: -.005em }
  .fl .m { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(1.5rem, 2.5vw, 2.5rem) }
  .fl .s { font-family: var(--serif); font-style: italic; font-size: clamp(1.375rem, 2vw, 2rem) }
  .fl sup { font-family: var(--body); font-style: normal; font-weight: 600; font-size: .8125rem; letter-spacing: 0; text-transform: none; vertical-align: super; line-height: 0; margin-left: .25em }
  .fl button:hover { color: var(--white); translate: 0 -2px }
  .fl button[aria-pressed='true'] { color: var(--flame) }
  .fl button.vacio { opacity: .28 }
  .fl .mas { display: none; font-size: .9375rem; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; color: var(--white) }
  @media (max-width: 700px) {
    .fl .g { font-size: 1.875rem } .fl .m { font-size: 1.375rem } .fl .s { font-size: 1.25rem }
    .fl:not(.todos) .s { display: none }
    .fl:not(.todos) .mas { display: block }
  }
  .cu { padding-block: 8px 18px; color: var(--dim); font-size: .9375rem }
  .ls { list-style: none }
  .ls a { display: grid; grid-template-columns: minmax(0,1.15fr) minmax(0,1fr) auto; gap: 6px 36px; align-items: baseline; padding-block: 20px; border-top: 1px solid var(--border) }
  .ls h2 { font-size: clamp(1.25rem, 2vw, 1.75rem); font-weight: 600; line-height: 1.18; letter-spacing: -.018em; transition: color .2s }
  .ls a:hover h2 { color: var(--flame) }
  .ls p { color: var(--muted); font-size: .9688rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden }
  .ls small { color: var(--dim); font-size: .875rem; white-space: nowrap }
  @media (max-width: 800px) { .ls a { grid-template-columns: 1fr } }
</style>
