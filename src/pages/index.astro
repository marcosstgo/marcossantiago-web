---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WorkCard from '../components/WorkCard.astro';
import VideoDialog from '../components/VideoDialog.astro';
import LogoWall from '../components/LogoWall.astro';
import CtaBand from '../components/CtaBand.astro';
import { video, brand, logos, videos } from '../lib/media';
import heroImg from '../assets/hero/hero.jpg';

const posts = Object.values(import.meta.glob('./blog/*.mdx', { eager: true }) as Record<string, any>)
  .map(p => p.frontmatter)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

const web = [
  { n: 'Concilia', d: 'Pagos de ATH Móvil aplicados solos en MikroWisp', h: '/portafolio/dev/concilia/' },
  { n: 'Corillo', d: 'Streaming en vivo para Puerto Rico', h: 'https://corillo.live' },
  { n: 'FacturaPR', d: 'Facturación por voz o texto', h: 'https://facturapr.com' },
  { n: 'Kioskko', d: 'Tiendas en línea con Stripe y ATH Móvil', h: 'https://kioskko.com' },
];
const areas = [
  { t: 'Diseño gráfico', d: 'Logos, identidad de marca, material impreso y digital.', h: '/portafolio/diseno/', s: '/servicios/#diseno', b: brand('el-chustruck') },
  { t: 'Fotografía', d: 'Bodas, quinceañeros, eventos, retratos y marcas.', h: '/portafolio/foto/', s: '/servicios/#fotografia', v: video('1075437696') },
  { t: 'Video', d: 'Música, eventos, institucional, documental y reels.', h: '/portafolio/video/', s: '/servicios/#videografia', v: video('676644299') },
  { t: 'Web', d: 'Sitios, tiendas y plataformas que la gente usa de verdad.', h: '/portafolio/dev/', s: '/servicios/#desarrollo', u: '/portfolio-cases/concilia/home-hero.webp' },
];
---
<Base
  title="Marcos Santiago — Diseño Gráfico, Fotografía y Video en Puerto Rico"
  description="Artista gráfico, fotógrafo y videógrafo en Aibonito, Puerto Rico. Logos e identidad de marca, bodas, eventos, video y desarrollo web para toda la isla."
>
  <Nav />
  <main id="main">
    <section class="h" data-hero>
      <div class="h-media">
        <Picture class="h-poster" src={heroImg} formats={['avif','webp']} widths={[640,1280]} sizes="100vw" alt="" loading="eager" fetchpriority="high" />
        <video class="h-video" muted loop playsinline preload="none" aria-hidden="true" data-src="/hero-bg.mp4" data-src-m="/hero-bg-480.mp4"></video>
        <div class="h-grano" aria-hidden="true"></div>
      </div>
      <h1 class="h-t">
        <span class="h-desc">Diseño gráfico, fotografía y video <em class="it">desde Aibonito, Puerto Rico</em></span>
        <span class="h-nombre"><span>Marcos</span> <span>Santiago</span></span>
      </h1>
    </section>

    <section class="yo full">
      <p class="yo-t reveal">Diseño tu marca, la fotografío, la pongo en video y la llevo a la web. <em class="it">Una sola mirada, de principio a fin.</em></p>
      <div class="yo-a reveal">
        <a class="btn primary" href="/portafolio/">Ver el trabajo</a>
        <a class="btn" href="/servicios/">Servicios y precios</a>
      </div>
    </section>

    <section class="ja" aria-labelledby="ja-t">
      <input type="radio" name="ja" id="ja-p" class="vh" checked aria-label="Fondo papel" />
      <input type="radio" name="ja" id="ja-n" class="vh" aria-label="Fondo negro" />
      <input type="radio" name="ja" id="ja-a" class="vh" aria-label="Fondo azul" />
      <input type="radio" name="ja" id="ja-f" class="vh" aria-label="Fondo naranja" />
      <div class="ja-l"><img class="reveal" src="/logos-portfolio/jalda.svg" width="379" height="242" alt="Logo de Jalda, Premium Cream Liqueur" loading="lazy" decoding="async" /></div>
      <div class="ja-b full">
        <h2 id="ja-t" class="ja-t">Jalda <span>Identidad · Premium Cream Liqueur</span></h2>
        <div class="ja-s" aria-hidden="true">
          <label for="ja-p" class="p"></label><label for="ja-n" class="n"></label><label for="ja-a" class="a"></label><label for="ja-f" class="f"></label>
        </div>
        <a class="link-a" href="https://www.behance.net/gallery/153299389/Jalda-Cream-Liqueur" target="_blank" rel="noopener">Ver el proyecto →</a>
      </div>
    </section>

    <section class="sel full" aria-labelledby="sel-t">
      <div class="sec-top">
        <h2 id="sel-t" class="sec-h">Trabajo destacado</h2>
        <a class="link-a" href="/portafolio/video/">{videos.length} videos en el portafolio →</a>
      </div>
      <div class="sel-g">
        <WorkCard class="reveal a" v={video('1153022005')} sizes="(max-width:700px) 100vw, 66vw" />
        <WorkCard class="reveal b" v={video('944305796')} sizes="(max-width:700px) 100vw, 33vw" />
        <WorkCard class="reveal c" b={brand('tropical-paws')} sizes="(max-width:700px) 100vw, 40vw" />
        <WorkCard class="reveal d" v={video('1214473531')} sizes="(max-width:700px) 100vw, 60vw" />
        <WorkCard class="reveal e" v={video('1084774680')} sizes="(max-width:700px) 100vw, 60vw" />
        <WorkCard class="reveal f" b={brand('jalda')} sizes="(max-width:700px) 100vw, 40vw" />
      </div>
    </section>

    <section class="on-paper lg-s" aria-labelledby="lg-t">
      <div class="lg-head full">
        <h2 id="lg-t" class="sec-h">{logos.length} logos.<br /><em class="it">Prueba el fondo.</em></h2>
        <p>Un buen logo funciona sobre cualquier superficie. Cambia el fondo o abre uno para verlo en todos a la vez.</p>
      </div>
      <div class="lg-auto"><LogoWall limite={12} auto /></div>
      <div class="lg-pie full"><a class="btn" href="/portafolio/logos/">Ver todos los logos →</a></div>
    </section>

    <section class="ar full" aria-labelledby="ar-t">
      <h2 id="ar-t" class="sec-h">Lo que hago</h2>
      <ul class="ar-l">
        {areas.map(a => (
          <li class="ar-i reveal">
            <a class="ar-n" href={a.h}>{a.t}</a>
            <div class="ar-d"><p>{a.d}</p><p class="ar-ln"><a href={a.h}>Ver trabajo</a><a href={a.s}>Precios</a></p></div>
            <a class="ar-img" href={a.h} tabindex="-1" aria-hidden="true">
              {a.u
                ? <img src={a.u} alt="" width="800" height="450" loading="lazy" decoding="async" />
                : <Picture src={(a.v ?? a.b)!.img} formats={['avif','webp']} widths={[480,800]} sizes="(max-width:800px) 100vw, 28vw" alt="" loading="lazy" decoding="async" />}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="bo full reveal">
      <div class="bo-m">
        <video class="bo-v" muted loop playsinline preload="none" aria-hidden="true" data-lazy="/booth-360/360-Recap.mp4"></video>
      </div>
      <div class="bo-t">
        <h2 class="sec-h">360 Video Booth</h2>
        <p>La plataforma giratoria que pone a tus invitados a grabarse y les entrega el clip al instante por QR. Para bodas, quinceañeros y marcas.</p>
        <a class="btn primary" href="/360-booth-pr/">Conocer el booth →</a>
      </div>
    </section>

    <section class="we full" aria-labelledby="we-t">
      <div class="sec-top">
        <h2 id="we-t" class="sec-h">También programo</h2>
        <a class="link-a" href="/portafolio/dev/">Todos los proyectos →</a>
      </div>
      <ul class="we-l">
        {web.map(w => (
          <li><a href={w.h} target={w.h.startsWith('http') ? '_blank' : undefined} rel={w.h.startsWith('http') ? 'noopener' : undefined}>
            <span class="we-n">{w.n}</span><span class="we-d">{w.d}</span><span aria-hidden="true" class="we-f">↗</span>
          </a></li>
        ))}
      </ul>
    </section>

    <section class="ms full">
      <img class="ms-f reveal" src="/marcos-photo.webp" width="1080" height="1080" alt="Marcos Santiago, artista gráfico y fotógrafo en Aibonito, Puerto Rico" loading="lazy" decoding="async" />
      <div class="ms-t reveal">
        <p class="ms-c">Empecé programando en 2001. En 2012 una Sony NEX-3 me enseñó a mirar. Hoy trabajo con negocios, municipios y organizaciones de toda la isla, y contigo trato yo directamente.</p>
        <a class="link-a" href="/sobre-mi/">Mi historia →</a>
      </div>
    </section>

    <section class="bl full" aria-labelledby="bl-t">
      <div class="sec-top">
        <h2 id="bl-t" class="sec-h">Del blog</h2>
        <a class="link-a" href="/blog/">Todos los artículos →</a>
      </div>
      <ul class="bl-l">
        {posts.map(p => <li><a href={`/blog/${p.slug}/`}><span>{p.title}</span><small>{p.desc}</small></a></li>)}
      </ul>
    </section>

    <CtaBand />
  </main>
  <Footer />
  <VideoDialog />
</Base>

<script is:inline>
  (function () {
    var c = navigator.connection, ligero = (c && c.saveData) || matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (ligero) return;
    // Video del hero: entra cuando la página ya pintó, sin afectar el LCP.
    var v = document.querySelector('.h-video');
    function arranca() {
      v.src = innerWidth < 760 ? v.dataset.srcM : v.dataset.src;
      v.addEventListener('playing', function () { v.classList.add('on') }, { once: true });
      v.play().catch(function () {});
    }
    addEventListener('load', function () { (window.requestIdleCallback || setTimeout)(arranca, { timeout: 1500 }) }, { once: true });
    // Video del booth: solo al acercarse.
    var b = document.querySelector('.bo-v');
    new IntersectionObserver(function (e, o) {
      if (e[0].isIntersecting) { b.src = b.dataset.lazy; b.play().catch(function () {}); o.disconnect() }
    }, { rootMargin: '300px' }).observe(b);
  })();
</script>

<style>
  .h { position: relative; height: 100svh; min-height: 560px; display: flex; align-items: flex-end; overflow: clip; background: #06121f }
  .h-media { position: absolute; inset: 0; isolation: isolate }
  .h-media::after { content:''; position: absolute; inset: 0; z-index: 2; background: linear-gradient(180deg, rgba(13,12,11,.34) 0, rgba(13,12,11,0) 22%, rgba(13,12,11,0) 48%, rgba(13,12,11,.82) 100%) }
  .h-poster, .h-video { position: absolute; inset: 0; width: 100%; height: 100% }
  .h-poster { object-fit: cover }
  /* Grano de película: disimula bloques y franjas de la compresión. Un mosaico de 12 KB,
     movido por el compositor (sin mix-blend ni repintado), así no pesa sobre el video. */
  .h-media { overflow: clip }
  .h-grano { position: absolute; inset: -160px; z-index: 1; background: url(/grano.webp) 0 0 / 160px; pointer-events: none; will-change: translate; animation: h-grano .7s steps(1) infinite }
  @keyframes h-grano { 0% { translate: 0 0 } 20% { translate: -47px 31px } 40% { translate: 62px -58px } 60% { translate: -83px -24px } 80% { translate: 29px 76px } }
  .h-video { filter: blur(.8px) saturate(1.12) contrast(1.06); object-fit: cover; opacity: 0; transition: opacity 1s }
  .h-video:global(.on) { opacity: 1 }
  .h-t { position: relative; z-index: 3; width: 100%; padding: 0 var(--gut) clamp(14px, 2vw, 26px); font-weight: inherit }
  .h-desc { display: block; font-family: var(--body); font-size: clamp(1.0625rem, 1.8vw, 1.625rem); font-weight: 500; line-height: 1.25; margin-bottom: clamp(8px, 1.2vw, 16px); max-width: 30ch }
  .h-desc .it { display: block; font-size: 1.14em }
  .h-nombre { display: flex; flex-wrap: wrap; column-gap: .18em; font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: calc((100vw - 2 * var(--gut)) / 7.5); line-height: .84; white-space: nowrap; letter-spacing: -.012em }
  @media (max-width: 760px) { .h-nombre { font-size: calc((100vw - 2 * var(--gut)) / 4.1); white-space: normal } }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .h-media { animation: h-par linear both; --tl: scroll(root); animation-timeline: var(--tl); animation-range: 0 100vh }
      @keyframes h-par { to { translate: 0 14%; scale: 1.08 } }
    }
  }

  .sec-h { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(2.75rem, 7.2vw, 7.5rem); line-height: .94 }
  .sec-h .it { font-size: 1.04em; line-height: 1 }
  .sec-top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 32px; margin-bottom: clamp(24px, 4vw, 56px) }

  .yo { padding-block: var(--sec) }
  .yo-t { font-size: clamp(2rem, 5.1vw, 5.25rem); line-height: 1.06; font-weight: 500; letter-spacing: -.025em; max-width: 21em }
  .yo-t .it { color: var(--flame); letter-spacing: -.015em }
  .yo-a { display: flex; flex-wrap: wrap; gap: 10px; margin-top: clamp(24px, 3vw, 44px) }

  /* Jalda: el logo protagonista. Cambio de fondo con CSS puro. */
  .ja { --bg: #f3eee5; --tx: #14120f; --fl: none; background: var(--bg); color: var(--tx); transition: background-color .5s ease, color .5s ease; display: flex; flex-direction: column; min-height: min(100svh, 62vw + 120px) }
  .ja:has(#ja-n:checked) { --bg: #0c0c0e; --tx: #f3eee5; --fl: brightness(0) invert(1) }
  .ja:has(#ja-a:checked) { --bg: #1a3cff; --tx: #fff; --fl: brightness(0) invert(1) }
  .ja:has(#ja-f:checked) { --bg: #ff4f1f; --tx: #0d0c0b; --fl: none }
  .ja-l { flex: 1; display: grid; place-items: center; padding: clamp(48px, 7vw, 96px) var(--gut) 24px }
  .ja-l img { width: min(72vw, 110vh); filter: var(--fl); transition: filter .5s ease }
  .ja-b { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px 24px; padding-block: 20px }
  .ja-t { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(1.75rem, 3vw, 2.75rem); line-height: 1 }
  .ja-t span { display: block; margin-top: 4px; font-family: var(--body); font-weight: 500; text-transform: none; font-size: .9375rem }
  .ja-s { display: flex; gap: 10px }
  .ja-s label { width: 34px; height: 34px; border-radius: 50%; border: 2px solid var(--tx); cursor: pointer; transition: scale .2s var(--ease) }
  .ja-s label:hover { scale: 1.12 }
  .ja-s .p { background: #f3eee5 } .ja-s .n { background: #0c0c0e } .ja-s .a { background: #1a3cff } .ja-s .f { background: #ff4f1f }
  .ja .link-a { justify-self: end; color: inherit }
  .ja .link-a:hover { color: inherit; opacity: .7 }
  .ja:has(#ja-p:focus-visible) .ja-s .p, .ja:has(#ja-n:focus-visible) .ja-s .n, .ja:has(#ja-a:focus-visible) .ja-s .a, .ja:has(#ja-f:focus-visible) .ja-s .f { outline: 2px solid var(--tx); outline-offset: 3px }
  @media (max-width: 700px) { .ja { min-height: 0 } .ja-l img { width: 84vw } .ja-b { grid-template-columns: 1fr auto } .ja-s { grid-row: 2; grid-column: 1 / -1 } }

  .sel { padding-block: var(--sec) }
  .sel-g { display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(28px, 3.5vw, 56px) clamp(14px, 1.6vw, 24px) }
  .sel-g :global(.a) { grid-column: span 8 } .sel-g :global(.b) { grid-column: span 4 }
  .sel-g :global(.c) { grid-column: span 5 } .sel-g :global(.d) { grid-column: span 7 }
  .sel-g :global(.e) { grid-column: span 7 } .sel-g :global(.f) { grid-column: span 5 }
  .sel-g :global(.wc-img) { height: clamp(240px, 37vw, 620px) }
  @media (max-width: 700px) { .sel-g :global(.wc) { grid-column: 1 / -1 !important } .sel-g :global(.wc-img) { height: auto; aspect-ratio: 16/10 } }

  .lg-s { padding-top: var(--sec) }
  .lg-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 20px 48px; margin-bottom: clamp(18px, 3vw, 36px) }
  .lg-head p { max-width: 38ch; font-size: var(--text-lg); color: var(--muted) }
  .lg-auto :global(.lw-grid) { grid-template-columns: repeat(6, 1fr) }
  @media (max-width: 900px) { .lg-auto :global(.lw-grid) { grid-template-columns: repeat(3, 1fr) } }
  .lg-pie { padding-block: clamp(24px, 3vw, 40px) }

  .ar { padding-block: var(--sec) }
  .ar-l { list-style: none; margin-top: clamp(24px, 4vw, 56px); border-top: 1px solid var(--border) }
  .ar-i { display: grid; grid-template-columns: 1.45fr 1fr 1fr; gap: 20px 32px; align-items: center; padding-block: clamp(16px, 2vw, 28px); border-bottom: 1px solid var(--border) }
  .ar-n { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(3rem, 7.2vw, 7.5rem); line-height: .95; transition: color .2s }
  .ar-n:hover { color: var(--flame) }
  .ar-d { color: var(--muted); font-size: var(--text-lg); line-height: 1.4 }
  .ar-ln { display: flex; gap: 20px; margin-top: 10px; color: var(--white); font-weight: 600; font-size: .9375rem }
  .ar-ln a { border-bottom: 1px solid var(--border-h); padding-block: 4px 1px } .ar-ln a:hover { color: var(--flame); border-color: var(--flame) }
  .ar-img { display: block; aspect-ratio: 16/9; overflow: hidden; background: var(--surface); border-radius: var(--radius) }
  .ar-img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: scale .8s var(--ease) }
  .ar-i:hover .ar-img :global(img) { scale: 1.05 }
  .ar-img :global(picture) { display: contents }
  @media (max-width: 800px) { .ar-i { grid-template-columns: 1fr } }

  .bo { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 24px clamp(24px, 5vw, 80px); align-items: center; padding-bottom: 0 }
  .bo-m { aspect-ratio: 16/10; overflow: hidden; border-radius: var(--radius); background: var(--surface) }
  .bo-v { width: 100%; height: 100%; object-fit: cover }
  .bo-t { display: grid; gap: 16px; justify-items: start }
  .bo-t p { max-width: 44ch; font-size: var(--text-lg); color: var(--muted) }
  @media (max-width: 760px) { .bo { grid-template-columns: 1fr } }

  .we { padding-block: var(--sec) 0 }
  .we-l, .bl-l { list-style: none; border-top: 1px solid var(--border) }
  .we-l a { display: grid; grid-template-columns: minmax(0,1.1fr) minmax(0,1.6fr) auto; gap: 8px 24px; align-items: baseline; padding-block: 18px; border-bottom: 1px solid var(--border); transition: padding .3s var(--ease), color .2s }
  .we-l a:hover { padding-left: 12px; color: var(--flame) }
  .we-n { font-size: clamp(1.5rem, 2.8vw, 2.5rem); font-weight: 600; letter-spacing: -.02em }
  .we-d { color: var(--muted) }
  @media (max-width: 700px) { .we-l a { grid-template-columns: 1fr auto } .we-d { grid-row: 2; grid-column: 1 / -1 } }

  .ms { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,2fr); gap: clamp(24px, 5vw, 80px); align-items: end; padding-block: var(--sec) }
  .ms-f { width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: var(--radius) }
  .ms-c { font-size: clamp(1.625rem, 3.2vw, 3.25rem); line-height: 1.12; letter-spacing: -.02em; font-weight: 500; margin-bottom: 24px }
  @media (max-width: 700px) { .ms { grid-template-columns: 1fr } }

  .bl { padding-bottom: var(--sec) }
  .bl-l a { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 32px; padding-block: 20px; border-bottom: 1px solid var(--border); transition: color .2s }
  .bl-l a:hover span { color: var(--flame) }
  .bl-l span { font-weight: 600; font-size: 1.25rem; line-height: 1.25; letter-spacing: -.01em; transition: color .2s }
  .bl-l small { color: var(--muted); font-size: .9375rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden }
  @media (max-width: 700px) { .bl-l a { grid-template-columns: 1fr } }
</style>
