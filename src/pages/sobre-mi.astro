---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import { video, brand, logos, videos } from '../lib/media';

const anios = new Date().getFullYear() - 2001;
const articulos = Object.keys(import.meta.glob('./blog/*.mdx')).length;
const web = async (src: any) => (await getImage({ src, width: 1280, format: 'webp', quality: 74 })).src;

// Cada disparo revela algo que ha pasado frente a su lente.
const rollo = [
  { s: '/marcos-photo.webp', t: 'Marcos Santiago, Aibonito' },
  { s: await web(video('1084774680').img), t: 'IRONMAN 70.3 Puerto Rico' },
  { s: await web(video('1075437696').img), t: 'Alejandra & Luis' },
  { s: await web(video('1214473531').img), t: 'Teatro Encanto, Miguel Morales' },
  { s: await web(video('873793066').img), t: 'Reapertura de la Plaza de Aibonito' },
  { s: await web(video('676644299').img), t: 'Roy Brown, Boricua en la Luna' },
  { s: await web(brand('jalda').img), t: 'Identidad de Jalda' },
  { s: await web(video('1053857501').img), t: 'Historia de Aibonito' },
];
const oficios = [
  { k: 'diseno', t: 'Diseño', d: 'Logotipos corporativos, identidad visual, ilustración de producto y piezas para impresión y redes.', h: '/portafolio/diseno/', i: await web(brand('el-chustruck').img), n: `${logos.length} logos en el muro` },
  { k: 'foto', t: 'Fotografía', d: 'Retrato, evento, producto e institucional, con un enfoque narrativo sobre el técnico.', h: '/portafolio/foto/', i: await web(video('1052549620').img), n: 'Bodas, eventos y retratos' },
  { k: 'video', t: 'Video', d: 'Producción y postproducción de contenido audiovisual, del corporativo al social.', h: '/portafolio/video/', i: await web(video('944305796').img), n: `${videos.length} piezas en el portafolio` },
  { k: 'web', t: 'Web', d: 'Sitios, tiendas y aplicaciones que se ven bien y aguantan carga.', h: '/portafolio/dev/', i: '/portfolio-cases/concilia/home-hero.webp', n: 'Concilia, Corillo, FacturaPR' },
  { k: 'sis', t: 'Sistemas', d: 'Servidores Windows y Linux, redes, bases de datos e integración de aplicaciones. Lo que nadie ve y todo lo sostiene.', h: '/resume/', i: '/portfolio-cases/previas/corillo.webp', n: 'Infraestructura propia' },
];
const ruta = [
  { a: '1995–2000', t: 'Bachillerato en Ciencias de Computadoras', d: 'Universidad Interamericana de Puerto Rico. Concentración en Aplicaciones Comerciales.' },
  { a: '2001–2015', t: 'Programador Analista y Artista Gráfico', d: 'Universidad Interamericana. Diseñaba los materiales promocionales y mantenía las aplicaciones y los servidores.' },
  { a: '2010–2012', t: 'Maestría en Ciencias de Computadoras', d: 'Universidad Interamericana. Concentración en Comercio Electrónico.' },
  { a: '2012–Hoy', t: 'Artista multidisciplinario', d: 'Logotipos, campañas, contenido audiovisual y sitios web. Hoy también plataformas completas.' },
  { a: '2016–2024', t: 'Diseñador Gráfico y Desarrollador Web', d: 'Like Family Inc., LatinShots Inc. y FB Logistic Inc.: material promocional, aplicaciones web y redes.' },
];
const camaraImg = await web(video('1075437696').img);
const paleta = [
  ['Flamboyán', '#ff4f1f'], ['Mango', '#ffb000'], ['Caribe', '#00c2cc'],
  ['Coquí', '#4fdc6a'], ['Orquídea', '#ff6fc3'], ['Cielo', '#7fa8ff'],
];
const publicos = [
  { k: 'marca', t: 'Tienes una marca', i: ['Logos e identidad visual', 'Fotografía y video corporativo', 'Reels y contenido para redes', 'Diseño gráfico e impresos', 'Sitios web, tiendas y plataformas', 'Documentales y cobertura institucional'] },
  { k: 'evento', t: 'Tienes un evento', i: ['Bodas y quinceañeros', 'Eventos sociales', 'Retratos y headshots', 'Video de eventos', 'Galerías digitales', '360 Video Booth'] },
];
---
<Base
  title="Sobre mí — Marcos Santiago"
  description="Marcos Santiago, artista visual y desarrollador en Aibonito, Puerto Rico. Más de 20 años integrando diseño, fotografía, video y programación para negocios, municipios y organizaciones de toda la isla."
>
  <Fragment slot="head"><link rel="preload" href="/marcos-photo.webp" as="image" /></Fragment>
  <Nav />
  <main id="main">

    <!-- 1 · El visor: enfocas girando el anillo y disparas -->
    <section class="vi" id="vi">
      <h1 class="ti"><span>Aprendiendo</span> <em class="it">a ver</em></h1>
      <div class="vi-t">
        <p class="vi-s">Soy Marcos Santiago. Integro diseño, fotografía, video y programación para que negocios, municipios y organizaciones se proyecten con claridad, desde el logo hasta el sitio web.</p>
        <dl class="vi-d">
          <div><dt>Base</dt><dd>Aibonito, Puerto Rico</dd></div>
          <div><dt>Experiencia</dt><dd>Más de 20 años</dd></div>
          <div><dt>Alcance</dt><dd>Todo Puerto Rico</dd></div>
        </dl>
        <div class="vi-ct">
          <label class="an"><span>Gira el anillo para enfocar</span>
            <input id="vi-a" type="range" min="0" max="100" value="100" aria-label="Anillo de enfoque" />
          </label>
          <button id="vi-d" class="ob" type="button" aria-label="Disparar y ver otra imagen"><span>Dispara</span></button>
        </div>
      </div>
      <figure class="vi-f">
        <div class="vi-m">
          <img id="vi-i" src="/marcos-photo.webp" width="1080" height="1080" alt="Marcos Santiago apuntando su cámara, Aibonito, Puerto Rico" fetchpriority="high" />
          <div class="vi-c" aria-hidden="true"><i></i><i></i></div>
          <div class="vi-h" aria-hidden="true">
            <span class="af" id="vi-af">AF</span>
            <span class="cn"></span>
            <span class="pa"><b>f/1.8</b> <b>1/125</b> <b>ISO 800</b></span>
            <span class="nu" id="vi-n">1/{rollo.length}</span>
          </div>
        </div>
        <figcaption class="vi-pie" id="vi-p">{rollo[0].t}</figcaption>
      </figure>
    </section>

    <!-- 2 · Tres capítulos que se apilan al bajar -->
    <section class="ca" aria-label="Trayectoria">
      <article class="cp c1">
        <p class="cp-a" aria-hidden="true">2001</p>
        <div class="cp-b">
          <h2><span class="vh">2001, </span>El código primero</h2>
          <p>Mi carrera comenzó desde la tecnología: Ciencias de Computadoras y una maestría en Comercio Electrónico. Ahí aprendí a combinar estrategia, diseño y programación para convertir ideas en soluciones útiles.</p>
          <div class="cd" aria-hidden="true"><span>const marcos = &#123;</span><span>  base: 'Aibonito, PR',</span><span>  oficios: ['programador', 'artista gráfico'],</span><span>  aVeces: 'los dos el mismo día',</span><span>&#125;;</span></div>
        </div>
      </article>
      <article class="cp c2 on-paper">
        <p class="cp-a" aria-hidden="true">2012</p>
        <div class="cp-b">
          <h2><span class="vh">2012, </span>Aprender a mirar</h2>
          <p>Una Sony NEX-3 despertó mi interés por la fotografía. Lo que comenzó los fines de semana creció con cada proyecto y terminó abriéndome las puertas al video. La imagen dejó de ser un complemento: se volvió mi manera de contar historias.</p>
          <div class="ter" aria-hidden="true"><img src={oficios[1].i} width="1280" height="720" alt="" loading="lazy" decoding="async" /><i></i></div>
        </div>
      </article>
      <article class="cp c3">
        <p class="cp-a" aria-hidden="true">Hoy</p>
        <div class="cp-b">
          <h2><span class="vh">Hoy, </span>Una visión completa</h2>
          <p>Colaboro con negocios, municipios, profesionales y organizaciones de toda la isla. La ventaja es sencilla: una sola visión de principio a fin, comunicación directa y una identidad coherente en todo.</p>
          <dl class="cu">
            <div><dt>años desde 2001</dt><dd data-n={anios}>{anios}</dd></div>
            <div><dt>logos en el muro</dt><dd data-n={logos.length}>{logos.length}</dd></div>
            <div><dt>videos en portafolio</dt><dd data-n={videos.length}>{videos.length}</dd></div>
            <div><dt>artículos escritos</dt><dd data-n={articulos}>{articulos}</dd></div>
          </dl>
        </div>
      </article>
    </section>

    <!-- Cómo funciona una cámara: apertura, velocidad e ISO de verdad -->
    <section class="cm full" id="cm" aria-labelledby="cm-t">
      <h2 id="cm-t" class="sec">La cámara, <em class="it">en tus manos</em></h2>
      <div class="cm-g">
        <div class="cm-f">
          <div class="cm-i" id="cm-i">
            <img class="cm-b" src={camaraImg} width="1280" height="720" alt="Pareja en su boda, foto para probar los controles de la cámara" loading="lazy" decoding="async" />
            <img class="cm-n" src={camaraImg} width="1280" height="720" alt="" loading="lazy" decoding="async" />
            <span class="cm-gr" aria-hidden="true"></span>
          </div>
          <div class="cm-me" aria-hidden="true"><span>−3</span><i><b id="cm-ag"></b></i><span>+3</span></div>
          <p class="cm-v" id="cm-v" aria-live="polite">Bien expuesta</p>
        </div>
        <div class="cm-c">
          <div class="cm-pr" role="group" aria-label="Situaciones">
            <button type="button" data-p="0,4,2">Retrato</button>
            <button type="button" data-p="1,4,3">Concierto</button>
            <button type="button" data-p="2,5,5">Deporte</button>
            <button type="button" data-p="4,1,3">Paisaje</button>
          </div>
          <label class="cm-s"><span>Apertura <strong id="cm-fv">f/1.8</strong></span><input id="cm-f" type="range" min="0" max="6" value="0" aria-label="Apertura" /><small id="cm-fd"></small></label>
          <label class="cm-s"><span>Velocidad <strong id="cm-sv">1/500</strong></span><input id="cm-s" type="range" min="0" max="6" value="4" aria-label="Velocidad de obturación" /><small id="cm-sd"></small></label>
          <label class="cm-s"><span>ISO <strong id="cm-iv">400</strong></span><input id="cm-o" type="range" min="0" max="6" value="2" aria-label="ISO" /><small id="cm-id"></small></label>
          <svg class="cm-ir" viewBox="-50 -50 100 100" aria-hidden="true"><circle r="48" fill="#0d0c0b" /><polygon id="cm-ip" points="0,-40 34.6,-20 34.6,20 0,40 -34.6,20 -34.6,-20" fill="var(--flame)" /></svg>
        </div>
      </div>
      <svg width="0" height="0" style="position:absolute" aria-hidden="true"><filter id="mb"><feGaussianBlur id="mb-g" stdDeviation="0 0" /></filter></svg>
    </section>

    <!-- 3 · Cinco oficios: apuntas uno y cambia todo -->
    <section class="of full" aria-labelledby="of-t">
      <h2 id="of-t" class="sec">Cinco oficios, <em class="it">una sola mirada</em></h2>
      <div class="of-g">
        <div class="of-l" role="radiogroup" aria-label="Oficios">
          {oficios.map((o, i) => (
            <label><input class="vh" type="radio" name="of" id={`of-${o.k}`} checked={i === 0} /><span>{o.t}</span></label>
          ))}
        </div>
        <div class="of-p">
          {oficios.map(o => (
            <a class={`of-c of-${o.k}`} href={o.h}>
              <img src={o.i} alt="" width="1280" height="720" loading="lazy" decoding="async" />
              <span class="of-d"><strong>{o.n}</strong>{o.d}<em>Ver más →</em></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Paleta: el color que escojas pinta toda la página -->
    <section class="pl" aria-labelledby="pl-t">
      <div class="full pl-h">
        <h2 id="pl-t" class="sec">Escoge el color. <em class="it">La página te sigue.</em></h2>
        <p role="status" id="pl-e">Toca uno: cambia el acento de todo el sitio en esta visita y copia el código.</p>
      </div>
      <div class="pl-b" role="group" aria-label="Paleta de colores">
        {paleta.map(([n, h], i) => (
          <button type="button" data-c={h} data-n={n} aria-pressed={i === 0 ? 'true' : 'false'} style={`--c:${h}`}>
            <strong>{n}</strong><span>{h.toUpperCase()}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- 4 · La ruta completa: se arrastra -->
    <section class="ru on-paper" aria-labelledby="ru-t">
      <div class="full ru-h">
        <h2 id="ru-t" class="sec">La ruta</h2>
        <p><a class="btn" href="/resume/">Currículum completo</a> <a class="btn" href="/Marcos-Santiago-CV.pdf">Descargar PDF</a></p>
      </div>
      <ol class="ru-l" id="ru-l" tabindex="0" aria-label="Trayectoria, desplázate de lado">
        {ruta.map(r => <li><p class="ru-a">{r.a}</p><h3>{r.t}</h3><p>{r.d}</p></li>)}
      </ol>
      <p class="full ru-q" aria-hidden="true">Arrastra de lado →</p>
    </section>

    <!-- 5 · ¿Qué te llevas? Depende de quién eres -->
    <section class="pu full" aria-labelledby="pu-t">
      <h2 id="pu-t" class="sec">Lo que te llevas</h2>
      <div class="pu-s" role="radiogroup" aria-label="Qué tienes">
        {publicos.map((p, i) => <label><input class="vh" type="radio" name="pu" id={`pu-${p.k}`} checked={i === 0} /><span>{p.t}</span></label>)}
      </div>
      {publicos.map(p => (
        <ul class={`pu-l pu-${p.k}`}>{p.i.map((t, i) => <li style={`--i:${i}`}>{t}</li>)}</ul>
      ))}
      <blockquote class="cita">Una buena imagen no solamente se ve bien:<br> <em>comunica, se reconoce y deja una impresión.</em></blockquote>
    </section>
  </main>
  <CtaBand titulo="¿Hablamos?" texto="Cuéntame qué tienes en mente y me llega directo a WhatsApp." />
  <Footer />
</Base>

<script is:inline define:vars={{ rollo }}>
  (function () {
    var vi = document.getElementById('vi'), im = document.getElementById('vi-i'), an = document.getElementById('vi-a'), af = document.getElementById('vi-af');
    var quieto = matchMedia('(prefers-reduced-motion: reduce)').matches, raf = 0, i = 0;
    function foco(v) { vi.style.setProperty('--b', ((100 - v) * .2).toFixed(2) + 'px'); af.classList.toggle('ok', v >= 96) }
    // Autofoco: de borroso a nítido, como la cámara.
    function autofoco(d) {
      cancelAnimationFrame(raf);
      if (quieto) { an.value = 100; foco(100); return; }
      var v0 = +d, t0 = performance.now();
      an.value = v0; foco(v0);
      (function p(t) { var k = Math.min((t - t0) / 800, 1), e = 1 - Math.pow(1 - k, 3), v = v0 + (100 - v0) * e; an.value = v; foco(v); if (k < 1) raf = requestAnimationFrame(p) })(t0);
    }
    an.addEventListener('input', function () { cancelAnimationFrame(raf); foco(+an.value) });
    autofoco(25);

    // Disparar: la cortina cierra, cambia la imagen y vuelve a enfocar.
    var d = document.getElementById('vi-d'), n = document.getElementById('vi-n'), pie = document.getElementById('vi-p');
    function pre(j) { var x = new Image(); x.src = rollo[j % rollo.length].s }
    d.addEventListener('pointerenter', function () { pre(i + 1) }, { once: false });
    d.addEventListener('click', function () {
      i = (i + 1) % rollo.length; pre(i + 1);
      vi.classList.remove('dis'); void vi.offsetWidth; vi.classList.add('dis');
      setTimeout(function () {
        im.src = rollo[i].s; im.alt = rollo[i].t;
        n.textContent = (i + 1) + '/' + rollo.length; pie.textContent = rollo[i].t;
        autofoco(55);
      }, 130);
    });

    // Contadores: suben al entrar en pantalla.
    var ds = document.querySelectorAll('.cu dd');
    if (!quieto) new IntersectionObserver(function (e, o) {
      if (!e[0].isIntersecting) return; o.disconnect();
      ds.forEach(function (el) { var fin = +el.dataset.n, t0 = performance.now();
        (function p(t) { var k = Math.min((t - t0) / 1100, 1); el.textContent = Math.round(fin * (1 - Math.pow(1 - k, 3))); if (k < 1) requestAnimationFrame(p) })(t0) });
    }, { threshold: .4 }).observe(document.querySelector('.cu'));

    // Cámara: la exposición se calcula de verdad, en pasos de luz.
    var F = [1.8, 2.8, 4, 5.6, 8, 11, 16], V = [30, 60, 125, 250, 500, 1000, 4000], O = [100, 200, 400, 800, 1600, 3200, 6400];
    var cm = document.getElementById('cm'), rf = document.getElementById('cm-f'), rs = document.getElementById('cm-s'), ro = document.getElementById('cm-o');
    var $ = function (x) { return document.getElementById(x) }, mg = $('mb-g');
    function expo() {
      var f = F[rf.value], d = V[rs.value], o = O[ro.value];
      var ev = Math.log2(o / 400) + Math.log2(125 / d) + 2 * Math.log2(4 / f);
      var br = Math.max(.1, Math.min(3, Math.pow(2, ev * .55))), bl = Math.max(0, (16 / f - 1) * 1.1), mo = d <= 30 ? 12 : d <= 60 ? 5 : 0;
      mg.setAttribute('stdDeviation', mo + ' 0');
      cm.style.setProperty('--br', br.toFixed(2)); cm.style.setProperty('--bl', bl.toFixed(1) + 'px');
      cm.style.setProperty('--mo', mo ? 'url(#mb)' : 'none');
      cm.style.setProperty('--gr', (Math.log2(o / 100) / 6 * .95).toFixed(2));
      $('cm-ip').setAttribute('transform', 'scale(' + Math.max(.11, 1.8 / f).toFixed(3) + ')');
      $('cm-ag').style.left = (Math.max(-3, Math.min(3, ev)) + 3) / 6 * 100 + '%';
      $('cm-fv').textContent = 'f/' + f; $('cm-sv').textContent = '1/' + d; $('cm-iv').textContent = o;
      $('cm-fd').textContent = f <= 2.8 ? 'Entra mucha luz y el fondo se desenfoca.' : f >= 8 ? 'Entra poca luz; casi todo sale nítido.' : 'Un punto medio de luz y nitidez.';
      $('cm-sd').textContent = d <= 60 ? 'Lo que se mueve queda barrido.' : d >= 1000 ? 'Congela la acción, pero entra poca luz.' : 'Sin barrido en la mayoría de las escenas.';
      $('cm-id').textContent = o >= 1600 ? 'Ve en la oscuridad, con más grano.' : o <= 200 ? 'Imagen limpia; necesita más luz.' : 'Equilibrio entre luz y grano.';
      $('cm-v').textContent = ev > 1.2 ? 'Sobreexpuesta: demasiada luz' : ev < -1.2 ? 'Subexpuesta: falta luz' : 'Bien expuesta';
      $('cm-v').dataset.ok = Math.abs(ev) <= 1.2;
    }
    [rf, rs, ro].forEach(function (r) { r.addEventListener('input', expo) });
    document.querySelectorAll('.cm-pr button').forEach(function (b) { b.addEventListener('click', function () {
      var p = b.dataset.p.split(','); rf.value = p[0]; rs.value = p[1]; ro.value = p[2]; expo();
    }) });
    expo();

    // Paleta: un cambio de variable pinta toda la página.
    var pb = document.querySelectorAll('.pl-b button'), pe = $('pl-e');
    pb.forEach(function (b) { b.addEventListener('click', function () {
      document.documentElement.style.setProperty('--flame', b.dataset.c);
      pb.forEach(function (x) { x.setAttribute('aria-pressed', x === b) });
      var c = b.dataset.c.toUpperCase();
      pe.textContent = b.dataset.n + ' ' + c;
      if (navigator.clipboard) navigator.clipboard.writeText(c).then(function () { pe.textContent = b.dataset.n + ' ' + c + ' copiado.' }).catch(function () {});
    }) });

    // Oficios: en escritorio basta con apuntar.
    document.querySelectorAll('.of-l label').forEach(function (l) {
      l.addEventListener('pointerenter', function (e) { if (e.pointerType === 'mouse') l.querySelector('input').checked = true });
    });

    // La ruta se arrastra con el ratón.
    var ru = document.getElementById('ru-l'), dn = false, x0 = 0, s0 = 0;
    ru.addEventListener('pointerdown', function (e) { if (e.pointerType !== 'mouse') return; dn = true; x0 = e.clientX; s0 = ru.scrollLeft; ru.classList.add('ag') });
    addEventListener('pointermove', function (e) { if (dn) ru.scrollLeft = s0 - (e.clientX - x0) });
    addEventListener('pointerup', function () { dn = false; ru.classList.remove('ag') });
  })();
</script>

<style>
  .sec { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(2.75rem, 7.2vw, 7.5rem); line-height: .94 }
  .sec .it { font-size: 1.04em }

  /* ── Visor ── */
  .vi { --b: 0px; --muted: rgba(13,12,11,.88); min-height: 100svh; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); grid-template-rows: auto 1fr; gap: clamp(14px, 2vw, 28px) clamp(20px, 4vw, 72px); align-items: center; padding: 92px var(--gut) 32px; overflow: clip; background: var(--flame); color: #0d0c0b; transition: background-color .45s ease }
  .ti { grid-column: 1 / -1; font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: calc((100vw - 2 * var(--gut)) / 8.05); line-height: .86; white-space: nowrap; filter: blur(calc(var(--b) * .25)); will-change: filter }
  .ti .it { font-size: 1.08em; line-height: .9; margin-left: .04em }
  .vi-t { min-width: 0 }
  .vi-s { font-size: clamp(1.125rem, 1.65vw, 1.625rem); font-weight: 500; line-height: 1.32; max-width: 32em }
  .vi-d { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-block: clamp(14px, 2vw, 26px); padding-top: 12px; border-top: 2px solid #0d0c0b; font-size: .9375rem }
  .vi-d dt { font-weight: 500 } .vi-d dd { font-weight: 700 }
  /* La foto es una copia impresa: borde blanco, sombra y un bloque detrás */
  .vi-f { position: relative; min-width: 0; background: #fff; padding: clamp(8px, 1vw, 14px) clamp(8px, 1vw, 14px) 0; rotate: 1.6deg; box-shadow: 14px 14px 0 #0d0c0b, 0 30px 60px rgba(13,12,11,.3); transition: rotate .5s var(--ease), scale .5s var(--ease) }
  .vi-f:hover { rotate: 0deg; scale: 1.012 }
  .vi-m { position: relative; aspect-ratio: 5/4; max-height: calc(100svh - 310px); width: 100%; overflow: hidden; background: #000 }
  .vi-m img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 28%; filter: blur(var(--b)); transform: scale(1.04); will-change: filter }
