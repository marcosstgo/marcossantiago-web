---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CtaBand from '../../components/CtaBand.astro';
import { categories } from '../../data/servicios';
import faq from '../../data/faq.json';
import { wa } from '../../data/site';
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'LocalBusiness', name: 'Marcos Santiago', url: 'https://marcossantiago.com/servicios/', telephone: '+17872439670',
      image: 'https://marcossantiago.com/marcos-photo.jpg',
      description: 'Fotógrafo, videógrafo, artista gráfico y desarrollador web profesional en Puerto Rico.',
      address: { '@type': 'PostalAddress', addressLocality: 'Aibonito', addressRegion: 'PR', addressCountry: 'US' },
      areaServed: 'Puerto Rico', priceRange: '$$',
      hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Servicios creativos Puerto Rico',
        itemListElement: categories.flatMap(c => c.services.map(s => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name } }))) } },
    { '@type': 'FAQPage', mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};
const orden = ['diseno','fotografia','videografia','booth360','desarrollo'];
const cats = orden.map(id => categories.find(c => c.id === id)!);
---
<Base title="Fotógrafo, Videógrafo & Artista Gráfico en Puerto Rico | Marcos Santiago"
  description="Diseño gráfico, fotografía de bodas y eventos, videografía, 360 Video Booth y desarrollo web, con precios claros. Cobertura en todo Puerto Rico."
  businessSchema={false}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <Nav />
  <main id="main" class="pg">
    <header class="full cab">
      <h1 class="ti">Servicios</h1>
      <p>Precios de partida para que sepas por dónde empieza cada cosa. Cada proyecto lo cotizo contigo, directo y sin compromiso.</p>
    </header>
    <nav class="sal full barra-pegada" aria-label="Ir a una categoría">
      {cats.map(c => <a href={`#${c.id}`}>{c.label}</a>)}
    </nav>
    {cats.map(c => (
      <section class="ca full" id={c.id} aria-labelledby={`t-${c.id}`}>
        <div class="ca-h">
          <h2 id={`t-${c.id}`}>{c.label}</h2>
          <p class="ca-tag">{c.tagline}</p>
          <p>{c.desc}</p>
        </div>
        <ul class="ca-l">
          {c.services.map(s => (
            <li>
              <div class="s-t"><h3>{s.name}</h3><p class="s-p">{s.price}</p></div>
              <p class="s-d">{s.desc}</p>
              <p class="s-i">{s.includes.join(' · ')}</p>
              <a class="s-a" href={wa(s.wa)} target="_blank" rel="noopener" data-track={`servicio-${c.id}`} data-n={s.name} data-p={s.price} role="button" aria-pressed="false"><span class="s-m">+</span> <span class="s-l">Agregar a mi cotización</span></a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <section class="on-paper fq">
      <div class="full fq-g">
        <h2 class="fq-t">Preguntas frecuentes</h2>
        <div>
          {faq.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
      </div>
    </section>
  </main>
  <CtaBand titulo="Cotiza sin compromiso" />
  <Footer />
  <!-- Cotizador: se arma en vivo, como la burbuja de /contacto/ -->
  <aside class="tk" id="tk" aria-label="Tu cotización" aria-hidden="true">
    <div class="tk-i">
      <div class="tk-t"><p><span id="tk-n">0</span> en tu cotización</p><strong id="tk-s">Desde $0</strong></div>
      <p class="tk-b" id="tk-b" aria-live="polite"></p>
      <div class="tk-a"><button type="button" id="tk-x">Vaciar</button><button type="button" id="tk-e" class="tk-e">Enviar por WhatsApp</button></div>
      <p class="tk-n">Precios de partida. La cotización final la hablamos contigo.</p>
    </div>
  </aside>
</Base>
<script is:inline>
  (function () {
    var tk = document.getElementById('tk'), sel = new Map(), as = document.querySelectorAll('.s-a');
    function num(p) { var m = /\$([\d,]+)/.exec(p); return m ? +m[1].replace(/,/g, '') : 0 }
    function msg() {
      var l = []; sel.forEach(function (p, n) { l.push(n + ' (' + p.toLowerCase() + ')') });
      return 'Hola Marcos. Me interesa cotizar: ' + l.join(', ') + '.';
    }
    function pinta() {
      var t = 0, c = sel.size; sel.forEach(function (p) { t += num(p) });
      document.getElementById('tk-n').textContent = c === 1 ? '1 servicio' : c + ' servicios';
      document.getElementById('tk-s').textContent = t ? 'Desde $' + t.toLocaleString('en-US') : 'Por cotización';
      document.getElementById('tk-b').textContent = msg();
      tk.classList.toggle('on', c > 0); tk.setAttribute('aria-hidden', c === 0);
      document.body.classList.toggle('con-tk', c > 0);
    }
    as.forEach(function (a) { a.addEventListener('click', function (e) {
      e.preventDefault();
      var n = a.dataset.n; if (sel.has(n)) sel.delete(n); else sel.set(n, a.dataset.p);
      var on = sel.has(n); a.setAttribute('aria-pressed', on); a.querySelector('.s-m').textContent = on ? '✓' : '+'; a.querySelector('.s-l').textContent = on ? 'En tu cotización' : 'Agregar a mi cotización';
      a.closest('li').classList.toggle('sel', on); pinta();
    }) });
    document.getElementById('tk-x').addEventListener('click', function () {
      sel.clear(); as.forEach(function (a) { a.setAttribute('aria-pressed', false); a.querySelector('.s-m').textContent = '+'; a.querySelector('.s-l').textContent = 'Agregar a mi cotización'; a.closest('li').classList.remove('sel') }); pinta();
    });
    document.getElementById('tk-e').addEventListener('click', function () {
      window.open('https://wa.me/17872439670?text=' + encodeURIComponent(msg()), '_blank');
      if (typeof gtag === 'function') gtag('event', 'whatsapp_click', { event_category: 'contacto', event_label: 'cotizador', page_path: location.pathname });
    });
  })();
</script>
<style>
  html { scroll-padding-top: 72px }
  .pg { padding-top: 120px }
  .cab { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 48px; padding-bottom: 24px }
  .ti { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(3.75rem, 15vw, 17rem); line-height: .84 }
  .cab p { max-width: 42ch; font-size: var(--text-lg); color: var(--muted) }
  .sal { display: flex; gap: 4px; overflow-x: auto; padding-block: 14px; background: var(--ink); border-bottom: 1px solid var(--border); scrollbar-width: none }
  .sal a { flex: none; padding: 9px 16px; border-radius: 99px; font-weight: 600; font-size: .9375rem; transition: background .2s, color .2s }
  .sal a:hover { background: var(--flame); color: #0d0c0b }
  .ca { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.7fr); gap: 24px clamp(24px, 5vw, 96px); padding-block: clamp(48px, 7vw, 104px); border-bottom: 1px solid var(--border); scroll-margin-top: 60px }
  .ca-h { position: sticky; top: 92px; align-self: start; color: var(--muted) }
  .ca-h h2 { font-family: var(--display); font-weight: 800; text-transform: uppercase; color: var(--white); font-size: clamp(2.75rem, 5.6vw, 5.75rem); line-height: .95; margin-bottom: 8px }
  .ca-tag { font-family: var(--serif); font-style: italic; font-size: 1.625rem; color: var(--flame); margin-bottom: 8px; line-height: 1.15 }
  .ca-l { list-style: none; border-top: 1px solid var(--border) }
  .ca-l li { padding-block: 22px; border-bottom: 1px solid var(--border); display: grid; gap: 6px }
  .s-t { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 20px; align-items: baseline }
  .s-t h3 { font-size: clamp(1.25rem, 1.9vw, 1.625rem); font-weight: 600; letter-spacing: -.015em; line-height: 1.2 }
  .s-p { font-weight: 600; white-space: nowrap }
  .s-d { color: var(--muted); max-width: 62ch }
  .s-i { color: var(--dim); font-size: .9375rem }
  .s-a { justify-self: start; display: inline-flex; align-items: center; gap: 8px; font-weight: 600; margin-top: 6px; min-height: 44px; padding: 6px 18px 6px 8px; border: 1px solid var(--border-h); border-radius: 99px; transition: background .2s, color .2s, border-color .2s, scale .2s var(--ease) }
  .s-a:hover { border-color: #25d366; scale: 1.02 }
  .s-m { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--flame); color: #0d0c0b; font-weight: 700 }
  .s-a[aria-pressed='true'] { background: #25d366; border-color: #25d366; color: #06230f }
  .s-a[aria-pressed='true'] .s-m { background: #06230f; color: #25d366 }
  .ca-l li.sel h3 { color: #25d366 }
  .ca-l li h3 { transition: color .2s }
  .tk { position: fixed; right: var(--gut); bottom: 18px; z-index: 80; width: min(430px, calc(100vw - 2 * var(--gut))); translate: 0 calc(100% + 24px); visibility: hidden; transition: translate .4s var(--ease), visibility .4s }
  .tk.on { translate: 0 0; visibility: visible }
  .tk-i { background: #0b141a; color: #e9edef; border-radius: 18px; padding: 16px; box-shadow: 0 24px 70px rgba(0,0,0,.6); display: grid; gap: 10px }
  .tk-t { display: flex; justify-content: space-between; align-items: baseline; gap: 12px } .tk-t p { font-size: .9375rem; color: #c4ced3 }
  .tk-t strong { font-family: var(--display); font-weight: 800; font-size: 1.875rem; line-height: 1 }
  .tk-b { background: #005c4b; border-radius: 10px 10px 2px 10px; padding: 9px 11px; font-size: .9375rem; line-height: 1.3; max-height: 7.8em; overflow: auto }
  .tk-a { display: flex; gap: 8px } .tk-a button { min-height: 48px; padding: 0 14px; border-radius: 12px; font-weight: 700 }
  #tk-x { color: #c4ced3 } #tk-x:hover { color: #fff }
  .tk-e { flex: 1; background: #25d366; color: #06230f; transition: background .2s } .tk-e:hover { background: #f3eee5 }
  .tk-n { font-size: .75rem; color: #aab6bc }
  :global(body.con-tk) { padding-bottom: 230px }
  @media (max-width: 800px) { .ca { grid-template-columns: 1fr } .ca-h { position: static } }
  .fq { padding-block: var(--sec) }
  .fq-g { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.7fr); gap: 24px clamp(24px, 5vw, 96px) }
  .fq-t { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(2.5rem, 5vw, 5rem); line-height: .95 }
  details { border-top: 1px solid var(--border) } details:last-child { border-bottom: 1px solid var(--border) }
  summary { cursor: pointer; padding-block: 18px; font-weight: 600; font-size: 1.125rem; list-style-position: outside }
  details p { padding-bottom: 18px; color: var(--muted); max-width: 62ch }
  @media (max-width: 800px) { .fq-g { grid-template-columns: 1fr } }
</style>
