---
// Panel de pago con ATH Móvil (y PayPal opcional). Reutilizable: no depende de nada del sitio.
// Guía: README.md y docs/ del kit pagos-athmovil
//
// - ATH Móvil se activa solo cuando el Worker tiene el token (GET {api}config → { ath: true });
//   mientras tanto el botón dice "Pronto" y lo demás sigue funcionando.
// - Enlace con la cantidad ya puesta: /pagar/?monto=150&concepto=consulta&ref=Juan%20del%20Pueblo
// - Colores: usa las variables del sitio si existen (--gold, --ink…) o las propias --pay-*.
import { Image } from 'astro:assets';
import athLogo from './ath/athmovil-logo.png';
import athIcono from './ath/athmovil-icono.png';

export type Concepto = { value: string; label: string };

interface Props {
  /** Nombre que ve el cliente ("…confirme el pago a {negocio}"). */
  negocio: string;
  /** Deben coincidir con las claves de `conceptos` en el Worker. */
  conceptos?: Concepto[];
  titulo?: string;
  /** Texto bajo la cantidad. */
  ayuda?: string;
  /** Enlace paypal.me (se le añade la cantidad). Sin él, no sale PayPal. */
  paypal?: string;
  /** Enlace de WhatsApp para pedir ayuda si algo falla. */
  whatsapp?: string;
  /** Clave pública de Turnstile. Sin ella no se carga el antispam (el Worker decide si lo exige). */
  turnstileKey?: string;
  /** Prefijo de la API del Worker. */
  api?: string;
  /** Demostración: no llama a ningún servidor ni cobra nada; el pago se "aprueba" solo en unos segundos. */
  demo?: boolean;
}

const {
  negocio,
  conceptos = [{ value: 'pago', label: 'Pago' }],
  titulo = 'Pagar en línea',
  ayuda = 'Escriba la cantidad a pagar.',
  paypal,
  whatsapp,
  turnstileKey,
  api = '/api/pago/ath/',
  demo = false,
} = Astro.props;
---

<div
  class="pay"
  data-pay
  data-api={api}
  data-paypal={paypal}
  data-turnstile={demo ? undefined : turnstileKey}
  data-ayuda={ayuda}
  data-demo={demo ? '1' : undefined}
>
  <header class="pay-head">
    <span class="pay-eyebrow">{demo ? 'Demostración · no se cobra nada' : 'Pagos en línea'}</span>
    <h2>{titulo}</h2>
    <p>{negocio}</p>
  </header>

  <!-- 1. Cantidad y concepto -->
  <form class="step is-active" data-step="monto" novalidate>
    <label class="amount">
      <span class="pay-sr">Cantidad a pagar en dólares</span>
      <span class="cur" aria-hidden="true">$</span>
      <input name="monto" inputmode="decimal" autocomplete="off" placeholder="0.00" aria-describedby="pay-hint" />
    </label>
    <p class="hint center" id="pay-hint" data-monto-hint>{ayuda}</p>

    {
      conceptos.length > 1 && (
        <div class="chips" role="radiogroup" aria-label="Concepto del pago">
          {conceptos.map((c, i) => (
            <label class="chip">
              <input type="radio" name="concepto" value={c.value} checked={i === 0} />
              <span>{c.label}</span>
            </label>
          ))}
        </div>
      )
    }
    {conceptos.length === 1 && <input type="hidden" name="concepto" value={conceptos[0].value} />}

    <label class="field">
      <span>Nombre o referencia <em>(opcional)</em></span>
      <input name="referencia" maxlength="40" autocomplete="name" />
    </label>

    <button type="submit" class="ath-btn" data-ath disabled aria-describedby="pay-soon">
      <span>Pagar con</span>
      <Image src={athLogo} alt="ATH Móvil" height={84} class="ath-logo" />
      <span class="soon" data-soon>Pronto</span>
    </button>
    <p class="hint center" id="pay-soon" data-soon>Pronto podrá pagar con ATH Móvil aquí mismo.</p>

    {
      paypal && (
        <>
          <div class="or" aria-hidden="true">
            <span>o</span>
          </div>
          <a class="alt-btn" href={paypal} rel="noopener" data-paypal-link>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M7.016 19.198h-4.2a.562.562 0 0 1-.555-.65L5.093.584A.692.692 0 0 1 5.776 0h7.222c3.417 0 5.904 2.488 5.846 5.5-.006.25-.027.5-.066.747A6.794 6.794 0 0 1 12.071 12H8.743a.69.69 0 0 0-.682.583l-.325 2.056-.013.083-.692 4.39-.015.087zM19.79 6.142c-.01.087-.01.175-.023.261a7.76 7.76 0 0 1-7.695 6.598H9.007l-.283 1.795-.013.083-.692 4.39-.134.843-.014.088H6.86l-.497 3.15a.562.562 0 0 0 .555.65h3.94a.692.692 0 0 0 .683-.584l.715-4.536a.69.69 0 0 1 .683-.583h.976a7.76 7.76 0 0 0 7.695-6.598c.247-1.555-.081-2.99-.816-3.557z" />
            </svg>
            Pagar con PayPal
          </a>
        </>
      )
    }
  </form>

  <!-- 2. Número de ATH Móvil -->
  <form class="step" data-step="telefono" novalidate hidden>
    <button type="button" class="link back-start" data-back>← Cambiar cantidad</button>
    <p class="total"><span>$</span><b data-total>0.00</b></p>
    <p class="hint center" data-concepto-label></p>

    <label class="field">
      <span>Su número de ATH Móvil</span>
      <input name="telefono" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="787 000 0000" required />
    </label>
    <p class="hint">Le llegará una notificación a la app de ATH Móvil de ese celular para que apruebe el pago.</p>
    <div class="turnstile"></div>
    <p class="error" data-tel-error role="alert" hidden></p>
    <button type="submit" class="main-btn" data-send>Enviar solicitud de pago</button>
  </form>

  <!-- 3. Esperando que apruebe en la app -->
  <div class="step center" data-step="espera" hidden>
    <div class="pulse"><Image src={athIcono} alt="" width={168} /></div>
    <h3>Apruebe el pago en su celular</h3>
    <p class="hint">
      Abra <b>ATH Móvil</b>, toque la notificación y confirme el pago de <b>$<span data-total>0.00</span></b> a {negocio}.
    </p>
    <p class="timer" aria-live="off">Tiempo para aprobar <b data-timer>10:00</b></p>
    {demo && <p class="hint demo-note">En la demostración, el pago se aprueba solo en unos segundos.</p>}
    <button type="button" class="link" data-cancel>Cancelar pago</button>
  </div>

  <!-- 4. Recibo -->
  <div class="step center" data-step="listo" hidden>
    <div class="check" aria-hidden="true">
      <svg viewBox="0 0 52 52"><circle cx="26" cy="26" r="24"></circle><path d="M15 27l7 7 15-16"></path></svg>
    </div>
    <h3>¡Pago recibido!</h3>
    <dl class="receipt">
      <div><dt>Monto</dt><dd>$<span data-total>0.00</span></dd></div>
      <div><dt>Concepto</dt><dd data-r-concepto></dd></div>
      <div data-r-ref-row><dt>Referencia</dt><dd data-r-ref></dd></div>
      <div><dt>Confirmación ATH</dt><dd data-r-ath></dd></div>
      <div><dt>Fecha</dt><dd data-r-fecha></dd></div>
    </dl>
    <p class="hint">ATH Móvil también le envía el recibo a su app. Puede tomar una captura de esta pantalla.</p>
    <button type="button" class="main-btn" data-done>Listo</button>
  </div>

  <!-- Error -->
  <div class="step center" data-step="error" hidden>
    <h3 data-err-title>No se completó el pago</h3>
    <p class="hint" data-err-msg></p>
    <button type="button" class="main-btn" data-retry>Intentar de nuevo</button>
    {whatsapp && <a class="link" href={whatsapp} rel="noopener">¿Necesita ayuda? Escríbanos por WhatsApp</a>}
  </div>

  <p class="secure">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
    Pagos procesados por ATH Móvil{paypal && ' y PayPal'}. Este sitio no guarda datos de su cuenta.
  </p>
</div>

<script>
  type Respuesta = { ok?: boolean; estado?: string; referencia?: string | null; error?: string; id?: string; clave?: string; vence?: number };

  document.querySelectorAll<HTMLElement>('[data-pay]').forEach((pay) => {
    const API = pay.dataset.api!;
    const MIN = 1;
    const MAX = 1500; // límite por pago de la API de ATH Móvil
    const q = <T extends Element = HTMLElement>(s: string) => pay.querySelector<T>(s)!;
    const qa = (s: string) => [...pay.querySelectorAll<HTMLElement>(s)];
    const steps = qa('[data-step]');
    const fMonto = q<HTMLFormElement>('[data-step="monto"]');
    const fTel = q<HTMLFormElement>('[data-step="telefono"]');
    const montoIn = fMonto.elements.namedItem('monto') as HTMLInputElement;
    const refIn = fMonto.elements.namedItem('referencia') as HTMLInputElement;
    const telIn = fTel.elements.namedItem('telefono') as HTMLInputElement;
    const athBtn = q<HTMLButtonElement>('[data-ath]');
    const ppLink = pay.querySelector<HTMLAnchorElement>('[data-paypal-link]');
    const montoHint = q('[data-monto-hint]');
    const telError = q('[data-tel-error]');
    const send = q<HTMLButtonElement>('[data-send]');
    const DEMO = pay.dataset.demo === '1';
    const gtag = (...args: unknown[]) => {
      if (!DEMO) (window as any).gtag?.(...args);
    };

    let athOn = false;
    let pago: { id: string; clave: string } | null = null;
    let poll = 0;
    let tick = 0;

    const show = (id: string) => {
      steps.forEach((s) => {
        const on = s.dataset.step === id;
        s.hidden = !on;
        s.classList.toggle('is-active', on);
      });
    };

    // ¿Ya están las llaves de ATH Móvil en el servidor? (en la demostración, siempre sí)
    // Dentro de la hoja flotante se pregunta al abrirla, no en cada visita a cada página.
    let configPedida = false;
    const pedirConfig = () => {
      if (configPedida) return;
      configPedida = true;
      (DEMO ? Promise.resolve({ ath: true }) : fetch(`${API}config`).then((r) => r.json()))
        .then((c: { ath?: boolean }) => {
          athOn = Boolean(c.ath);
          athBtn.disabled = !athOn;
          qa('[data-soon]').forEach((el) => (el.hidden = athOn));
        })
        .catch(() => {
          configPedida = false;
        });
    };
    const hoja = pay.closest('dialog');
    if (hoja && !hoja.open) pay.addEventListener('pay:shown', pedirConfig);
    else pedirConfig();

    // ── Cantidad ──
    const monto = () => {
      const n = parseFloat(montoIn.value.replace(/[^\d.]/g, ''));
      return Number.isFinite(n) ? Math.round(n * 100) / 100 : 0;
    };
    const fit = () => (montoIn.style.width = `${Math.max(4, montoIn.value.length) + 0.4}ch`);
    const syncPaypal = () => {
      if (!ppLink) return;
      const m = monto();
      ppLink.href = m > 0 ? `${pay.dataset.paypal}/${m.toFixed(2)}` : pay.dataset.paypal!;
    };
    const hint = (msg?: string) => {
      montoHint.textContent = msg ?? pay.dataset.ayuda ?? '';
      montoHint.classList.toggle('is-error', Boolean(msg));
    };
    montoIn.addEventListener('input', () => {
      montoIn.value = montoIn.value
        .replace(/[^\d.]/g, '')
        .replace(/(\..*)\./g, '$1')
        .replace(/(\.\d{2})\d+/, '$1');
      fit();
      syncPaypal();
      hint();
    });
    montoIn.addEventListener('blur', () => {
      const m = monto();
      if (m) montoIn.value = m.toFixed(2);
      fit();
    });

    // Enlace con la cantidad ya puesta (para enviárselo a un cliente por WhatsApp)
    const params = new URLSearchParams(location.search);
    const pm = parseFloat(params.get('monto') ?? '');
    if (pm > 0) montoIn.value = pm.toFixed(2);
    const pc = params.get('concepto');
    if (pc) fMonto.querySelector<HTMLInputElement>(`input[name="concepto"][value="${CSS.escape(pc)}"]`)?.click();
    if (params.get('ref')) refIn.value = params.get('ref')!.slice(0, 40);
    fit();
    syncPaypal();

    const conceptoInput = () =>
      fMonto.querySelector<HTMLInputElement>('input[name="concepto"]:checked, input[type="hidden"][name="concepto"]');
    const conceptoLabel = () => {
      const i = conceptoInput();
      return i?.type === 'hidden' ? '' : (i?.nextElementSibling?.textContent ?? '');
    };
    const setTotal = (m: number) => qa('[data-total]').forEach((el) => (el.textContent = m.toFixed(2)));

    ppLink?.addEventListener('click', () => gtag('event', 'pago_paypal', { value: monto(), currency: 'USD' }));

    fMonto.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!athOn) return;
      const m = monto();
      if (m < MIN || m > MAX) {
        hint(
          m > MAX
            ? 'ATH Móvil acepta hasta $1,500 por pago. Para más, divida el pago o use otro método.'
            : 'Escriba una cantidad de $1.00 o más.',
        );
        montoIn.focus();
        return;
      }
      setTotal(m);
      const ref = refIn.value.trim();
      q('[data-concepto-label]').textContent = [conceptoLabel(), ref].filter(Boolean).join(' · ');
      show('telefono');
      loadTurnstile();
      setTimeout(() => telIn.focus(), 250);
    });

    q('[data-back]').addEventListener('click', () => show('monto'));

    // ── Teléfono ──
    telIn.addEventListener('input', () => {
      let d = telIn.value.replace(/\D/g, '');
      if (d.length === 11 && d.startsWith('1')) d = d.slice(1);
      d = d.slice(0, 10);
      telIn.value = [d.slice(0, 3), d.slice(3, 6), d.slice(6)].filter(Boolean).join(' ');
      telError.hidden = true;
    });
    const telMsg = (msg: string) => {
      telError.textContent = msg;
      telError.hidden = false;
    };

    // Turnstile (antispam): cada intento manda una notificación a un celular
    let widget: string | undefined;
    let tsLoaded = false;
    function loadTurnstile() {
      if (tsLoaded || !pay.dataset.turnstile) return;
      tsLoaded = true;
      const render = () => {
        widget = (window as any).turnstile.render(q('.turnstile'), {
          sitekey: pay.dataset.turnstile,
          theme: 'dark',
          language: 'es',
          appearance: 'interaction-only',
        });
      };
      if ((window as any).turnstile) return render();
      (window as any).onPayTurnstile = render;
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onPayTurnstile&render=explicit';
      s.async = true;
      document.head.append(s);
    }
    const turnstileToken = async () => {
      if (!pay.dataset.turnstile) return '';
      for (let i = 0; i < 40; i++) {
        const ts = (window as any).turnstile;
        const t = ts && widget !== undefined ? ts.getResponse(widget) : '';
        if (t) return t as string;
        await new Promise((r) => setTimeout(r, 250));
      }
      return '';
    };

    // Demostración: simula la API (el pago se "aprueba" a la tercera consulta, unos 6 segundos)
    let demoChecks = 0;
    const simular = async (accion: string): Promise<Respuesta> => {
      await new Promise((r) => setTimeout(r, 600));
      if (accion === 'crear') {
        demoChecks = 0;
        return { ok: true, id: 'demo', clave: 'demo', vence: 600 };
      }
      if (accion === 'cancelar') return { ok: true, estado: 'CANCEL' };
      demoChecks += 1;
      return demoChecks >= 3
        ? { ok: true, estado: 'COMPLETED', referencia: `DEMO-${Math.random().toString(36).slice(2, 10).toUpperCase()}` }
        : { ok: true, estado: 'OPEN' };
    };

    const api = async (accion: string, body: object): Promise<Respuesta> => {
      if (DEMO) return simular(accion);
      const r = await fetch(`${API}${accion}`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
      });
      return r.json().catch(() => ({ ok: false }));
    };

    const fail = (title: string, msg: string) => {
      stop();
      q('[data-err-title]').textContent = title;
      q('[data-err-msg]').textContent = msg;
      show('error');
    };

    fTel.addEventListener('submit', async (e) => {
      e.preventDefault();
      const tel = telIn.value.replace(/\D/g, '');
      if (tel.length !== 10) return telMsg('Escriba los 10 dígitos del celular que tiene ATH Móvil.');
      send.disabled = true;
      send.textContent = 'Enviando…';
      const m = monto();
      try {
        const out = await api('crear', {
          monto: m,
          concepto: conceptoInput()?.value,
          referencia: refIn.value.trim(),
          telefono: tel,
          turnstile: await turnstileToken(),
        });
        if (widget !== undefined) (window as any).turnstile?.reset(widget);
        if (!out.ok || !out.id || !out.clave) {
          if (out.error === 'telefono') return telMsg('Ese número no parece válido. Verifíquelo e intente de nuevo.');
          if (out.error === 'antispam') return telMsg('No pudimos verificar la solicitud. Intente de nuevo en unos segundos.');
          if (out.error === 'limite') return telMsg('Demasiados intentos seguidos. Espere unos minutos e intente de nuevo.');
          return fail(
            'ATH Móvil no aceptó la solicitud',
            'Verifique que el número tenga ATH Móvil y que el pago no pase de su límite diario.',
          );
        }
        pago = { id: out.id, clave: out.clave };
        gtag('event', 'begin_checkout', { value: m, currency: 'USD', payment_type: 'athmovil' });
        show('espera');
        countdown(out.vence ?? 600);
        check();
      } catch {
        fail('Sin conexión', 'No pudimos comunicarnos con el servidor. Verifique su conexión e intente de nuevo.');
      } finally {
        send.disabled = false;
        send.textContent = 'Enviar solicitud de pago';
      }
    });

    // ── Esperando la aprobación ──
    function countdown(segundos: number) {
      const fin = Date.now() + segundos * 1000;
      const el = q('[data-timer]');
      const paint = () => {
        const s = Math.max(0, Math.round((fin - Date.now()) / 1000));
        el.textContent = `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
      };
      paint();
      clearInterval(tick);
      tick = window.setInterval(paint, 1000);
    }
    function stop() {
      clearTimeout(poll);
      clearInterval(tick);
    }
    // Sigue consultando aunque se cierre la hoja: si el pago se completa, la hoja vuelve a abrirse con el recibo
    async function check() {
      if (!pago) return;
      try {
        const st = await api('estado', pago);
        if (st.estado === 'COMPLETED') return done(st);
        if (st.estado === 'CANCEL') {
          pago = null;
          return fail('El pago no se completó', 'Se canceló o se venció el tiempo para aprobarlo. Puede intentarlo de nuevo.');
        }
      } catch {}
      poll = window.setTimeout(check, 3000);
    }
    function done(st: Respuesta) {
      stop();
      const m = monto();
      q('[data-r-concepto]').textContent = conceptoLabel() || 'Pago';
      const ref = refIn.value.trim();
      q('[data-r-ref-row]').hidden = !ref;
      q('[data-r-ref]').textContent = ref;
      q('[data-r-ath]').textContent = st.referencia || '—';
      q('[data-r-fecha]').textContent = new Date().toLocaleString('es-PR', { dateStyle: 'medium', timeStyle: 'short' });
      gtag('event', 'purchase', { value: m, currency: 'USD', transaction_id: st.referencia || pago?.id, payment_type: 'athmovil' });
      pago = null;
      show('listo');
      pay.dispatchEvent(new CustomEvent('pay:open', { bubbles: true }));
    }

    q('[data-cancel]').addEventListener('click', async () => {
      const actual = pago;
      stop();
      pago = null;
      show('monto');
      if (actual) {
        const st = await api('cancelar', actual).catch(() => ({}) as Respuesta);
        if (st.estado === 'COMPLETED') done(st); // lo aprobó justo antes de cancelar
      }
    });

    q('[data-retry]').addEventListener('click', () => show('monto'));

    q('[data-done]').addEventListener('click', () => {
      montoIn.value = '';
      refIn.value = '';
      fit();
      syncPaypal();
      show('monto');
      pay.closest('dialog')?.close();
    });
  });
</script>

<style>
  /* Colores: cada uso es var(--pay-*, valor por defecto). El sitio los cambia definiendo --pay-* en .pay o :root;
     si no, se toman sus --paper, --ink, --gold… y, si tampoco existen, los valores fijos. */
  .pay {
    --ath: #ed6d23; /* Orange 800 de la guía de marca de ATH Móvil */
    display: grid;
    gap: 1.5rem;
    color: var(--pay-fg, var(--paper, #f3efe7));
    font-family: var(--pay-sans, var(--sans, system-ui, sans-serif));
  }
  .pay-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .pay-head {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    text-align: center;
  }
  .pay-eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pay-accent, var(--gold, #c4a76c));
  }
  .pay-head h2 {
    margin: 0.2rem 0 0;
    font: 400 clamp(1.9rem, 6vw, 2.4rem) / 1.05 var(--pay-serif, var(--serif, Georgia, serif));
    letter-spacing: -0.02em;
  }
  .pay-head p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--pay-muted, var(--muted, #9a968d));
  }
  .step {
    display: grid;
    gap: 1.1rem;
  }
  .step[hidden],
  [data-soon][hidden] {
    display: none;
  }
  .step.is-active {
    animation: payIn 0.4s var(--pay-ease, var(--ease, cubic-bezier(0.2, 0.7, 0.1, 1)));
  }
  @keyframes payIn {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  .center {
    justify-items: center;
    text-align: center;
  }
  h3 {
    margin: 0;
    font: 400 1.7rem/1.15 var(--pay-serif, var(--serif, Georgia, serif));
  }
  .hint {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--pay-muted, var(--muted, #9a968d));
  }
  .hint.center {
    text-align: center;
  }
  .hint b {
    color: var(--pay-fg, var(--paper, #f3efe7));
