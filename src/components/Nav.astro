---
import { NAV, wa } from '../data/site';
const current = Astro.url.pathname;
const activo = (h: string) =>
  h === '/portafolio/'
    ? current.startsWith('/portafolio/') && !current.startsWith('/portafolio/logos')
    : current.startsWith(h);
---
<a href="#main" class="skip">Saltar al contenido</a>
<header class="nav">
  <a href="/" class="nav-marca" aria-label="Marcos Santiago, inicio">
    <img src="/logos-home/logo-marcos.svg" alt="" width="62" height="28" />
  </a>
  <nav class="nav-links" aria-label="Principal">
    {NAV.map(l => <a href={l.href} aria-current={activo(l.href) ? 'page' : undefined}>{l.label}</a>)}
  </nav>
  <a href="/contacto/" class="nav-cta">Hablemos <span aria-hidden="true">→</span></a>
  <button class="nav-abrir" popovertarget="nav-movil" aria-label="Abrir menú"><span></span><span></span></button>
</header>

<!-- Menú móvil con popover nativo: cero JavaScript -->
<div id="nav-movil" popover="auto" class="nav-movil">
  <button class="nav-cerrar" popovertarget="nav-movil" popovertargetaction="hide" aria-label="Cerrar menú">×</button>
  <nav aria-label="Móvil">
    {NAV.map(l => <a href={l.href}>{l.label}</a>)}
    <a href="/contacto/">Hablemos</a>
  </nav>
  <a class="nav-wa" href={wa()} data-track="nav-whatsapp">WhatsApp · (787) 243-9670</a>
</div>

<script is:inline>
  // Al bajar se esconde; al subir vuelve con fondo sólido para no pisar el contenido.
  (function () {
    var n = document.querySelector('.nav'), y0 = scrollY, pend = false;
    function f() { pend = false; var y = scrollY;
      n.classList.toggle('fijo', y > 40);
      if (Math.abs(y - y0) > 6) { n.classList.toggle('oculto', y > y0 && y > 160); y0 = y; } }
    addEventListener('scroll', function () { if (!pend) { pend = true; requestAnimationFrame(f); } }, { passive: true });
    f();
  })();
</script>

<style>
  .skip { position: fixed; left: 12px; top: -60px; z-index: 300; background: var(--flame); color: #0d0c0b; padding: 10px 16px; font-weight: 600 }
  .skip:focus { top: 12px }
  .nav {
    position: fixed; inset: 0 0 auto; z-index: 100; height: 72px;
    display: flex; align-items: center; gap: 28px; padding-inline: var(--gut);
    color: #f3eee5; transition: translate .3s var(--ease), background-color .25s;
  }
  :global(body:has(main.on-paper)) .nav:not(:global(.fijo)) { color: #14120f }
  :global(body:has(main.on-paper)) .nav:not(:global(.fijo)) img { filter: invert(1) }
  :global(body:has(main.on-paper)) .nav:not(:global(.fijo)) .nav-cta:hover { background: #14120f; color: #f3eee5 }
  .nav:global(.fijo) { background: #0d0c0b }
  .nav:global(.oculto) { translate: 0 -100% }
  .nav-marca { margin-right: auto; display: block }
  .nav-marca img { height: 28px; width: auto }
  .nav-links { display: flex; gap: 30px; font-size: .9375rem; font-weight: 500 }
  .nav-links a { position: relative; padding: 8px 0; white-space: nowrap }
  .nav-links a::after { content:''; position: absolute; left: 0; right: 0; bottom: 3px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform .3s var(--ease) }
  .nav-links a:hover::after, .nav-links a[aria-current]::after { transform: scaleX(1) }
  .nav-cta { font-weight: 600; font-size: .9375rem; padding: 9px 18px; border: 1px solid currentColor; border-radius: 99px; transition: background .2s, color .2s; white-space: nowrap }
  .nav-cta:hover { background: #f3eee5; color: #0d0c0b }
  .nav-abrir { display: none; width: 44px; height: 44px; position: relative }
  .nav-abrir span { position: absolute; left: 9px; right: 9px; height: 2px; background: currentColor }
  .nav-abrir span:first-child { top: 18px } .nav-abrir span:last-child { top: 26px }

  .nav-movil { position: fixed; inset: 0; width: 100%; height: 100dvh; max-width: none; max-height: none; border: 0; padding: 88px var(--gut) 32px; background: var(--flame); color: #0d0c0b; flex-direction: column; justify-content: space-between }
  .nav-movil:popover-open { display: flex; animation: entra .28s var(--ease) }
  @keyframes entra { from { opacity: 0; translate: 0 16px } }
  .nav-movil nav { display: grid; gap: 2px }
  .nav-movil nav a { font-family: var(--display); font-weight: 800; font-size: clamp(3rem, 15vw, 5rem); line-height: 1.02; text-transform: uppercase }
  .nav-cerrar { position: absolute; right: var(--gut); top: 16px; width: 44px; height: 44px; font-size: 2.25rem; line-height: 1 }
  .nav-wa { font-weight: 600 }
  @media (max-width: 900px) {
    .nav-links, .nav-cta { display: none }
    .nav-abrir { display: block }
  }
</style>
