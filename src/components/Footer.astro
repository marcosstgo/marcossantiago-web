---
import { SOCIAL, TEL, TEL_TXT, EMAIL, wa } from '../data/site';
const year = new Date().getFullYear();
const cols = [
  { t: 'Trabajo', i: [['/portafolio/video/','Video'],['/portafolio/foto/','Fotografía'],['/portafolio/diseno/','Diseño gráfico'],['/portafolio/logos/','Logos'],['/portafolio/dev/','Desarrollo web'],['/reels/','Reels']] },
  { t: 'Servicios', i: [['/fotografo-bodas-pr/','Fotografía de bodas'],['/videografia-corporativa-pr/','Video corporativo'],['/diseno-grafico-pr/','Diseño gráfico y logos'],['/360-booth-pr/','360 Video Booth'],['/servicios/','Todos los servicios']] },
  { t: 'Más', i: [['/sobre-mi/','Sobre mí'],['/resume/','Currículum'],['/blog/','Blog'],['/contacto/','Contacto'],['/terminos/','Términos'],['/privacidad/','Privacidad']] },
];
---
<footer class="pie">
  <div class="full">
    <div class="pie-top">
      <address class="pie-nap">
        <p class="pie-nombre">Marcos Santiago</p>
        <p>Diseño, fotografía y video desde Aibonito para toda la isla.</p>
        <p class="pie-datos">
          <span>Aibonito, Puerto Rico</span>
          <a href={`tel:${TEL}`} data-track="footer-tel">{TEL_TXT}</a>
          <a href={`mailto:${EMAIL}`} data-track="footer-email">{EMAIL}</a>
          <a href={wa()} target="_blank" rel="noopener" data-track="footer-whatsapp">WhatsApp</a>
        </p>
      </address>
      {cols.map(c => (
        <nav class="pie-col" aria-label={c.t}>
          <p class="pie-t">{c.t}</p>
          {c.i.map(([h, l]) => <a href={h}>{l}</a>)}
        </nav>
      ))}
    </div>
    <div class="pie-bajo">
      <span>© {year} Marcos Santiago</span>
      <span class="pie-red">{SOCIAL.map(s => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}</span>
    </div>
  </div>
</footer>
<style>
  .pie { border-top: 1px solid var(--border); padding-block: clamp(48px, 7vw, 88px) 28px; background: var(--ink); color: var(--white); font-size: .9375rem }
  .pie-top { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px }
  .pie-nap { font-style: normal; color: var(--muted); max-width: 36ch }
  .pie-nombre { font-family: var(--display); font-weight: 800; font-size: 1.75rem; text-transform: uppercase; color: var(--white); line-height: 1; margin-bottom: 12px }
  .pie-datos { display: grid; gap: 4px; margin-top: 18px }
  .pie-datos a, .pie-col a, .pie-red a { transition: color .2s }
  .pie-datos a:hover, .pie-col a:hover, .pie-red a:hover { color: var(--flame) }
  .pie-col { display: grid; gap: 4px; align-content: start }
  .pie-col a { padding-block: 3px; color: var(--muted) }
  .pie-t { font-size: var(--text-xs); font-weight: 600; letter-spacing: .09em; text-transform: uppercase; margin-bottom: 8px; color: var(--white) }
  .pie-bajo { display: flex; flex-wrap: wrap; gap: 12px 28px; justify-content: space-between; margin-top: 56px; padding-top: 20px; border-top: 1px solid var(--border); color: var(--dim); font-size: .875rem }
  .pie-red { display: flex; flex-wrap: wrap; gap: 6px 20px }
  @media (max-width: 800px) { .pie-top { grid-template-columns: 1fr 1fr } .pie-nap { grid-column: 1 / -1 } }
</style>
