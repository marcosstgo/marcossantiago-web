---
// Portada de /sobre-mi/: video de las fotos de estudio de Marcos con «el efecto» del canal 1 del inicio
// (proyector de cine). Video: scripts/fotos-reel.py con scripts/marcos-reel.json (fotos en arte/marcos/).
// Se pinta primero el póster; el video baja después de cargar la página, como en el inicio.
import { Picture } from 'astro:assets';
import poster from '../assets/marcos/marcos-reel-poster.jpg';
---
<section class="pm" aria-label="Marcos Santiago">
  <div class="pm-media">
    <Picture class="pm-poster" src={poster} formats={['avif', 'webp']} widths={[640, 1280]} sizes="100vw" alt="Marcos Santiago con su cámara de cine en el estudio" loading="eager" fetchpriority="high" />
    <video class="pm-video" muted loop playsinline preload="none" aria-hidden="true" data-src="/videos/marcos-reel.mp4" data-src-m="/videos/marcos-reel-480.mp4"></video>
    <div class="pm-grano" aria-hidden="true"></div>
  </div>
  <h1 class="pm-t">
    <span class="pm-desc">Fotógrafo, videógrafo y diseñador <em class="it">desde Aibonito, Puerto Rico</em></span>
    <span class="pm-nombre"><span>Marcos</span> <span>Santiago</span></span>
  </h1>
</section>

<script is:inline>
  (function () {
    var c = navigator.connection, ligero = (c && c.saveData) || matchMedia('(prefers-reduced-motion: reduce)').matches;
    var v = document.querySelector('.pm-video'); if (!v || ligero) return;
    addEventListener('load', function () { (window.requestIdleCallback || setTimeout)(function () {
      v.src = innerWidth < 760 ? v.dataset.srcM : v.dataset.src;
      v.addEventListener('playing', function () { v.classList.add('on') }, { once: true });
      v.play().catch(function () {});
    }, { timeout: 1500 }) }, { once: true });
  })();
</script>

<style>
  .pm { position: relative; height: 100svh; min-height: 560px; display: flex; align-items: flex-end; overflow: clip; background: #b85a2a; color: #f3eee5 }
  .pm-media { position: absolute; inset: 72px 0 0; isolation: isolate; overflow: clip } /* debajo del menú fijo, que no tape la cabeza */
  .pm-media::after { content: ''; position: absolute; inset: 0; z-index: 2; background: linear-gradient(180deg, rgba(13,12,11,.3) 0, rgba(13,12,11,0) 20%, rgba(13,12,11,0) 50%, rgba(13,12,11,.82) 100%) }
  .pm-poster, .pm-video { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 57% 0 }
  .pm-video { opacity: 0; transition: opacity 1s; filter: saturate(1.05) }
  .pm-video:global(.on) { opacity: 1 }
  .pm-grano { position: absolute; inset: -160px; z-index: 1; background: url(/grano.webp) 0 0 / 160px; pointer-events: none; will-change: translate; animation: pm-grano .7s steps(1) infinite }
  @keyframes pm-grano { 0% { translate: 0 0 } 20% { translate: -47px 31px } 40% { translate: 62px -58px } 60% { translate: -83px -24px } 80% { translate: 29px 76px } }
  .pm-t { position: relative; z-index: 3; width: 100%; padding: 0 var(--gut) clamp(14px, 2vw, 26px); font-weight: inherit }
  .pm-desc { display: block; font-size: clamp(1.0625rem, 1.8vw, 1.625rem); font-weight: 500; line-height: 1.25; margin-bottom: clamp(8px, 1.2vw, 16px); max-width: 30ch; text-shadow: 0 1px 12px rgba(0,0,0,.45) }
  .pm-desc .it { display: block; font-size: 1.14em }
  .pm-nombre { display: flex; flex-wrap: wrap; column-gap: .18em; font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: calc((100vw - 2 * var(--gut)) / 7.5); line-height: .84; white-space: nowrap; letter-spacing: -.012em }
  @media (max-width: 760px) { .pm-nombre { font-size: calc((100vw - 2 * var(--gut)) / 4.1); white-space: normal } }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .pm-media { animation: pm-par linear both; animation-timeline: scroll(root); animation-range: 0 100vh }
      @keyframes pm-par { to { translate: 0 14%; scale: 1.08 } }
    }
  }
  @media (prefers-reduced-motion: reduce) { .pm-grano { animation: none } }
</style>
