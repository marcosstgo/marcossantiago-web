---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import { portadaBlog, compartirBlog } from '../lib/blog-portadas';

const { title, date, desc, tags, slug } = Astro.props.frontmatter;
const portada = portadaBlog(slug);
const compartir = compartirBlog(slug);
const formattedDate = (() => {
  const [y, m, d] = date.split('-').map(Number);
  return new Date(y, m - 1, d).toLocaleDateString('es-PR', { year: 'numeric', month: 'long', day: 'numeric' });
})();

// Reading time
const rawModules = import.meta.glob('../pages/blog/*.mdx', { eager: true, query: '?raw', import: 'default' });
const rawEntry   = Object.entries(rawModules).find(([path]) => path.endsWith(`/${slug}.mdx`));
const rawContent = rawEntry ? String(rawEntry[1]) : '';
const minRead    = Math.max(1, Math.ceil(
  rawContent.replace(/^---[\s\S]*?---/, '').replace(/<[^>]+>/g, ' ')
    .trim().split(/\s+/).filter(Boolean).length / 220
));

// Índice: los <h2> del artículo (el script les pone id="s-1", "s-2"… en el mismo orden)
const toc = [...rawContent.replace(/^---[\s\S]*?---/, '').matchAll(/<h2[^>]*>([\s\S]*?)<\/h2>|^##\s+(.+)$/gm)]
  .map(m => (m[1] ?? m[2]).replace(/<[^>]+>/g, '').trim()).filter(Boolean);
const url = `https://marcossantiago.com/blog/${slug}/`;
const waCompartir = `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`;
const waMarcos = `https://wa.me/17872439670?text=${encodeURIComponent(`Hola Marcos, leí «${title}» en tu blog y quiero cotizar un proyecto.`)}`;

// Prev / Next
const allModules = import.meta.glob('../pages/blog/*.mdx', { eager: true });
const allPosts   = Object.values(allModules)
  .map((p: any) => ({ slug: p.frontmatter.slug, title: p.frontmatter.title, date: p.frontmatter.date }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const idx  = allPosts.findIndex(p => p.slug === slug);
const next = idx > 0                    ? allPosts[idx - 1] : null; // newer
const prev = idx < allPosts.length - 1  ? allPosts[idx + 1] : null; // older
---
<Base title={`${title} — Marcos Santiago`} description={desc} image={compartir ?? '/marcos-photo.jpg'}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": desc,
    "datePublished": date,
    "author": { "@type": "Person", "name": "Marcos Santiago", "url": "https://marcossantiago.com" },
    "publisher": { "@type": "Person", "name": "Marcos Santiago", "url": "https://marcossantiago.com" },
    "url": `https://marcossantiago.com/blog/${slug}/`,
    ...(compartir ? { "image": `https://marcossantiago.com${compartir}` } : {})
  })} />
  <Nav />
  <div class="read-progress" aria-hidden="true"><span id="read-bar"></span></div>
  <main id="main" style="padding-top:120px">
    <div class="container">
      <div class="post-header">
        <a href="/blog/" class="back-link">← Blog</a>
        <div class="post-header-meta">
          <span class="post-meta-date">{formattedDate}</span>
          <span class="meta-sep">·</span>
          <span class="post-meta-read">{minRead} min de lectura</span>
          {tags && tags.length > 0 && (
            <>
              <span class="meta-sep">·</span>
              <div class="post-tags">
                {tags.map((t: string) => <span class="tag" data-cat={t}>{t}</span>)}
              </div>
            </>
          )}
        </div>
        <h1 class="post-title">{title}</h1>
      </div>

      {portada && (
        <figure class="post-portada">
          <Image src={portada} alt="" widths={[640, 960, 1280, 1600]} sizes="(max-width: 1320px) calc(100vw - 2 * var(--gut)), 1208px"
                 loading="eager" fetchpriority="high" decoding="async" />
        </figure>
      )}

      <div class="post-grid">
        <article class="post-body">
          <slot />
          <p class="post-autor">
            <img src="/marcos-photo-280.webp" width="56" height="56" alt="" loading="lazy" decoding="async" />
            <span><strong>Marcos Santiago</strong> Fotógrafo, videógrafo, diseñador y desarrollador en Aibonito, Puerto Rico. Escribo sobre lo que uso trabajando.</span>
          </p>
        </article>

        <aside class="post-aside">
          <div class="aside-pega">
            {toc.length > 1 && (
              <nav class="toc" aria-label="En este artículo">
                <p class="label">En este artículo</p>
                <ol>{toc.map((t, i) => <li><a href={`#s-${i + 1}`}>{t}</a></li>)}</ol>
              </nav>
            )}
            <div class="compartir">
              <p class="label">Compartir</p>
              <a class="btn whatsapp" href={waCompartir} target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i> WhatsApp</a>
              <button class="btn ghost" type="button" data-copiar={url}>Copiar enlace</button>
            </div>
          </div>
        </aside>
      </div>

      <!-- Prev / Next -->
      {(prev || next) && (
        <nav class="post-nav">
          <div class="post-nav-inner">
            {prev
              ? <a href={`/blog/${prev.slug}/`} class="nav-post nav-prev">
                  <span class="nav-label">← Anterior</span>
                  <span class="nav-title">{prev.title}</span>
                </a>
              : <div />
            }
            {next && (
              <a href={`/blog/${next.slug}/`} class="nav-post nav-next">
                <span class="nav-label">Siguiente →</span>
                <span class="nav-title">{next.title}</span>
              </a>
            )}
          </div>
        </nav>
      )}
    </div>

    <section class="pg-cierre">
      <div class="container">
        <h2 class="display">¿Lo hacemos <span class="it">juntos?</span></h2>
        <p>Si prefieres que lo haga alguien que trabaja con esto todos los días, cuéntame tu proyecto: foto, video, diseño o web. Te cotizo sin compromiso.</p>
        <div class="pg-acciones">
          <a class="btn" href={waMarcos} target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i> WhatsApp · 787-243-9670</a>
          <a class="btn" href="/servicios/">Ver servicios →</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
/* ── Portada (ilustración del artículo) ── */
.post-portada { margin: 0 0 clamp(36px, 5vw, 64px); border-radius: var(--radius); overflow: hidden; background: var(--surface); aspect-ratio: 16 / 9 }
.post-portada img { width: 100%; height: 100%; object-fit: cover }

/* ── Barra de progreso de lectura ── */
.read-progress {
  position: fixed; top: 0; left: 0; right: 0; height: 3px;
  z-index: 101; background: transparent; pointer-events: none;
}
.read-progress span {
  display: block; height: 100%; width: 0;
  background: var(--flame);
  transition: width .1s linear;
}
@media (prefers-reduced-motion: reduce) {
  .read-progress span { transition: none }
}

.post-header {
  max-width: 1100px; margin-bottom: 56px;
}
.back-link {
  font-family: var(--mono); font-size: var(--text-2xs);
  letter-spacing: 2px; text-transform: uppercase;
  color: var(--muted); display: inline-block; margin-bottom: 24px;
  transition: color .15s;
}
.back-link:hover { color: var(--white) }

.post-header-meta {
  display: flex; align-items: center; flex-wrap: wrap; gap: 8px;
  margin-bottom: 16px;
}
.post-meta-date, .post-meta-read {
  font-family: var(--mono); font-size: var(--text-2xs);
  letter-spacing: 2px; text-transform: uppercase; color: var(--dim);
}
.meta-sep { color: var(--dim); font-size: var(--text-2xs) }
.post-tags { display: flex; gap: 6px; flex-wrap: wrap }
.tag {
  --c: var(--flame);
  display: inline-flex; align-items: center; gap: 6px;
  font-family: var(--mono); font-size: var(--text-2xs);
  letter-spacing: 1.5px; text-transform: uppercase;
  padding: 4px 10px; border-radius: 999px;
  background: color-mix(in srgb, var(--c) 11%, transparent);
  border: 1px solid color-mix(in srgb, var(--c) 30%, var(--border));
  color: var(--dim);
}
.tag::before {
  content: ''; width: 6px; height: 6px; border-radius: 50%;
  background: var(--c); flex-shrink: 0;
}
.post-title {
  font-family: var(--display); font-weight: 800;
  font-size: clamp(2.6rem, 6.4vw, 6rem);
  text-transform: uppercase; letter-spacing: -.005em; line-height: .9;
  margin-top: 8px; max-width: 18ch;
}

/* ── Article body ── */
.post-body {
  max-width: 72ch;
  font-size: .97rem; line-height: 1.85;
  color: color-mix(in srgb, var(--white) 80%, transparent);
}

/* :global() — slot content doesn't inherit Astro scoped classes */
:global(.post-body h2) {
  font-family: var(--display); font-weight: 800; text-transform: uppercase;
  font-size: clamp(2rem, 3.4vw, 3rem); line-height: .96; letter-spacing: -.005em; color: var(--white);
  margin: 72px 0 20px;
}
:global(.post-body h3) {
  font-family: var(--body); font-weight: 700; font-size: clamp(1.2rem, 1.8vw, 1.45rem);
  line-height: 1.25; letter-spacing: -.01em; color: var(--white); margin: 40px 0 12px;
}
:global(.post-body p)  { margin-bottom: 20px }
:global(.post-body strong) { color: var(--white) }
:global(.post-body em) { color: color-mix(in srgb, var(--white) 70%, transparent) }
:global(.post-body a)  { color: var(--flame); text-decoration: underline; text-underline-offset: 3px }

:global(.post-body ul),
:global(.post-body ol) { list-style: none; padding-left: 0; margin-bottom: 24px }
:global(.post-body li) {
  position: relative; padding-left: 20px;
  margin-bottom: 12px;
  color: color-mix(in srgb, var(--white) 80%, transparent);
  line-height: 1.7;
}
:global(.post-body ul li::before) {
  content: '—'; position: absolute; left: 0;
  color: var(--accent); font-weight: 700;
}
:global(.post-body ol) { counter-reset: ol-counter }
:global(.post-body ol li) { counter-increment: ol-counter }
:global(.post-body ol li::before) {
  content: counter(ol-counter) '.'; position: absolute; left: 0;
  color: var(--accent); font-family: var(--mono); font-size: var(--text-xs);
}
:global(.post-body blockquote) {
  border-left: 2px solid var(--accent);
  padding-left: 20px; margin: 28px 0;
  color: var(--muted); font-style: italic;
}
:global(.post-body hr) {
  border: none; border-top: 1px solid var(--border); margin: 40px 0;
}

/* Code */
:global(.post-body code) {
  font-family: var(--mono); font-size: .85em;
  background: color-mix(in srgb, var(--white) 6%, transparent);
  border: 1px solid var(--border);
  padding: 2px 6px; border-radius: 4px;
  color: color-mix(in srgb, var(--accent) 80%, var(--white));
}
:global(.post-body pre) {
  background: color-mix(in srgb, var(--white) 4%, transparent);
  border: 1px solid var(--border); border-radius: 10px;
  padding: 20px 24px; overflow-x: auto;
  margin-bottom: 24px;
}
:global(.post-body pre code) {
  background: none; border: none; padding: 0;
  font-size: var(--text-base); color: var(--white);
}

/* Tables */
:global(.post-body table) {
  width: 100%; border-collapse: collapse;
  margin-bottom: 24px; font-size: var(--text-base);
}
:global(.post-body th) {
  font-family: var(--mono); font-size: var(--text-xs);
  letter-spacing: 1.5px; text-transform: uppercase;
  text-align: left; padding: 10px 14px;
  border-bottom: 1px solid var(--border);
  color: var(--muted);
}
:global(.post-body td) {
  padding: 10px 14px; border-bottom: 1px solid var(--border);
  color: color-mix(in srgb, var(--white) 75%, transparent);
  vertical-align: top;
}
:global(.post-body tr:last-child td) { border-bottom: none }
:global(.post-body tr:hover td) { background: color-mix(in srgb, var(--white) 3%, transparent) }

/* ── Columna lateral: índice que sigue la lectura y compartir ── */
.post-grid { display: grid; grid-template-columns: minmax(0, 72ch) minmax(220px, 300px); justify-content: space-between; gap: 64px; align-items: start }
.post-aside { height: 100% }
.aside-pega { position: sticky; top: 100px; display: grid; gap: 36px }
body:has(.nav.oculto) .aside-pega { top: 32px }
.toc .label, .compartir .label { color: var(--dim); margin-bottom: 14px }
.toc ol { list-style: none; border-left: 1px solid var(--border); display: grid }
.toc a { display: block; padding: 7px 0 7px 16px; margin-left: -1px; border-left: 2px solid transparent; color: var(--muted); font-size: .9rem; line-height: 1.35; transition: color .2s, border-color .2s }
.toc a:hover { color: var(--white) }
.toc a[aria-current="true"] { color: var(--white); border-left-color: var(--flame) }
.compartir { display: grid; gap: 10px; justify-items: start }
.compartir .btn { min-height: 42px; padding: 9px 18px }
.post-autor { display: flex; gap: 16px; align-items: center; margin-top: 56px !important; padding-top: 28px; border-top: 1px solid var(--border); font-size: var(--text-sm) !important; color: var(--muted) }
.post-autor img { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; filter: grayscale(1); flex-shrink: 0 }
.post-autor strong { display: block; color: var(--white); font-size: 1rem; margin-bottom: 2px }
@media (max-width: 1100px) {
  .post-grid { grid-template-columns: minmax(0, 1fr) }
  .post-aside { height: auto }
  .aside-pega { position: static }
  .toc { display: none }
}

/* ── Prev / Next ── */
.post-nav {
  border-top: 1px solid var(--border);
  margin-top: 64px; padding-top: 40px; padding-bottom: 80px;
}
.post-nav-inner {
  display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
}
@media (max-width: 600px) { .post-nav-inner { grid-template-columns: 1fr } }
.nav-post {
  display: flex; flex-direction: column; gap: 6px;
  padding: 20px; border-radius: var(--radius);
  border: 1px solid var(--border);
  background: var(--surface);
  transition: border-color .2s, background .2s;
}
.nav-post:hover { border-color: var(--flame); background: color-mix(in srgb, var(--flame) 6%, var(--surface)) }
.nav-next { text-align: right }
.nav-label {
  font-family: var(--mono); font-size: var(--text-2xs);
  letter-spacing: 2px; text-transform: uppercase; color: var(--muted);
}
.nav-title {
  font-family: var(--display); font-size: 1rem;
  letter-spacing: 1px; color: var(--white);
  line-height: 1.2;
}
</style>

<script>
  // Barra de progreso de lectura: avanza según cuánto del artículo has pasado.
  const bar     = document.getElementById('read-bar');
  const article = document.querySelector('.post-body') as HTMLElement | null;
  if (bar && article) {
    const update = () => {
      const rect  = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const done  = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : (rect.top <= 0 ? 1 : 0);
      bar.style.width = (done * 100) + '%';
    };
    document.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  // Índice: id a cada <h2> y marca la sección que se está leyendo.
  const enlaces = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const hs = [...document.querySelectorAll<HTMLElement>('.post-body h2')];
  hs.forEach((h, i) => { h.id ||= `s-${i + 1}`; h.style.scrollMarginTop = '100px' });
  if (enlaces.length && 'IntersectionObserver' in window) {
    const marca = (id: string) => enlaces.forEach(a => a.setAttribute('aria-current', String(a.hash === '#' + id)));
    const io = new IntersectionObserver(es => {
      const vis = es.filter(e => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (vis) marca(vis.target.id);
    }, { rootMargin: '0px 0px -70% 0px' });
    hs.forEach(h => io.observe(h));
  }

  // Copiar enlace
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach(b => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copiar!); b.textContent = '✓ Copiado' }
    catch { b.textContent = b.dataset.copiar! }
    setTimeout(() => { b.textContent = 'Copiar enlace' }, 2200);
  }));
</script>
