---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Las landings que declaran su propio LocalBusiness lo ponen en false
   *  para no emitir dos entidades de negocio en la misma página. */
  businessSchema?: boolean;
}
const {
  title,
  description = 'Marcos Santiago — Fotógrafo, videógrafo, artista gráfico y desarrollador en Aibonito, Puerto Rico. Cobertura en toda la isla.',
  image = '/marcos-photo.jpg',
  businessSchema = true
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Perfiles oficiales — usados por el schema de Person y del negocio.
// Al añadir el Google Business Profile, ponerlo aquí también.
const SOCIALS = [
  'https://github.com/marcosstgo',
  'https://www.behance.net/marcossantiago',
  'https://www.instagram.com/m4rcos',
  'https://vimeo.com/marcosstgo',
  'https://x.com/Marc0sSantiago',
];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#0d0c0b" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- OG -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`https://marcossantiago.com${image}`} />
  <meta property="og:site_name" content="Marcos Santiago" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- JSON-LD — Person + negocio local de área de servicio (SEO local) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://marcossantiago.com/#persona",
        "name": "Marcos Santiago",
        "url": "https://marcossantiago.com",
        "jobTitle": "Diseñador Gráfico, Fotógrafo, Videógrafo y Desarrollador",
        "address": { "@type": "PostalAddress", "addressLocality": "Aibonito", "addressRegion": "PR", "addressCountry": "US" },
        ...(businessSchema ? { "worksFor": { "@id": "https://marcossantiago.com/#negocio" } } : {}),
        "sameAs": SOCIALS
      },
      ...(!businessSchema ? [] : [{
        "@type": "ProfessionalService",
        "@id": "https://marcossantiago.com/#negocio",
        "name": "Marcos Santiago — Soluciones Creativas",
        "url": "https://marcossantiago.com",
        "image": "https://marcossantiago.com/marcos-photo.jpg",
        "description": "Fotografía, videografía, diseño gráfico, 360 Video Booth y desarrollo web en Puerto Rico.",
        "telephone": "+1-787-243-9670",
        "email": "hello@marcossantiago.com",
        "priceRange": "$$",
        "founder": { "@id": "https://marcossantiago.com/#persona" },
        "address": { "@type": "PostalAddress", "addressLocality": "Aibonito", "addressRegion": "PR", "addressCountry": "US" },
        "areaServed": { "@type": "AdministrativeArea", "name": "Puerto Rico" },
        "knowsLanguage": ["es", "en"],
        "sameAs": SOCIALS,
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Servicios",
          "itemListElement": [
            "Fotografía de bodas y eventos",
            "Videografía y video corporativo",
            "Diseño gráfico e identidad de marca",
            "360 Video Booth",
            "Desarrollo web"
          ].map(s => ({ "@type": "Offer", "itemOffered": { "@type": "Service", "name": s } }))
        }
      }])
    ]
  })} />

  <!-- Fuentes propias (subset latin): 11 KB display + 26 KB texto -->
  <link rel="preload" href="/fonts/ms-display.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/ms-body.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/instrument-serif.css" media="print" onload="this.media='all'" />
  <!-- Precargas propias de la página (p. ej. /resume/ precarga su display). -->
  <slot name="head" />

  <!-- Icons — subset local + fonts self-hosted (~7 KB total, subseteadas) -->
  <link rel="stylesheet" href="/fa-subset.css" />

  <!-- Analytics: se carga con la primera interacción o a los 4 s para no competir con el render -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-Y0M2T7NQQG');
    (function(){
      var done=false, go=function(){ if(done) return; done=true;
        var s=document.createElement('script'); s.async=true;
        s.src='https://www.googletagmanager.com/gtag/js?id=G-Y0M2T7NQQG'; document.head.appendChild(s); };
      ['pointerdown','keydown','scroll'].forEach(function(e){ addEventListener(e,go,{once:true,passive:true}) });
      setTimeout(go,4000);
    })();
  </script>
  <!-- Prefetch de la siguiente página al apuntar: navegación casi instantánea -->
  <script type="speculationrules" is:inline>
    {"prefetch":[{"where":{"href_matches":"/*"},"eagerness":"moderate"}]}
  </script>
</head>
<body>
  <slot />

  <script is:inline>
  // ── Medición de conversiones de contacto ──
  // Listener delegado: cubre todo enlace tel:/wa.me/mailto: del sitio,
  // incluidos los que se inserten dinámicamente después.
  (function() {
    document.addEventListener('click', function(e) {
      const a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
      if (!a || typeof gtag !== 'function') return;

      const href = a.getAttribute('href') || '';
      let name = null;
      if (href.startsWith('tel:'))                                  name = 'phone_click';
      else if (/^(https?:)?\/\/(wa\.me|api\.whatsapp\.com)/.test(href)) name = 'whatsapp_click';
      else if (href.startsWith('mailto:'))                          name = 'email_click';
      if (!name) return;

      gtag('event', name, {
        event_category: 'contacto',
        event_label: a.dataset.track || a.textContent.trim().slice(0, 60) || href,
        page_path: window.location.pathname,
        link_url: href,
      });
    }, true);
  })();
  </script>
</body>
</html>
